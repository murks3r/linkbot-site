# Jobsite preview configuration.
#
# These are PUBLIC_ variables: Astro inlines them into the client bundle.
# Never put a secret, token or private key here.

# Absolute origin used for canonical and og:url on jobsite pages.
# Leave unset for a local preview: the pages then emit no canonical at all,
# rather than pointing at a domain the preview does not own.
# PUBLIC_SITE_ORIGIN=http://localhost:4321

# Canonical Universal Supply API origin. When set, /jobs serves live supply
# through HttpSearchAdapter instead of the labelled fixture set.
# Leave unset to stay in the fixture-backed preview.
# PUBLIC_SUPPLY_API_ORIGIN=

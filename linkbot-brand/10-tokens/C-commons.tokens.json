        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.2, 0.7, 0.2, 1)"
      },
      "entrance": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.16, 1, 0.3, 1)"
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.4, 0, 1, 1)"
      },
      "linear": {
        "$type": "cubicBezier",
        "$value": "linear"
      }
    }
  },
  "focus": {
    "ring-width": {
      "$type": "dimension",
      "$value": "2px"
    },
    "ring-offset": {
      "$type": "dimension",
      "$value": "2px"
    }
  }

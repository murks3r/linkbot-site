{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Linkbot Brand OS 0.1.0 — Commons candidate direction. NOT APPROVED. Non-applied artifact: no runtime file consumes this.",
  "color": {
    "palette": {
      "white": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "canvas": {
        "$type": "color",
        "$value": "#F6F8F9"
      },
      "ink": {
        "$type": "color",
        "$value": "#172125"
      },
      "slate": {
        "$type": "color",
        "$value": "#4E5C64"
      },
      "line": {
        "$type": "color",
        "$value": "#DCE3E6"
      },
      "controlLine": {
        "$type": "color",
        "$value": "#87959D"
      },
      "ocean": {
        "$type": "color",
        "$value": "#245C73"
      },
      "oceanDeep": {
        "$type": "color",
        "$value": "#1B4658"
      },
      "granted": {
        "$type": "color",
        "$value": "#146B4A"
      },
      "pending": {
        "$type": "color",
        "$value": "#8A5B00"
      },
      "denied": {
        "$type": "color",
        "$value": "#A3352B"
      },
      "unknown": {
        "$type": "color",
        "$value": "#5A6B73"
      },
      "darkCanvas": {
        "$type": "color",
        "$value": "#0F1417"
      },
      "darkSurface": {
        "$type": "color",
        "$value": "#161C20"
      },
      "darkLine": {
        "$type": "color",
        "$value": "#2A343A"
      },
      "darkControlLine": {
        "$type": "color",
        "$value": "#5E6E77"
      },
      "darkText": {
        "$type": "color",
        "$value": "#E7EDEF"
      },
      "darkDim": {
        "$type": "color",
        "$value": "#9BAAB2"
      },
      "oceanBright": {
        "$type": "color",
        "$value": "#7FC4DC"
      }
    }
  },
  "semantic": {
    "canvas": {
      "$type": "color",
      "$value": "{color.palette.canvas}",
      "$extensions": {
        "linkbot.primitive": "canvas",
        "$value": "#F6F8F9"
      }
    },
    "surface": {
      "$type": "color",
      "$value": "{color.palette.white}",
      "$extensions": {
        "linkbot.primitive": "white",
        "$value": "#FFFFFF"
      }
    },
    "text": {
      "$type": "color",
      "$value": "{color.palette.ink}",
      "$extensions": {
        "linkbot.primitive": "ink",
        "$value": "#172125"
      }
    },
    "text-muted": {
      "$type": "color",
      "$value": "{color.palette.slate}",
      "$extensions": {
        "linkbot.primitive": "slate",
        "$value": "#4E5C64"
      }
    },
    "brand": {
      "$type": "color",
      "$value": "{color.palette.ocean}",
      "$extensions": {
        "linkbot.primitive": "ocean",
        "$value": "#245C73"
      }
    },
    "brand-contrast": {
      "$type": "color",
      "$value": "{color.palette.white}",
      "$extensions": {
        "linkbot.primitive": "white",
        "$value": "#FFFFFF"
      }
    },
    "link": {
      "$type": "color",
      "$value": "{color.palette.ocean}",
      "$extensions": {
        "linkbot.primitive": "ocean",
        "$value": "#245C73"
      }
    },
    "border-subtle": {
      "$type": "color",
      "$value": "{color.palette.line}",
      "$extensions": {
        "linkbot.primitive": "line",
        "$value": "#DCE3E6"
      }
    },
    "border-control": {
      "$type": "color",
      "$value": "{color.palette.controlLine}",
      "$extensions": {
        "linkbot.primitive": "controlLine",
        "$value": "#87959D"
      }
    },
    "status-granted": {
      "$type": "color",
      "$value": "{color.palette.granted}",
      "$extensions": {
        "linkbot.primitive": "granted",
        "$value": "#146B4A"
      }
    },
    "status-pending": {
      "$type": "color",
      "$value": "{color.palette.pending}",
      "$extensions": {
        "linkbot.primitive": "pending",
        "$value": "#8A5B00"
      }
    },
    "status-denied": {
      "$type": "color",
      "$value": "{color.palette.denied}",
      "$extensions": {
        "linkbot.primitive": "denied",
        "$value": "#A3352B"
      }
    },
    "status-unknown": {
      "$type": "color",
      "$value": "{color.palette.unknown}",
      "$extensions": {
        "linkbot.primitive": "unknown",
        "$value": "#5A6B73"
      }
    },
    "focus": {
      "$type": "color",
      "$value": "{color.palette.oceanDeep}",
      "$extensions": {
        "linkbot.primitive": "oceanDeep",
        "$value": "#1B4658"
      }
    },
    "focus-ring": {
      "$type": "color",
      "$value": "{color.palette.oceanDeep}",
      "$extensions": {
        "linkbot.primitive": "oceanDeep",
        "$value": "#1B4658"
      }
    }
  },

{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "PROPOSED Linkbot direction — editorial authority, paper ground, seal accent, record-shaped.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.114,
          0.357,
          0.271
        ],
        "hex": "#1d5b45"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.337,
          0.361,
          0.388
        ],
        "hex": "#565c63"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.541,
          0.357,
          0
        ],
        "hex": "#8a5b00"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.957,
          0.945,
          0.918
        ],
        "hex": "#f4f1ea"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "2xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "xs": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "2xl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "3xl": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "4xl": {
      "$value": {
        "value": 96,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "xs": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fraunces",
        "fontSize": {
          "value": 76,
          "unit": "px"
        },
        "fontWeight": 300,
        "letterSpacing": {
          "value": -0.03,
          "unit": "em"
        }
      }
    },
    "display-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fraunces",
        "fontSize": {
          "value": 48,
          "unit": "px"
        },
        "fontWeight": 300,
        "letterSpacing": {
          "value": -0.03,
          "unit": "em"
        }
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fraunces",
        "fontSize": {
          "value": 24,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": -0.015,
          "unit": "em"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": {
          "value": 16,
          "unit": "px"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "label-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "JetBrains Mono",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0.14,
          "unit": "em"
        }
      }
    }
  }
}

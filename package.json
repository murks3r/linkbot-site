{
  "name": "linkbot-site",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "description": "Linkbot's public site in five languages: what a space is, how matching works, for platforms and verticals. Static, crawlable, no tracking.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/site_browser.cjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "astro": "^5.1.5",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}

{
  "name": "linkbot-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "preview:local": "npm run build && astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "node --test \"tests/jobsite-*.test.mjs\"",
    "test:jobsite": "node --test \"tests/jobsite-*.test.mjs\"",
    "test:site": "npm run build && node --test \"tests/site-hardening/*.test.mjs\"",
    "smoke": "npm run build && node --test \"tests/preview-smoke/*.test.mjs\"",
    "smoke:dist": "node --test \"tests/preview-smoke/*.test.mjs\"",
    "verify": "npm run typecheck && npm run build && node --test \"tests/jobsite-*.test.mjs\" \"tests/site-hardening/*.test.mjs\" \"tests/preview-smoke/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.2.1",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^6.0.0",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "astro": "^5.1.5",
    "gsap": "^3.12.5",
    "lenis": "^1.1.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "three": "^0.169.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.169.0"
  }
}

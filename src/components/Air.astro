---
/* The light every page could lie on (Concepts A6–A7), kept for a page that asks for it (Base's sky prop; no page does
   since the redesign pass of 2026-10-24): still gradients of the seven proven pigments, which a browser without WebGL
   or scripts shows, and over them the living field (src/scripts/atmosphere.ts, loaded by the page that has it), drawn
   into a small canvas. The dust is no longer here: since the third pass (GEO-188) it is part of the page's own
   background (body in src/styles/site.css), under everything else, and it scrolls with the page. */
interface Props { mode?: 'living' | 'paper' }
const { mode = 'paper' } = Astro.props;
---
{mode === 'living' && <div class="air" data-air aria-hidden="true">
  <div class="air-still"></div>
  <canvas class="air-field" width="32" height="32"></canvas>
</div>}

<style is:global>
  body { position: relative; }
  .air { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; background: var(--paper); }
  .air > * { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .air-still { background:
      radial-gradient(42% 46% at 14% 18%, var(--lb-air-sun) 0%, transparent 72%),
      radial-gradient(40% 44% at 86% 16%, var(--lb-air-peach) 0%, transparent 72%),
      radial-gradient(30% 36% at 94% 62%, var(--lb-air-coral) 0%, transparent 72%),
      radial-gradient(44% 50% at 8% 86%, var(--lb-air-sky) 0%, transparent 72%),
      radial-gradient(50% 40% at 56% 104%, var(--lb-air-sage) 0%, transparent 72%),
      radial-gradient(26% 30% at 38% 96%, var(--lb-air-leaf) 0%, transparent 72%),
      var(--paper); }
  .air-field { opacity: 0; transition: opacity 1.2s ease; }
  .air.is-drawn .air-field { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .air-field { transition: none; } }
  @media (forced-colors: active) { .air { display: none; } }
</style>

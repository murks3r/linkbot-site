---
/* The ground every page lies on (Concept A9: the layer model of fundament v0; founder A1, A2, A4).

   Bottom to top, and all of it behind everything that carries words:
   L0 the ground: --paper, the body's own background (site.css).
   L1 the atmosphere (home only): still gradients of the seven proven pigments, desaturated to
      --air-saturation (what a browser without WebGL or scripts shows, and everyone sees first), and
      over them the living field (src/scripts/atmosphere.ts, loaded by the page that has it), drawn
      into a small canvas whose pigments the script desaturates where it reads them (never a CSS
      filter on the canvas). Fixed to the view.
   L2 the wash: one plain layer of --wash at --wash-opacity over the atmosphere, on every page, so
      the ground reads near white-grey and is the same everywhere. Only its opacity ever changes:
      a section that needs colour carries data-air-reveal, and the atmosphere's script raises
      --air-reveal on this layer alone while that section is in view.
   L3 the noise: a paper grain (the founder's Resource Boy textures, levelled, made seamless and
      combined into density stages; --noise-tile, d2 by default) printed with multiply, so white
      stays white and only the material shows. One element in the page flow, absolute and as tall
      as the document, so it scrolls with the content (founder A1); one texel per device pixel. It
      sits in the root stacking context below main, the footer and the header, so it blends with
      L0–L2 only: no word, field, button, card, chip or moving decoration is ever printed by it,
      and no component can drag it into its own stacking context. An image on our own origin, so a
      strict img-src holds.
   L4 everything else: main and the footer (z --z-content, Base.astro), the header (z 30). */
interface Props { mode?: 'living' | 'paper' }
const { mode = 'paper' } = Astro.props;
const living = mode === 'living';
---
<div class="air" data-air={living ? '' : undefined} aria-hidden="true">
  {living && <div class="air-still"></div>}
  {living && <canvas class="air-field" width="32" height="32"></canvas>}
  <div class="air-wash" data-wash></div>
</div>
<div class="noise" data-noise aria-hidden="true"></div>

<style is:global>
  body { position: relative; }
  /* L1 + L2: one fixed layer; the wash is its last child, so it lies over the light. */
  .air { position: fixed; inset: 0; z-index: var(--z-air); overflow: hidden; pointer-events: none; background: var(--paper); }
  .air > * { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* The still light's pigments, desaturated like the living field's: towards the near-white wash
     where relative colours are unknown, in OKLCH (lightness kept, chroma scaled) where they are. */
  .air {
    --air-sun: color-mix(in oklab, var(--lb-air-sun) calc(var(--air-saturation) * 100%), var(--wash));
    --air-peach: color-mix(in oklab, var(--lb-air-peach) calc(var(--air-saturation) * 100%), var(--wash));
    --air-coral: color-mix(in oklab, var(--lb-air-coral) calc(var(--air-saturation) * 100%), var(--wash));
    --air-sky: color-mix(in oklab, var(--lb-air-sky) calc(var(--air-saturation) * 100%), var(--wash));
    --air-sage: color-mix(in oklab, var(--lb-air-sage) calc(var(--air-saturation) * 100%), var(--wash));
    --air-leaf: color-mix(in oklab, var(--lb-air-leaf) calc(var(--air-saturation) * 100%), var(--wash)); }
  @supports (color: oklch(from red l c h)) {
    .air {
      --air-sun: oklch(from var(--lb-air-sun) l calc(c * var(--air-saturation)) h);
      --air-peach: oklch(from var(--lb-air-peach) l calc(c * var(--air-saturation)) h);
      --air-coral: oklch(from var(--lb-air-coral) l calc(c * var(--air-saturation)) h);
      --air-sky: oklch(from var(--lb-air-sky) l calc(c * var(--air-saturation)) h);
      --air-sage: oklch(from var(--lb-air-sage) l calc(c * var(--air-saturation)) h);
      --air-leaf: oklch(from var(--lb-air-leaf) l calc(c * var(--air-saturation)) h); }
  }
  .air-still { background:
      radial-gradient(42% 46% at 14% 18%, var(--air-sun) 0%, transparent 72%),
      radial-gradient(40% 44% at 86% 16%, var(--air-peach) 0%, transparent 72%),
      radial-gradient(30% 36% at 94% 62%, var(--air-coral) 0%, transparent 72%),
      radial-gradient(44% 50% at 8% 86%, var(--air-sky) 0%, transparent 72%),
      radial-gradient(50% 40% at 56% 104%, var(--air-sage) 0%, transparent 72%),
      radial-gradient(26% 30% at 38% 96%, var(--air-leaf) 0%, transparent 72%),
      var(--paper); }
  .air-field { opacity: 0; transition: opacity 1.2s ease; }
  .air.is-drawn .air-field { opacity: 1; }
  .air-wash { background: var(--wash); opacity: calc(var(--wash-opacity) * (1 - .7 * var(--air-reveal))); }
  /* L3: in the page flow (body is its containing block, so it is as tall as the document) and
     scrolling with it. Never fixed, never background-attachment. */
  .noise { position: absolute; inset: 0; z-index: var(--z-noise); pointer-events: none; mix-blend-mode: multiply; opacity: var(--noise-opacity);
    background: var(--noise-tile) 0 0 / var(--noise-scale) var(--noise-scale) repeat; }
  @media (prefers-reduced-motion: reduce) { .air-field { transition: none; } }
  @media (forced-colors: active) { .air, .noise { display: none; } }
</style>

---
/* The atmosphere every page with a sky lies on (Concept A6).

   Three layers, all behind the content and none carrying text:
   1. still gradients of the seven proven pigments: what a browser without WebGL or without
      scripts shows, and the first paint for everyone;
   2. the living field (src/scripts/atmosphere.ts, loaded by the page that has it), drawn into a
      small canvas over them;
   3. the grain: fractal noise drawn by an inline SVG pattern (no image is loaded, so it passes a
      strict img-src), finer on dense screens so a grain is about one device pixel, blended with
      soft-light so it textures the light without darkening it.
   The grain's tiles are defined once here; a deep band can reuse them by reference.
   Every page has the grain (the paper's texture is part of the identity); only the home has the
   living field. */
interface Props { mode?: 'living' | 'paper' }
const { mode = 'paper' } = Astro.props;
---
<div class="air" data-air={mode === 'living' ? '' : undefined} data-mode={mode} aria-hidden="true">
  {mode === 'living' && <div class="air-still"></div>}
  {mode === 'living' && <canvas class="air-field" width="32" height="32"></canvas>}
  <svg class="grain" focusable="false" aria-hidden="true">
    <defs>
      <filter id="grain-coarse" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency=".82" numOctaves="3" stitchTiles="stitch" seed="11" />
        <feColorMatrix type="matrix" values=".33 .33 .33 0 0  .33 .33 .33 0 0  .33 .33 .33 0 0  0 0 0 0 1" />
        <feComponentTransfer><feFuncR type="linear" slope="2.2" intercept="-.6" /><feFuncG type="linear" slope="2.2" intercept="-.6" /><feFuncB type="linear" slope="2.2" intercept="-.6" /></feComponentTransfer>
      </filter>
      <filter id="grain-fine" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="1.35" numOctaves="3" stitchTiles="stitch" seed="11" />
        <feColorMatrix type="matrix" values=".33 .33 .33 0 0  .33 .33 .33 0 0  .33 .33 .33 0 0  0 0 0 0 1" />
        <feComponentTransfer><feFuncR type="linear" slope="2.2" intercept="-.6" /><feFuncG type="linear" slope="2.2" intercept="-.6" /><feFuncB type="linear" slope="2.2" intercept="-.6" /></feComponentTransfer>
      </filter>
      <pattern id="grain-tile-coarse" width="256" height="256" patternUnits="userSpaceOnUse"><rect width="256" height="256" filter="url(#grain-coarse)" /></pattern>
      <pattern id="grain-tile-fine" width="256" height="256" patternUnits="userSpaceOnUse"><rect width="256" height="256" filter="url(#grain-fine)" /></pattern>
    </defs>
    <rect class="grain-coarse" width="100%" height="100%" fill="url(#grain-tile-coarse)" />
    <rect class="grain-fine" width="100%" height="100%" fill="url(#grain-tile-fine)" />
  </svg>
</div>

<style is:global>
  .air { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; background: var(--paper); }
  .air > * { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .air-still { background:
      radial-gradient(42% 46% at 14% 18%, var(--lb-air-sun) 0%, transparent 72%),
      radial-gradient(40% 44% at 86% 16%, var(--lb-air-peach) 0%, transparent 72%),
      radial-gradient(30% 36% at 94% 62%, var(--lb-air-coral) 0%, transparent 72%),
      radial-gradient(44% 50% at 8% 86%, var(--lb-air-sky) 0%, transparent 72%),
      radial-gradient(50% 40% at 56% 104%, var(--lb-air-sage) 0%, transparent 72%),
      radial-gradient(26% 30% at 38% 96%, var(--lb-air-leaf) 0%, transparent 72%),
      var(--paper); }
  .air-field { opacity: 0; transition: opacity 1.2s ease; }
  .air.is-drawn .air-field { opacity: 1; }
  .grain { mix-blend-mode: soft-light; opacity: .9; }
  .grain .grain-fine { display: none; }
  @media (min-resolution: 1.5dppx) { .grain .grain-coarse { display: none; } .grain .grain-fine { display: inline; } }
  @media (prefers-reduced-motion: reduce) { .air-field { transition: none; } }
  @media (forced-colors: active) { .air { display: none; } }
</style>

---
/* The rotating badge (Concept A8): a circle of text that turns slowly and for ever, a lock in the
   middle. The principle of the founder's Magic Spoon reference, nothing else of it. One statement,
   chosen by the preview's switcher (badge=yours|sees|fit); the default is an approved working line
   from Notion 06; "A fit tells no one" is still under counsel's review, so it is a marked option,
   never the default. SVG text on a circular path; the rotation is one transform animation on the
   ring; it pauses while off screen and in a hidden tab (an observer toggles data-on), and stands
   still under reduced motion. Decorative: the text is read once for assistive technology. */
interface Props { size?: number; class?: string }
const { size = 168, class: cls } = Astro.props;
const LINES: Record<string, string> = { yours: 'Your words. Your data. Your call.', sees: 'Nobody sees you unless you say yes.', fit: 'A fit tells no one.' };
/* A9 (W1 part 3, review R9): the alternatives are preview options; a production build renders the
   approved default alone, so no page carries the others even hidden (claims.md S2.3, founder B). */
const shown: [string, string][] = import.meta.env.PUBLIC_PREVIEW_VARIANTS === '1' ? Object.entries(LINES) : [['yours', LINES.yours]];
const r = 50 - 9;
---
<span class:list={['badge', cls]} data-badge style={`--badge-size: ${size}px`} role="img" aria-label={LINES.yours}>
  <svg class="badge-ring" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <defs><path id="badge-path" d={`M50,50 m-${r},0 a${r},${r} 0 1,1 ${2 * r},0 a${r},${r} 0 1,1 -${2 * r},0`} /></defs>
    {shown.map(([key, line]) => <text class="badge-text" data-line={key}><textPath href="#badge-path" startOffset="0" textLength="252" lengthAdjust="spacing">{line.toUpperCase()}&nbsp;&nbsp;·&nbsp;&nbsp;</textPath></text>)}
  </svg>
  <svg class="badge-lock" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="5" y="10.5" width="14" height="10" rx="2.2" /><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" /><circle cx="12" cy="15.5" r="1.3" fill="currentColor" stroke="none" /></svg>
</span>

<script>
  /* The ring turns only while seen: off screen or in a hidden tab the animation is paused. */
  const badges = [...document.querySelectorAll<HTMLElement>('[data-badge]')];
  if (badges.length && 'IntersectionObserver' in window) {
    const seen = new IntersectionObserver(entries => entries.forEach(e => e.target.toggleAttribute('data-on', e.isIntersecting && !document.hidden)));
    badges.forEach(b => seen.observe(b));
    document.addEventListener('visibilitychange', () => badges.forEach(b => { if (document.hidden) b.removeAttribute('data-on'); }));
  } else badges.forEach(b => b.setAttribute('data-on', ''));
</script>

<style>
  .badge { position: relative; display: inline-grid; place-items: center; width: var(--badge-size); height: var(--badge-size); color: var(--ink); }
  .badge-ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: badge-turn 24s linear infinite; animation-play-state: paused; }
  .badge[data-on] .badge-ring { animation-play-state: running; }
  @media (prefers-reduced-motion: reduce) { .badge-ring { animation: none; } }
  @keyframes badge-turn { to { transform: rotate(360deg); } }
  .badge-text { font-family: var(--text); font-size: 7.6px; font-weight: 650; fill: currentColor; display: none; }
  .badge-text[data-line='yours'] { display: block; }
  :global(html[data-v-badge='sees']) .badge-text { display: none; }
  :global(html[data-v-badge='sees']) .badge-text[data-line='sees'] { display: block; }
  :global(html[data-v-badge='fit']) .badge-text { display: none; }
  :global(html[data-v-badge='fit']) .badge-text[data-line='fit'] { display: block; }
  .badge-lock { width: 30%; height: 30%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; }
  @media (forced-colors: active) { .badge-text { fill: CanvasText; } .badge-lock { stroke: CanvasText; } }
</style>

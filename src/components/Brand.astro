---
/* The brand, top left: Sensalio's horizontal lockup from the logo kit (public/brand, BRAND.md of 2026-11-10), the name
   in outlines as the kit supplies it; the link's text is the public name for those who do not see the picture. */
interface Props { href: string; name: string }
const { href, name } = Astro.props;
---
<a class="brand" href={href}>
  <img class="brand-logo" src="/brand/sensalio-horizontal.svg" alt={name} width="122" height="36" />
</a>

<style>
  .brand { display: inline-flex; align-items: center; justify-self: start; min-height: var(--target); text-decoration: none; }
  .brand-logo { display: block; height: 36px; width: auto; }
</style>

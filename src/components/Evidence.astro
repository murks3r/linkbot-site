---
/* Scene 3 (Concept A5): one opening, explained.

   The first of the four that fit opens into the evidence Linkbot shows for every listing: for
   each of the person's words, what the listing states and where, what it states differently, and
   what it doesn't say (never counted as a fit). Then the limits: what was checked, how current it
   is, and that Linkbot doesn't cover every job. Two beats. The listing is an example and says so;
   the evidence words are the app's own. */
import Mark from './Mark.astro';
import { reading, LEVEL, STORY } from '../data/content';
const words = reading('story');
const listing = STORY.listing;
/* A caption rises quickly with its beat and falls as the next one starts; statically all are on. */
const on = (i: number, n: number) => {
  const rise = i === 0 ? '1' : `clamp(0, var(--b${i + 1}, 1) * 3, 1)`;
  const fall = i < n - 1 ? `(1 - clamp(0, var(--b${i + 2}, 0) * 3, 1))` : '1';
  return `calc(${rise} * ${fall})`;
};
const CAPTIONS: [string, string][] = [
  ['What it states. What it doesn’t.', 'For every word you gave, the listing is read: stated, and where; stated differently; or not stated, which is never counted as a fit.'],
  ['Known is shown. Unknown is shown too.', 'Every search says how many listings it checked and how current they are. There is no score that could hide a missing answer.'],
];
---
<section class="scene evidence" data-scene data-beats="0:.42,.5:1" style="--beats: 2" aria-labelledby="evidence-caption-1">
  <div class="scene-stage" data-scene-stage>
    <div class="scene-inner evidence-inner">
      <ol class="captions evidence-captions">
        {CAPTIONS.map(([title, body], i) => <li class="caption" data-caption style={`--on: ${on(i, CAPTIONS.length)}`} id={`evidence-caption-${i + 1}`}><h2>{title}</h2><small>{body}</small></li>)}
      </ol>
      <figure class="evidence-figure" aria-labelledby="evidence-legend">
        <article class="evidence-sheet" aria-labelledby="evidence-title">
          <p class="evidence-kicker"><span>Example listing</span><span>{listing.facts}</span></p>
          <h3 id="evidence-title">{listing.title}</h3>
          <dl class="evidence-rows">
            {listing.rows.map((row, i) => <div data-tone={row.tone} style={`--r: ${i}`}>
              <dt>{row.ask}<small>{LEVEL[words.criteria[i]?.level ?? 'prefer']}</small></dt>
              <dd><Mark tone={row.tone} /><span><b>{row.says}</b> {row.where}</span></dd>
            </div>)}
          </dl>
          <p class="evidence-coverage">
            <span><Mark tone="fit" size={10} />Checked today · source and date on every listing</span>
            <span><Mark tone="fit" size={10} />Only listings checked in the last 7 days · copies of the same job merged</span>
            <span><Mark tone="unknown" size={10} />Linkbot doesn’t cover every job, and says what it checked</span>
          </p>
        </article>
        <figcaption id="evidence-legend" class="evidence-legend">Illustration: the listing is an example. The way it is read is the product’s own.</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .evidence-inner { display: grid; gap: 24px; padding: 24px var(--gutter) 32px; }
  .evidence-captions { max-width: 46rem; margin-inline: auto; text-align: center; }
  .evidence-captions h2 { font-size: inherit; font-weight: inherit; letter-spacing: inherit; line-height: inherit; }
  .evidence-captions small { max-width: 36em; margin-inline: auto; }
  .evidence-figure { display: grid; gap: 12px; justify-items: center; width: min(100%, 36rem); margin-inline: auto; }
  .evidence-sheet { width: 100%; display: grid; gap: 4px; padding: 22px 26px 20px; background: var(--surface); border: 1px solid var(--line-strong); border-radius: var(--r-3); box-shadow: var(--shadow-field); }
  .evidence-kicker { display: flex; justify-content: space-between; gap: 12px; font-size: var(--size-micro); font-weight: 650; color: var(--ink-3); }
  .evidence-sheet h3 { font-family: var(--display); font-stretch: 102%; font-size: 1.375rem; font-weight: 560; letter-spacing: -.02em; line-height: 1.2; }
  .evidence-rows { display: grid; margin: 12px 0 0; border-top: 1.5px solid var(--ink); }
  /* Beat 1: the rows are read one after another. */
  .evidence-rows > div { --v: clamp(0, var(--b1, 1) * 5 - var(--r) * .5, 1); display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: 2px 14px; align-items: baseline; padding: 9px 0; border-bottom: 1px solid var(--line); font-size: var(--size-small);
    opacity: var(--v); transform: translateY(calc((1 - var(--v)) * 6px)); }
  .evidence-rows dt { font-weight: 650; display: flex; flex-wrap: wrap; gap: 0 8px; align-items: baseline; }
  .evidence-rows dt small { font-size: var(--size-micro); font-weight: 560; color: var(--ink-3); }
  .evidence-rows dd { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 10px; align-items: baseline; margin: 0; color: var(--ink-2); }
  .evidence-rows dd b { color: var(--ink); font-weight: 650; }
  .evidence-rows > div[data-tone='unknown'] dd b { color: var(--ink-2); font-weight: 560; }
  /* Beat 2: the limits. */
  .evidence-coverage { display: grid; gap: 6px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); font-size: var(--size-micro); color: var(--ink-2); --v: clamp(0, var(--b2, 1) * 2.5, 1); opacity: var(--v); transform: translateY(calc((1 - var(--v)) * 8px)); }
  .evidence-coverage span { display: inline-flex; align-items: center; gap: 8px; }
  .evidence-legend { font-size: var(--size-micro); color: var(--ink-3); text-align: center; }
  :global(.js) .evidence.is-live .evidence-inner { gap: 0; padding-top: 16px; }
  :global(.js) .evidence.is-live .evidence-figure { align-self: start; }
  @media (max-width: 52rem) {
    .evidence-sheet { padding: 16px 16px 14px; }
    .evidence-sheet h3 { font-size: 1.125rem; }
    .evidence-rows > div { grid-template-columns: 6.75rem minmax(0, 1fr); gap: 0 10px; padding: 7px 0; font-size: .84375rem; }
    .js .evidence.is-live .evidence-captions { height: clamp(140px, 22vh, 190px); }
  }
  @media (max-width: 22.5rem) { .evidence-rows > div { grid-template-columns: minmax(0, 1fr); } }
</style>

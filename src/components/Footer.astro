---
import Brand from './Brand.astro';
import LangSwitch from './LangSwitch.astro';
import { CONTACT_EMAIL } from '../lib/contact';
import { DOCS_BASE } from '../lib/open-core-docs';
import { MARKETING_ORIGIN, marketingHome } from '../lib/marketing';
import { pathFor, type Catalogue, type Lang } from '../i18n';
interface Props { lang: Lang; t: Catalogue; path: string; langs?: boolean }
const { lang, t, path, langs = true } = Astro.props;
const year = new Date().getUTCFullYear();
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <Brand href={pathFor(lang, '/')} name={t.site.name} />
      <p>{t.site.claim}</p>
    </div>
    <nav aria-labelledby="footer-product">
      <h2 id="footer-product">{t.site.footer.product}</h2>
      <a href={DOCS_BASE}>{t.site.nav.docs}</a>
      <a href={pathFor(lang, '/developers')}>{t.site.nav.developers}</a>
      <a href={pathFor(lang, '/status')}>{t.status.eyebrow}</a>
      <a href={pathFor(lang, '/changelog')}>{t.changelog.link}</a>
      <a href={marketingHome(lang)} translate="no">{new URL(MARKETING_ORIGIN).host}</a>
    </nav>
    <nav aria-labelledby="footer-legal">
      <h2 id="footer-legal">{t.site.footer.legal}</h2>
      <a href={pathFor(lang, '/imprint')}>{t.site.footer.imprint}</a>
      <a href={pathFor(lang, '/privacy')}>{t.site.footer.privacy}</a>
      <a href={pathFor(lang, '/contact')}>{t.site.footer.contact}</a>
    </nav>
    <!-- One constant switches the address on, once the owner's domain exists: CONTACT_EMAIL in the build's environment (src/lib/contact.ts). -->
    <section id="contact" class="contact" aria-labelledby="footer-contact">
      <h2 id="footer-contact">{t.site.footer.contact}</h2>
      {CONTACT_EMAIL ? <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> : <p data-contact-pending>{t.site.footer.contactPending}</p>}
    </section>
    <p class="footer-line">© {year} {t.site.name}. {t.site.footer.line}</p>
  </div>
  {langs && <LangSwitch lang={lang} t={t} path={path} />}
</footer>

<style>
  /* A8: no fill of its own, so the page's ground runs on; a rule above it is all that marks it. The language is no longer
     listed here (third pass): the floating button (LangSwitch) holds it, and the footer ends with room for that button, so
     the last line can always be read clear of it. */
  .footer { background: transparent; border-top: 1px solid var(--lb-line); }
  .footer-inner { display: grid; grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(0, 1fr)) minmax(0, 1.5fr); gap: 32px 40px; padding-block: 56px calc(36px + var(--target) + 32px + env(safe-area-inset-bottom, 0px)); font-size: var(--size-small); }
  .footer-brand { display: grid; gap: 8px; align-content: start; }
  .footer-brand p { max-width: 30ch; color: var(--lb-slate); }
  nav, .contact { display: grid; align-content: start; justify-items: start; }
  .contact p { max-width: 34ch; color: var(--lb-slate); }
  h2 { margin-bottom: 6px; font-family: var(--text); font-size: var(--size-micro); font-weight: 650; letter-spacing: .04em; color: var(--lb-slate); }
  nav a, .contact a { display: inline-flex; align-items: center; min-height: var(--target); min-width: var(--target); color: var(--lb-ink); text-decoration: none; }
  nav a:hover { text-decoration: underline; text-decoration-color: var(--lb-line); }
  nav a[aria-current] { font-weight: 650; }
  .footer-line { grid-column: 1 / -1; padding-top: 20px; border-top: 1px solid var(--lb-line); color: var(--lb-slate); }
  @media (max-width: 48rem) { .footer-inner { grid-template-columns: 1fr 1fr; } .footer-brand, .contact { grid-column: 1 / -1; } }
  @media (max-width: 22.5rem) { .footer-inner { grid-template-columns: 1fr; } }
</style>

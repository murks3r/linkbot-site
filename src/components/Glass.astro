---
/* The privacy chapter's scene (Concept A6): two sides of the glass.

   One object, seen from both sides. The front is what the person sees: their words as the search,
   what they saved, the search they watch. The scroll turns it over: the back is what an employer
   sees, frosted glass with nothing to read, because there is no profile, no directory and no
   message when a listing fits. Then the person chooses three details for one named recipient, and
   only those defrost; a receipt stays with the person.

   Focus is the language again: clear to you, frosted to everyone else, clear only where you
   choose. The states and their status are the product's own: searching without an account,
   saving and watching (with one) are live; sharing is built and tested in staging, not yet live
   with employers; private matching is in development. Nothing here claims encryption, anonymity
   or that Linkbot itself cannot see what it stores. */
import Mark from './Mark.astro';
import { reading, LEVEL, ORBIT } from '../data/content';
const words = reading('story');
const fits = ORBIT.ring.filter(o => o.fit);
const CAPTIONS: [string, string][] = [
  ['Clear to you.', 'Your words, what fits, what you keep. Search without an account and nothing is stored; with one, what you save is yours alone.'],
  ['Frosted to everyone else.', 'There is no public profile and no directory of people. A listing can fit you without anyone being told: a match is never consent.'],
  ['Clear only where you choose.', 'Share chosen details with one named recipient, once or by a rule you set, each time with a receipt. Applying is a separate step.'],
];
const SHARED: [string, string][] = [['Work mode', 'Hybrid'], ['Location', 'Lisbon'], ['Skills', 'Research, prototyping']];
---
<section class="scene glass" data-scene data-beats="0:.28,.34:.64,.7:1" style="--beats: 3; --beat: 95svh" aria-labelledby="glass-caption-1">
  <div class="scene-stage glass-stage" data-scene-stage data-decor>
    <svg class="glass-grain" aria-hidden="true" focusable="false"><rect class="grain-coarse" width="100%" height="100%" fill="url(#grain-tile-coarse)" /><rect class="grain-fine" width="100%" height="100%" fill="url(#grain-tile-fine)" /></svg>
    <div class="scene-inner glass-inner">
      <ol class="captions">
        {CAPTIONS.map(([title, body], i) => <li class="caption" data-caption id={`glass-caption-${i + 1}`}><h2>{title}</h2><small>{body}</small></li>)}
      </ol>
      <figure class="glass-figure" aria-labelledby="glass-legend">
        <div class="glass-card">
          <div class="glass-face glass-front" role="group" aria-label="What you see">
            <p class="glass-label">What you see</p>
            <ul class="glass-chips" aria-label="Your search">
              {words.criteria.map(c => <li class="chip"><span>{c.label}</span><small>{LEVEL[c.level ?? 'prefer']}</small></li>)}
            </ul>
            <ul class="glass-saved" aria-label="Saved, privately">
              {fits.slice(0, 2).map(o => <li><Mark tone="fit" size={10} /><span>{o.title}</span><small>saved</small></li>)}
            </ul>
            <p class="glass-watch"><Mark tone="fit" size={10} />You watch this search: new listings, when you come back</p>
          </div>
          <div class="glass-face glass-back" role="group" aria-label="What an employer sees">
            <div class="glass-ghost" aria-hidden="true"><i></i><i></i><b></b></div>
            <p class="glass-label">What an employer sees</p>
            <p class="glass-nothing"><b>Nothing.</b><small>No profile, no name, no search, no message that something fits.</small></p>
            <div class="glass-shared">
              <p class="glass-to">When you choose: shared with one named recipient</p>
              <ul>
                {SHARED.map(([k, v], j) => <li style={`--j: ${j}`}><small>{k}</small><b>{v}</b></li>)}
              </ul>
              <p class="glass-receipt"><Mark tone="fit" size={10} />No name, no contact details. Your receipt: what, to whom, when.</p>
            </div>
          </div>
        </div>
        <figcaption id="glass-legend" class="glass-legend">Searching, saving and watching work today. Sharing is built and tested in staging; not yet live with employers. Private matching is in development and not live.</figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  /* The card, at its tallest side, and the legend must fit the stage; otherwise the scene stays
     complete and static (both sides shown, one after the other). */
  const glass = document.querySelector<HTMLElement>('.glass');
  glass?.addEventListener('scene:fits', event => {
    const figure = glass.querySelector<HTMLElement>('.glass-figure')!, card = glass.querySelector<HTMLElement>('.glass-card')!, legend = glass.querySelector<HTMLElement>('.glass-legend')!;
    if (card.offsetHeight + legend.offsetHeight + 40 > figure.clientHeight) (event as CustomEvent<{ ok: boolean }>).detail.ok = false;
  });
</script>

<style>
  /* ── Static: both sides, side by side (stacked on phones), the shared details clear. ── */
  .glass { color: var(--on-green); }
  /* The night's own ground: deep green lit by three proven dark tints, with the paper's grain
     (gentler here: soft-light is strongest on mid-tones). */
  .glass-stage { isolation: isolate; background:
      radial-gradient(62% 46% at 16% 30%, var(--lb-night-teal) 0%, transparent 72%),
      radial-gradient(52% 50% at 88% 62%, var(--lb-night-blue) 0%, transparent 72%),
      radial-gradient(58% 40% at 42% 100%, var(--lb-night-moss) 0%, transparent 72%),
      var(--green); }
  .glass-grain { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; mix-blend-mode: soft-light; opacity: .6; pointer-events: none; }
  .glass-grain .grain-fine { display: none; }
  @media (min-resolution: 1.5dppx) { .glass-grain .grain-coarse { display: none; } .glass-grain .grain-fine { display: inline; } }
  .glass-inner { display: grid; gap: 32px; padding: 24px var(--gutter) 48px; }
  .glass .captions { max-width: 46rem; margin-inline: auto; text-align: center; }
  .glass .captions h2 { font-size: inherit; font-weight: inherit; letter-spacing: inherit; line-height: inherit; color: var(--on-green); }
  .glass .captions small { max-width: 36em; margin-inline: auto; color: var(--on-green-2); }
  .glass-figure { display: grid; gap: 18px; justify-items: center; }
  .glass-card { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; width: min(100%, 64rem); }
  .glass-face { position: relative; display: grid; align-content: start; gap: 14px; min-height: 22rem; padding: 22px 24px; border-radius: 22px; overflow: hidden; }
  .glass-front { background: var(--surface); color: var(--ink); box-shadow: 0 30px 70px -36px rgb(0 0 0 / .55); }
  .glass-back { background: color-mix(in srgb, var(--on-green) 9%, var(--green)); color: var(--on-green); box-shadow: inset 0 1px 0 rgb(251 248 241 / .18), 0 0 0 1px rgb(251 248 241 / .14), 0 30px 70px -36px rgb(0 0 0 / .6); }
  .glass-label { font-size: var(--size-micro); font-weight: 650; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); }
  .glass-back .glass-label { color: var(--on-green-2); }
  .glass-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .glass-chips .chip { min-height: 30px; padding: 2px 11px; font-size: .8125rem; }
  .glass-saved { display: grid; gap: 6px; }
  .glass-saved li { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1px solid var(--line-strong); border-radius: var(--r-2); font-size: .875rem; font-weight: 600; }
  .glass-saved small { margin-left: auto; font-size: .75rem; font-weight: 560; color: var(--ink-2); }
  .glass-watch { display: flex; gap: 8px; align-items: center; font-size: var(--size-micro); color: var(--ink-2); }
  /* The frost: shapes of what lies behind it, in the card's lower third (never behind the words). */
  .glass-ghost { position: absolute; left: 0; right: 0; bottom: 0; height: 30%; z-index: 0; display: grid; align-content: end; gap: 10px; padding: 0 24px 26px; filter: blur(9px); opacity: .26; }
  .glass-ghost i, .glass-ghost b { display: block; height: 34px; border-radius: 10px; background: var(--on-green); }
  .glass-ghost b { width: 70%; height: 14px; }
  .glass-back > :not(.glass-ghost) { position: relative; z-index: 1; }
  .glass-nothing { display: grid; gap: 6px; padding: 18px 0 4px; }
  .glass-nothing b { font-family: var(--display); font-stretch: 100%; font-size: clamp(1.75rem, 1.3rem + 1.2vw, 2.25rem); font-weight: 560; letter-spacing: -.03em; line-height: 1.05; }
  .glass-nothing small { font-size: var(--size-small); color: var(--on-green-2); max-width: 26em; }
  .glass-shared { display: grid; gap: 10px; }
  .glass-to { font-size: var(--size-small); font-weight: 650; }
  .glass-shared ul { display: grid; gap: 6px; }
  .glass-shared li { display: grid; grid-template-columns: 7rem minmax(0, 1fr); align-items: baseline; gap: 10px; padding: 9px 13px; border-radius: var(--r-2); background: var(--surface); color: var(--ink); font-size: .875rem; }
  .glass-shared li small { font-size: .75rem; font-weight: 650; color: var(--ink-2); }
  .glass-shared li b { font-weight: 650; }
  .glass-receipt { display: flex; gap: 8px; align-items: baseline; font-size: var(--size-micro); color: var(--on-green-2); }
  .glass-receipt :global(.mark) { color: var(--on-green); flex: none; transform: translateY(1px); }
  .glass-legend { max-width: 44em; font-size: var(--size-micro); color: var(--on-green-2); text-align: center; }
  /* Statically "nothing" is shown as it is before anything is shared; the shared list follows it. */
  @media (max-width: 52rem) { .glass-card { grid-template-columns: minmax(0, 1fr); } .glass-face { min-height: 0; } }

  /* ── Live: one card, turned over by the scroll. It turns in the first part of its beat and then
     holds, so the side the statement describes faces the reader while it is read. ── */
  :global(.js) .glass.is-live .glass-inner { gap: 0; padding: 16px var(--gutter) 0; height: 100%; grid-template-rows: auto minmax(0, 1fr); }
  :global(.js) .glass.is-live .glass-figure { position: relative; height: 100%; align-content: start; perspective: 1600px; perspective-origin: 50% 40%; }
  :global(.js) .glass.is-live .glass-card { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); width: min(100%, 34rem); transform-style: preserve-3d;
    --t: clamp(0, var(--b2) / .45, 1); --turn: calc(var(--t) * var(--t) * (3 - 2 * var(--t))); --arc: sin(calc(var(--turn) * 180deg));
    transform: translateY(calc(var(--arc) * -10px)) rotateY(calc(var(--turn) * -180deg)) scale(calc(1 - .05 * var(--arc))); }
  :global(.js) .glass.is-live .glass-face { grid-area: 1 / 1; min-height: min(20rem, 44vh); backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  :global(.js) .glass.is-live .glass-back { transform: rotateY(180deg); }
  /* A light crosses the glass as it turns. */
  :global(.js) .glass.is-live .glass-face::after { content: ''; position: absolute; inset: 0; z-index: 2; pointer-events: none; border-radius: inherit;
    background: linear-gradient(105deg, transparent 30%, rgb(255 255 255 / .5) 50%, transparent 70%) no-repeat; background-size: 250% 100%;
    background-position: calc(100% - var(--turn) * 100%) 0; opacity: calc(var(--arc) * .8); }
  /* 3: three details defrost, one after another; "nothing" gives way to exactly what was shared. */
  :global(.js) .glass.is-live .glass-nothing { opacity: calc(1 - clamp(0, var(--b3) * 4, 1)); }
  :global(.js) .glass.is-live .glass-back { display: grid; }
  :global(.js) .glass.is-live .glass-back > .glass-nothing, :global(.js) .glass.is-live .glass-back > .glass-shared { grid-area: 2 / 1; }
  :global(.js) .glass.is-live .glass-shared { opacity: clamp(0, var(--b3) * 4, 1); }
  :global(.js) .glass.is-live .glass-shared li { --v: clamp(0, var(--b3) * 5 - var(--j) * .6, 1); filter: blur(calc((1 - var(--v)) * 8px)); opacity: calc(.3 + .7 * var(--v)); transform: translateY(calc((1 - var(--v)) * 6px)); }
  :global(.js) .glass.is-live .glass-receipt { opacity: clamp(0, (var(--b3) - .2) * 5, 1); }
  :global(.js) .glass.is-live .glass-legend { position: absolute; left: 0; right: 0; bottom: 16px; margin-inline: auto; }
  @media (max-width: 52rem) {
    :global(.js) .glass.is-live .glass-face { padding: 18px; min-height: min(23rem, 50vh); }
    :global(.js) .glass.is-live .glass-shared li { grid-template-columns: 5.5rem minmax(0, 1fr); }
  }
</style>

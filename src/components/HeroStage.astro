---
/* The hero's proof, in two pieces of paper that match the headline: "Say what matters" (a
   sentence as Linkbot's interpreter really read it) and "See what fits" (an example listing,
   read the way Linkbot reads every listing). The marks draw once on load; the words never wait. */
import Mark from './Mark.astro';
import { reading, LEVEL, KIND, LISTING } from '../data/content';
const r = reading('phrases');
const parts: { text: string; tone: string | null }[] = [];
let at = 0;
for (const span of r.spans) { if (span.start > at) parts.push({ text: r.text.slice(at, span.start), tone: null }); parts.push({ text: r.text.slice(span.start, span.end), tone: span.tone }); at = span.end; }
if (at < r.text.length) parts.push({ text: r.text.slice(at), tone: null });
---
<div class="stage" aria-label="Example: one sentence read by Linkbot, and one listing read against it" role="group">
  <figure class="card stage-words" data-draw>
    <figcaption class="card-label"><span>Your words</span><span>Read by Linkbot</span></figcaption>
    <div class="card-body">
      <p class="stage-sentence">{parts.map(p => p.tone === 'read' ? <span class="hl">{p.text}</span> : p.tone ? <span class="unused">{p.text}</span> : p.text)}</p>
      <dl class="stage-read">
        {r.criteria.map(c => <div><dt>{KIND[c.dimension] ?? 'Understood'}</dt><dd><b>{c.label}</b><span class="chip" data-level={c.level}>{LEVEL[c.level ?? 'prefer']}</span></dd></div>)}
      </dl>
    </div>
  </figure>
  <figure class="card stage-listing">
    <figcaption class="card-label"><span>Example listing</span><span>{LISTING.checked}</span></figcaption>
    <div class="card-body">
      <p class="stage-title">{LISTING.title}</p>
      <p class="stage-facts">{LISTING.org} · {LISTING.place} · {LISTING.hours}</p>
      <ul class="stage-evidence">
        {LISTING.rows.map(row => <li data-tone={row.tone}><Mark tone={row.tone} /><span><b>{row.ask}</b><span>{row.says}{row.tone === 'fit' ? `, ${row.where}` : ''}</span></span></li>)}
      </ul>
    </div>
  </figure>
</div>

<style>
  .stage { position: relative; display: grid; gap: 0; padding-bottom: 8px; }
  .card { box-shadow: var(--shadow-stage); }
  .stage-words { width: min(100%, 30rem); }
  .stage-listing { width: min(100%, 26rem); margin: -28px 0 0 auto; position: relative; }
  .stage-sentence { font-size: clamp(1.25rem, 1.1rem + .6vw, 1.5rem); font-weight: 560; line-height: 1.4; letter-spacing: -.012em; }
  .stage-read { display: grid; margin-top: 16px; }
  .stage-read > div { display: grid; grid-template-columns: 6rem minmax(0, 1fr); align-items: center; gap: 4px 12px; padding: 8px 0; border-top: 1px solid var(--line); }
  .stage-read dt { font-size: var(--size-micro); font-weight: 600; color: var(--ink-3); }
  .stage-read dd { display: flex; align-items: center; justify-content: space-between; gap: 8px 12px; min-width: 0; font-size: var(--size-small); }
  .stage-read dd b { font-weight: 620; overflow-wrap: anywhere; }
  .stage-read .chip { min-height: 28px; padding: 2px 10px; font-size: var(--size-micro); }
  .stage-title { font-size: 1.25rem; font-weight: 620; letter-spacing: -.015em; line-height: 1.2; }
  .stage-facts { margin-top: 4px; font-size: var(--size-small); color: var(--ink-2); }
  .stage-evidence { display: grid; gap: 10px; margin-top: 16px; padding-top: 14px; border-top: 2px solid var(--ink); }
  .stage-evidence li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: 10px; align-items: baseline; font-size: var(--size-small); }
  .stage-evidence li > span { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 12px; }
  .stage-evidence b { font-weight: 620; }
  .stage-evidence li[data-tone='fit'] b { background: var(--mark-soft); }
  .stage-evidence li[data-tone='unknown'] { color: var(--ink-2); }
  .stage-evidence li[data-tone='unknown'] b { font-weight: 560; }
  @media (max-width: 40rem) {
    .stage-listing { margin: 14px 0 0; width: 100%; }
    .stage-words { width: 100%; }
  }
</style>

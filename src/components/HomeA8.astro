---
/* The home as the catalogue has it (concept A8's composition, S1's words): the claim over the living light, the six
   steps, three statements, the four ways, the rules, for whom, where it stands. Since the front-page previews of
   2026-10-24 (GEO-188) it is the home of the four translated languages; the English root renders the preview's own
   front (src/components/front/). Moved here from src/pages/[...lang]/index.astro unchanged. */
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Flow from './Flow.astro';
import Ways from './Ways.astro';
import { pathFor, type Catalogue, type Lang } from '../i18n';
interface Props { lang: Lang; t: Catalogue; fallback: boolean }
const { lang, t, fallback } = Astro.props;
const h = t.home;
const to = (path: string) => pathFor(lang, path);
---
<Base lang={lang} t={t} fallback={fallback} title={h.title} description={h.description} path="/">
  <!-- 1. The opening: the claim in two lines over the living light, the path from a need to an
       introduction in six tiles beneath it. -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <h1 id="hero-title">{h.h1.map(line => <span class="h1-line">{line}</span>)}</h1>
      <p class="lede hero-lede">{h.lede}</p>
      <p class="hero-actions"><a class="btn btn-primary" href={to('/how-it-works')}>{h.actions.how}<Icon name="arrow" /></a><a class="link" href={to('/platforms')}>{h.actions.platforms}<Icon name="arrow" /></a></p>
      <div class="hero-flow"><Flow label={h.flow.label} steps={h.flow.steps} /></div>
    </div>
  </section>

  <!-- 2. Three statements: a space, confirmed criteria, both yes. -->
  <section class="band">
    <div class="wrap">
      <ul class="pillars">{h.pillars.map(pillar => <li><h2>{pillar.title}</h2><p>{pillar.body}</p></li>)}</ul>
    </div>
  </section>

  <!-- 3. The four ways, each with where it stands. -->
  <section class="band" aria-labelledby="ways-title">
    <div class="wrap section">
      <div class="section-head"><h2 id="ways-title">{h.ways.title}</h2><p>{h.ways.lede}</p></div>
      <Ways t={t} items={h.ways.items} />
    </div>
  </section>

  <!-- 4. The rules the server enforces. -->
  <section class="band" data-tone="mist" aria-labelledby="rules-title">
    <div class="wrap section">
      <h2 id="rules-title">{h.rules.title}</h2>
      <ol class="rules">{h.rules.items.map(rule => <li>{rule}</li>)}</ol>
      <p><a class="link" href={to('/how-it-works')}>{h.rules.link}<Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- 5. For whom. -->
  <section class="band">
    <div class="wrap duo">
      <article class="tile duo-card" aria-labelledby="duo-platforms"><h2 id="duo-platforms">{h.platforms.title}</h2><p>{h.platforms.body}</p><a class="link" href={to('/platforms')}>{h.platforms.link}<Icon name="arrow" /></a></article>
      <article class="tile duo-card" aria-labelledby="duo-verticals"><h2 id="duo-verticals">{h.verticals.title}</h2><p>{h.verticals.body}</p><a class="link" href={to('/verticals')}>{h.verticals.link}<Icon name="arrow" /></a></article>
    </div>
  </section>

  <!-- 6. Where it stands: synthetic, no demo yet. -->
  <section class="band" aria-labelledby="state-title">
    <div class="wrap state">
      <h2 id="state-title">{h.state.title}</h2>
      <p>{t.site.synthetic}</p>
      <p>{h.state.body}</p>
    </div>
  </section>
</Base>


<style>
  /* 1. The hero: the claim, then the lede, then the path. A pool of light behind the words lifts
     them off the colour around them (never wider than the page, so nothing overflows). */
  .hero { position: relative; isolation: isolate; min-height: calc(100svh - var(--header)); display: grid; align-content: center; padding: clamp(40px, 7vh, 88px) 0 clamp(32px, 6vh, 64px); }
  .hero-inner { position: relative; display: grid; justify-items: center; text-align: center; gap: clamp(18px, 2.6vh, 28px); }
  .hero h1 { max-width: 15ch; font-size: clamp(2.5rem, 1.3rem + 4.2vw, 5rem); font-weight: 560; letter-spacing: -.036em; line-height: 1; }
  .h1-line { display: block; }
  .hero-lede { max-width: 40em; color: var(--ink); }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px 24px; }
  .hero-flow { width: min(100%, 68rem); margin-top: clamp(16px, 4vh, 40px); }

  /* 2. The statements, three across, each under its own rule. */
  .pillars { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px clamp(24px, 4vw, 56px); }
  .pillars li { display: grid; gap: var(--space-head); align-content: start; padding-top: 18px; border-top: 1.5px solid var(--ink); }
  .pillars h2 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); }
  .pillars p { color: var(--ink-2); }

  .section { display: grid; gap: var(--space-block); }
  .section-head { max-width: 46rem; }

  /* 4. The rules, counted, two columns where they fit. */
  .rules { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(24px, 4vw, 56px); counter-reset: rule; max-width: 64rem; }
  .rules li { position: relative; padding: 14px 0 14px 44px; border-top: 1px solid var(--line-strong); counter-increment: rule; color: var(--ink); }
  .rules li::before { content: counter(rule); position: absolute; left: 0; top: 13px; width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; border: 1.5px solid var(--line-ink); background: var(--surface); font-size: var(--size-micro); font-weight: 700; color: var(--ink-2); }

  /* 5. Two paper tiles, side by side. */
  .duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .duo-card { display: grid; gap: 12px; align-content: start; padding: clamp(22px, 3vw, 34px); }
  .duo-card h2 { font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.2rem); }
  .duo-card p { color: var(--ink-2); }
  .duo-card .link { justify-self: start; }

  /* 6. Where it stands: on the centre line. */
  .state { display: grid; gap: var(--space-head); justify-items: center; text-align: center; max-width: 44rem; }
  .state p { color: var(--ink-2); }

  @media (max-width: 56rem) { .pillars { grid-template-columns: minmax(0, 1fr); } .rules { grid-template-columns: minmax(0, 1fr); } .duo { grid-template-columns: minmax(0, 1fr); } }
</style>

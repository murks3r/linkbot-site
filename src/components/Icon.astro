---
/* The icons: the brand lab's set, style A "eckig-fein" (Lane F, exploration-r2-v1; 24-px masters, stroke 1.5, square
   caps, mitred corners; the 16-px optical versions below 18 px, as the lab recommends). Inline, one colour, aria-hidden:
   wherever an icon stands beside text it is decoration; where it stands alone the control carries the label. Names:
   arrow (F-I17), down (F-I20 chevron), close (F-I16), search (F-I01), out (F-I22), pin (F-I02), info (F-I18),
   menu (F-I21), fit (F-I24, the two circles with their shared area), eye (F-I23). */
interface Props { name: 'arrow' | 'down' | 'close' | 'search' | 'out' | 'pin' | 'info' | 'menu' | 'fit' | 'eye' | 'check'; size?: number }
const { name, size = 16 } = Astro.props;
const small = size <= 18;
const box = small ? 16 : 24;
---
<svg class="icon" width={size} height={size} viewBox={`0 0 ${box} ${box}`} fill="none" stroke="currentColor" stroke-width={small ? 1 : 1.5} stroke-linecap="square" stroke-linejoin="miter" stroke-miterlimit="4" aria-hidden="true" focusable="false">
  {name === 'arrow' && (small ? <><path d="M2.5 8.5L12.5 8.5" /><path d="M8.5 3.5L13.5 8.5L8.5 12.5" /></> : <><path d="M3.75 12L18 12" /><path d="M13.25 5.75L19.5 12L13.25 18.25" /></>)}
  {name === 'down' && (small ? <path d="M4.5 6.5L8.5 9.5L11.5 6.5" /> : <path d="M6.5 9.25L12 14.75L17.5 9.25" />)}
  {name === 'close' && (small ? <><path d="M3.5 3.5L12.5 12.5" /><path d="M12.5 3.5L3.5 12.5" /></> : <><path d="M5.5 5.5L18.5 18.5" /><path d="M18.5 5.5L5.5 18.5" /></>)}
  {name === 'search' && (small ? <><circle cx="7.5" cy="7.5" r="4" /><path d="M10.5 10.5L13.5 13.5" /></> : <><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.096 15.096L20.25 20.25" /></>)}
  {name === 'out' && (small ? <><path d="M7.5 3.5L3.5 3.5L3.5 12.5L12.5 12.5L12.5 8.5" /><path d="M7.5 8.5L12.5 3.5" /><path d="M9.5 2.5L13.5 2.5L13.5 6.5" /></> : <><path d="M11 5.25L4.75 5.25L4.75 19.25L18.75 19.25L18.75 13" /><path d="M11.5 12.5L18.69 5.31" /><path d="M13.75 4.25L19.75 4.25L19.75 10.25" /></>)}
  {name === 'pin' && (small ? <><path d="M8.5 14.5L5.036 8.5A4 4 0 1 1 11.964 8.5Z" /><circle cx="8.5" cy="6.5" r="2" /></> : <><path d="M12 21L6.756 13.841A6.5 6.5 0 1 1 17.244 13.841Z" /><circle cx="12" cy="10" r="2.25" /></>)}
  {name === 'info' && (small ? <><circle cx="8.5" cy="8.5" r="6" /><path d="M8.5 7.5L8.5 11.5" /><path d="M8 5H9V6H8Z" fill="currentColor" stroke="none" /></> : <><circle cx="12" cy="12" r="8.5" /><path d="M12 11L12 16.5" /><path d="M11.25 7H12.75V8.5H11.25Z" fill="currentColor" stroke="none" /></>)}
  {name === 'menu' && (small ? <><path d="M2.5 4.5L13.5 4.5" /><path d="M2.5 8.5L13.5 8.5" /><path d="M2.5 11.5L13.5 11.5" /></> : <><path d="M3.75 6.5L20.25 6.5" /><path d="M3.75 12L20.25 12" /><path d="M3.75 17.5L20.25 17.5" /></>)}
  {name === 'fit' && (small ? <><circle cx="5.5" cy="8.5" r="4" /><circle cx="10.5" cy="8.5" r="4" /><path d="M8 5.378A4 4 0 0 1 8 11.622A4 4 0 0 1 8 5.378Z" fill="currentColor" stroke="none" /></> : <><circle cx="8.75" cy="12" r="5.75" /><circle cx="15.25" cy="12" r="5.75" /><path d="M12 7.257A5.75 5.75 0 0 1 12 16.743A5.75 5.75 0 0 1 12 7.257Z" fill="currentColor" stroke="none" /></>)}
  {name === 'eye' && (small ? <><path d="M1.5 8.5Q8 0 14.5 8.5Q8 16 1.5 8.5Z" /><circle cx="8.5" cy="8.5" r="1.75" fill="currentColor" stroke="none" /></> : <><path d="M2.75 12Q12 0 21.25 12Q12 24 2.75 12Z" /><circle cx="12" cy="12" r="2.5" fill="currentColor" stroke="none" /></>)}
  {name === 'check' && (small ? <path d="M3 8.5l3 3 7-7" /> : <path d="M4.5 12.5l4.5 4.5 10.5-10.5" />)}
</svg>

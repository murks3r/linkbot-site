---
import { app } from '../lib/links';
import Icon from './Icon.astro';
interface Props { current?: string }
const { current } = Astro.props;
const NAV: [string, string][] = [['/how-it-works', 'How it works'], ['/privacy', 'Privacy'], ['/hiring', 'Hiring']];
---
<header class="masthead" data-masthead>
  <div class="wrap masthead-inner">
    <a class="brand" href="/"><span>Linkbot</span></a>
    <nav class="nav" aria-label="Main">
      {NAV.map(([href, label]) => <a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>)}
    </nav>
    <a class="btn btn-primary masthead-cta" data-size="sm" href={app('#/search')}>Search jobs</a>
    <details class="menu" data-menu>
      <summary><span>Menu</span><Icon name="down" /></summary>
      <nav class="menu-panel" aria-label="Main">
        {NAV.map(([href, label]) => <a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>)}
        <a href={app('#/saved')}>My radar</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .masthead { position: sticky; top: 0; z-index: 30; background: var(--paper); border-bottom: 1px solid transparent; transition: border-color var(--base); }
  .masthead[data-scrolled] { border-bottom-color: var(--line); }
  .masthead-inner { display: flex; align-items: center; gap: 12px clamp(20px, 3vw, 40px); min-height: 72px; }
  .brand { display: inline-flex; align-items: center; min-height: var(--target); font-size: 1.625rem; font-weight: 700; letter-spacing: -.035em; line-height: 1; text-decoration: none; color: var(--ink); }
  .brand span { padding: 0 .08em; margin: 0 -.08em; background: linear-gradient(transparent 0 54%, var(--sun) 54% 94%, transparent 94%); }
  .nav { display: flex; gap: 4px clamp(18px, 2.4vw, 32px); margin-left: auto; }
  .nav a { position: relative; display: inline-flex; align-items: center; min-height: var(--target); font-size: var(--size-small); font-weight: 580; color: var(--ink-2); text-decoration: none; }
  .nav a:hover { color: var(--ink); }
  .nav a[aria-current='page'] { color: var(--ink); font-weight: 650; }
  .nav a[aria-current='page']::after { content: ''; position: absolute; left: 0; right: 0; bottom: 6px; height: 2px; background: var(--cobalt); }
  .menu { display: none; position: relative; }
  .menu summary { display: inline-flex; align-items: center; gap: 8px; min-height: var(--target); padding: 0 14px; border: 1px solid var(--line-strong); border-radius: var(--r-2); font-size: var(--size-small); font-weight: 620; cursor: pointer; list-style: none; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu[open] summary { border-color: var(--ink); }
  .menu-panel { position: absolute; right: 0; top: calc(100% + 8px); width: min(280px, calc(100vw - 32px)); padding: 6px; display: grid; background: var(--paper); border: 1px solid var(--line-strong); border-radius: var(--r-3); box-shadow: var(--shadow-stage); }
  .menu-panel a { display: flex; align-items: center; min-height: var(--target); padding: 0 12px; border-radius: var(--r-2); font-weight: 580; text-decoration: none; }
  .menu-panel a:hover { background: var(--sand); }
  .menu-panel a[aria-current='page'] { background: var(--cobalt-wash); color: var(--cobalt); }
  @media (max-width: 52rem) {
    .masthead-inner { min-height: 64px; }
    .nav { display: none; }
    .masthead-cta { margin-left: auto; }
    .menu { display: block; }
  }
  @media (max-width: 22.5rem) {
    .brand { font-size: 1.4rem; }
    .menu summary span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .menu summary { padding: 0 12px; }
    .masthead-cta { padding: 0 12px; }
  }
</style>

<script>
  const masthead = document.querySelector<HTMLElement>('[data-masthead]');
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  if (masthead) {
    const update = () => masthead.toggleAttribute('data-scrolled', window.scrollY > 8);
    update();
    addEventListener('scroll', update, { passive: true });
  }
  if (menu) {
    document.addEventListener('pointerdown', event => { if (menu.open && !menu.contains(event.target as Node)) menu.open = false; });
    menu.addEventListener('keydown', event => { if (event.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); } });
  }
</script>

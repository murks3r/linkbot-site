---
/* Page metadata, in the page's language, with every other language as an alternate. Structured
   data on every page: Organization, WebSite, SoftwareApplication and the page's BreadcrumbList, plus what the page
   adds (ld: /faq's FAQPage and DefinedTermSet). It states only what is true today: the name, the address of this site
   and the definition of Linkbot from src/i18n/terms.ts. Legal name, founding date, address, logo and any price are left
   out until the owner confirms them; tests/schema.test.mjs reads it back from every built page. Previews (PUBLIC_NOINDEX=1) and drafts are never indexed; a draft has no alternates.
   Each page and language has its own preview image, drawn after the build from this page's og:title and og:description
   (src/integrations/share-images.ts). */
import { cardPath } from '../lib/share-card';
import { DEFAULT_LANG, LANGS, pathFor, type Catalogue, type Lang } from '../i18n';
import { TERMS } from '../i18n/terms';
interface Props { lang: Lang; t: Catalogue; title: string; description: string; path: string; crumbs?: [string, string][]; draft?: boolean; ld?: Record<string, unknown>[] }
const { lang, t, title, description, path, crumbs = [], draft = false, ld = [] } = Astro.props;
const NOINDEX = draft || import.meta.env.PUBLIC_NOINDEX === '1';
const OG_LOCALE: Record<Lang, string> = { en: 'en_GB', de: 'de_DE', es: 'es_ES', it: 'it_IT', fr: 'fr_FR' };
const site = Astro.site ?? new URL('https://linkbot-site.vercel.app');
const url = (l: Lang, p = path) => new URL(pathFor(l, p), site).toString();
const canonical = url(lang);
const image = new URL(cardPath(lang, path), site).toString();
const org = `${site.origin}/#organization`;
const about = TERMS[lang].linkbot.definition;
/* A page that names no crumbs is one step below the home, under its own title. */
const trail: [string, string][] = path === '/' ? [] : crumbs.length ? crumbs : [[title, path]];
const graph: Record<string, unknown>[] = [
  { '@type': 'Organization', '@id': org, name: t.site.name, url: site.origin, description: about },
  { '@type': 'WebSite', name: t.site.name, url: url(lang, '/'), inLanguage: lang, publisher: { '@id': org } },
  { '@type': 'SoftwareApplication', name: t.site.name, url: url(lang, '/'), applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: about, inLanguage: lang, publisher: { '@id': org } },
  { '@type': 'BreadcrumbList', itemListElement: [[t.site.name, '/'], ...trail].map(([name, href], index) => ({ '@type': 'ListItem', position: index + 1, name, item: url(lang, href) })) },
  ...ld,
].map(node => ({ '@context': 'https://schema.org', ...node }));
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{!draft && LANGS.map(l => <link rel="alternate" hreflang={l} href={url(l)} />)}
{!draft && <link rel="alternate" hreflang="x-default" href={url(DEFAULT_LANG)} />}
{NOINDEX && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={t.site.name} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image:alt" content={title} />
<script type="application/ld+json" set:html={JSON.stringify(graph)} />

---
/* Page metadata, in the page's language, with every other language as an alternate. Structured
   data states only what is verifiable today: the name, the address of this site and a plain
   description. Legal name, founding date, address and logo are left out until the owner confirms
   them. Previews (PUBLIC_NOINDEX=1) and drafts are never indexed; a draft has one language and no alternates. */
import { DEFAULT_LANG, LANGS, pathFor, type Catalogue, type Lang } from '../i18n';
interface Props { lang: Lang; t: Catalogue; title: string; description: string; path: string; crumbs?: [string, string][]; draft?: boolean }
const { lang, t, title, description, path, crumbs = [], draft = false } = Astro.props;
const NOINDEX = draft || import.meta.env.PUBLIC_NOINDEX === '1';
const OG_LOCALE: Record<Lang, string> = { en: 'en_GB', de: 'de_DE', es: 'es_ES', it: 'it_IT', fr: 'fr_FR' };
const site = Astro.site ?? new URL('https://linkbot-site.vercel.app');
const url = (l: Lang, p = path) => new URL(pathFor(l, p), site).toString();
const canonical = url(lang);
const image = new URL('/og.png', site).toString();
const graph: Record<string, unknown>[] = [];
if (path === '/') graph.push(
  { '@context': 'https://schema.org', '@type': 'Organization', name: t.site.name, url: site.origin, description: t.site.claim },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: t.site.name, url: url(lang, '/'), inLanguage: lang },
);
if (crumbs.length) graph.push({ '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [[t.site.name, '/'], ...crumbs].map(([name, href], index) => ({ '@type': 'ListItem', position: index + 1, name, item: url(lang, href) })) });
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{!draft && LANGS.map(l => <link rel="alternate" hreflang={l} href={url(l)} />)}
{!draft && <link rel="alternate" hreflang="x-default" href={url(DEFAULT_LANG)} />}
{NOINDEX && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={t.site.name} />
<meta property="og:locale" content={OG_LOCALE[lang]} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${t.site.name}: ${t.home.h1.join(' ')}`} />
<meta name="twitter:card" content="summary_large_image" />
{graph.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(graph.length === 1 ? graph[0] : graph)} />}

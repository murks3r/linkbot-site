---
/* What runs on the staging space today, in three honest columns with the same squares the product
   uses for evidence: solid = on staging now, split = in the contract and not on staging yet,
   dashed = not built. */
import Mark from './Mark.astro';
import type { Status } from '../i18n/en';
interface Props { columns: { status: Status; title: string; lead: string; items: string[] }[] }
const { columns } = Astro.props;
const TONE = { now: 'fit', contract: 'tradeoff', later: 'unknown' } as const;
---
<div class="today">
  {columns.map(column => <section class="today-col" aria-labelledby={`today-${column.status}`} data-tone={column.status}>
    <h3 id={`today-${column.status}`}><Mark tone={TONE[column.status]} size={14} />{column.title}</h3>
    <p>{column.lead}</p>
    <ul>{column.items.map(item => <li>{item}</li>)}</ul>
  </section>)}
</div>

<style>
  .today { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .today-col { display: grid; gap: 10px; align-content: start; padding: clamp(18px, 2.4vw, 26px); border: 1px solid var(--line-strong); border-radius: var(--r-3); background: var(--surface); }
  .today-col h3 { display: flex; align-items: center; gap: 10px; font-size: 1.125rem; }
  .today-col > p { font-size: var(--size-small); color: var(--ink-2); }
  .today-col ul { display: grid; gap: 6px; padding-top: 8px; border-top: 1px solid var(--line); font-size: var(--size-small); }
  .today-col li { padding-left: 1em; text-indent: -1em; }
  .today-col li::before { content: '·'; display: inline-block; width: 1em; text-indent: 0; color: var(--ink-3); }
  .today-col[data-tone='later'] { color: var(--ink-2); }
  @media (max-width: 56rem) { .today { grid-template-columns: minmax(0, 1fr); } }
</style>

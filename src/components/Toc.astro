---
interface Props { items: [string, string][]; label: string }
const { items, label } = Astro.props;
---
<nav class="toc" aria-label={label}>
  <p>{label}</p>
  <ol>{items.map(([id, text], index) => <li><a href={`#${id}`}><span>{index + 1}</span>{text}</a></li>)}</ol>
</nav>
<style>
  .toc { display: grid; gap: 10px; align-content: start; }
  .toc p { font-size: var(--size-micro); font-weight: 650; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3); }
  .toc ol { display: grid; gap: 0; border-left: 2px solid var(--line-strong); }
  .toc a { display: flex; align-items: center; gap: 10px; min-height: var(--target); padding: 4px 0 4px 14px; margin-left: -2px; border-left: 2px solid transparent; font-size: var(--size-small); font-weight: 580; color: var(--ink-2); text-decoration: none; }
  .toc a:hover { color: var(--ink); border-left-color: var(--ink); }
  .toc a span { font-size: var(--size-micro); color: var(--ink-3); width: 1.2em; }
  @media (min-width: 64rem) { .toc { position: sticky; top: 104px; } }
</style>

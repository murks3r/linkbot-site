---
/* What Linkbot genuinely does today, in three honest columns, with the same squares the product
   uses for evidence: solid = in the product now, split = built and being proven, dashed = not
   built yet. Every line is classified in docs/README.md (evidence table). */
import Mark from './Mark.astro';
const COLUMNS: { tone: 'fit' | 'tradeoff' | 'unknown'; title: string; lead: string; items: string[] }[] = [
  { tone: 'fit', title: 'In the product now', lead: 'Built, tested, and what you use when you search.', items: [
    'Search current listings without an account',
    'Your words read into criteria you can see and change',
    'Every listing explained: stated, stated differently, not stated',
    'Source and check date on every listing; copies of a job merged',
    'Save jobs and watch searches in a private account',
    'Apply on the original site',
  ] },
  { tone: 'tradeoff', title: 'Built, being proven', lead: 'Working in testing or a pilot; not yet everyday product.', items: [
    'Daily checks of the directions you watch',
    'Sharing chosen details with a named recipient, once or by standing rule',
    'One-click applications to roles companies publish on Linkbot',
    'Workspaces for invited recruiting agencies and companies',
  ] },
  { tone: 'unknown', title: 'Not built yet', lead: 'On the way, and not promised as a date.', items: [
    'Email or push alerts',
    'Private matching between people and companies that are hiring',
    'Companies showing interest in you',
  ] },
];
---
<div class="today">
  {COLUMNS.map(column => <section class="today-col" aria-labelledby={`today-${column.tone}`} data-tone={column.tone}>
    <h3 id={`today-${column.tone}`}><Mark tone={column.tone} size={14} />{column.title}</h3>
    <p>{column.lead}</p>
    <ul>{column.items.map(item => <li>{item}</li>)}</ul>
  </section>)}
</div>

<style>
  .today { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 28px); }
  .today-col { display: grid; gap: 10px; align-content: start; padding-top: 16px; border-top: 3px solid var(--ink); }
  .today-col[data-tone='tradeoff'] { border-top-style: double; }
  .today-col[data-tone='unknown'] { border-top-style: dashed; border-top-color: var(--line-ink); }
  .today-col h3 { display: flex; align-items: center; gap: 10px; font-size: 1.25rem; }
  .today-col[data-tone='unknown'] :global(.mark) { color: var(--ink-3); }
  .today-col p { font-size: var(--size-small); color: var(--ground-ink-2); }
  .today-col ul { display: grid; gap: 0; margin-top: 4px; }
  .today-col li { padding: 10px 0; border-bottom: 1px solid var(--line); font-size: var(--size-small); font-weight: 560; }
  .today-col[data-tone='unknown'] li { color: var(--ground-ink-2); font-weight: 500; }
  @media (max-width: 56rem) { .today { grid-template-columns: minmax(0, 1fr); } }
</style>

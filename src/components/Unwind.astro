---
/* Linkbot's answer, as the same picture changing: the loop of the problem section unwinds into a
   straight line, one segment per problem, and each stop on the line is the answer to the problem
   it replaced. The morph is the only movement (it plays once when it comes into view, and can be
   replayed); under reduced motion the line is simply there. The list is the content. */
import Mark from './Mark.astro';
import { ANSWERS } from '../data/story';
const tone = (s: string) => s === 'live' ? 'fit' : s === 'built' ? 'tradeoff' : 'unknown';
// The finished line, rendered on the server: what anyone without scripts (or with reduced motion) sees.
const X0 = 80, X1 = 920, Y = 24, STEP = (X1 - X0) / ANSWERS.length;
const lineD = (i: number) => `M${(X0 + STEP * i + 10).toFixed(1)} ${Y}L${(X0 + STEP * (i + 1) - 10).toFixed(1)} ${Y}`;
const nodeAt = (i: number) => `translate(${(X0 + STEP * (i + .5)).toFixed(1)} ${Y})`;
---
<div class="unwind" data-unwind data-state="line">
  <div class="unwind-figure" aria-hidden="true">
    <svg class="unwind-svg" viewBox="0 0 1000 260" focusable="false" data-svg>
      {ANSWERS.map((_, i) => <path class="unwind-seg" data-seg={i} d={lineD(i)} />)}
      {ANSWERS.map((_, i) => <g class="unwind-node" data-node={i} transform={nodeAt(i)}><circle r="17" /><text y="6">{i + 1}</text></g>)}
    </svg>
  </div>
  <ol class="unwind-list">
    {ANSWERS.map((a, i) => <li>
      <span class="unwind-n" aria-hidden="true">{i + 1}</span>
      <h3><span class="hl">{a.title}</span></h3>
      <p>{a.text}</p>
      <p class="unwind-status"><span class="status" data-tone={a.status}><Mark tone={tone(a.status)} size={10} />{a.statusText}</span></p>
    </li>)}
  </ol>
  <button type="button" class="unwind-replay" data-replay hidden>Show the loop again</button>
</div>

<style>
  /* The loop is drawn over the answers while they are still hidden, then unwinds up into the line
     they hang from: no empty band before or after the movement. */
  .unwind { position: relative; display: grid; justify-items: center; gap: clamp(20px, 3vw, 32px); }
  .unwind-figure { position: absolute; top: 0; left: 50%; width: min(100%, 1000px); transform: translateX(-50%); pointer-events: none; }
  .unwind-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .unwind-seg { fill: none; stroke: var(--ink); stroke-width: 2.5; stroke-linecap: round; }
  .unwind-node circle { fill: var(--sun); stroke: var(--ink); stroke-width: 2; }
  .unwind-node text { font: 700 17px var(--font); text-anchor: middle; fill: var(--ink); }
  /* The six answers sit under their stops: the line runs from 8 % to 92 % of the figure. */
  .unwind-list { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0 clamp(10px, 1.2vw, 18px); width: min(100%, 1000px); padding: 64px 4% 0; min-height: 260px; }
  .unwind-list li { display: grid; gap: 8px; align-content: start; justify-items: center; text-align: center; }
  .unwind-n { display: none; }
  .unwind-list h3 { font-size: 1.0625rem; line-height: 1.25; }
  .unwind-replay { position: relative; }
  .unwind-list p { font-size: var(--size-small); color: var(--ink-2); }
  .unwind-status { margin-top: 2px; }
  .unwind-replay { min-height: var(--target); padding: 0 14px; border: 1px solid var(--line-strong); border-radius: var(--r-2); background: var(--paper); font-size: var(--size-small); font-weight: 600; color: var(--ink-2); }
  .unwind-replay:hover { border-color: var(--ink); color: var(--ink); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .unwind .unwind-list li { opacity: 0; transform: translateY(8px); transition: opacity 360ms var(--ease), transform 360ms var(--ease); }
    :global(.js) .unwind[data-state='line'] .unwind-list li { opacity: 1; transform: none; }
    :global(.js) .unwind[data-state='line'] .unwind-list li:nth-child(2) { transition-delay: 70ms; }
    :global(.js) .unwind[data-state='line'] .unwind-list li:nth-child(3) { transition-delay: 140ms; }
    :global(.js) .unwind[data-state='line'] .unwind-list li:nth-child(4) { transition-delay: 210ms; }
    :global(.js) .unwind[data-state='line'] .unwind-list li:nth-child(5) { transition-delay: 280ms; }
    :global(.js) .unwind[data-state='line'] .unwind-list li:nth-child(6) { transition-delay: 350ms; }
  }
  :global(.drawn) .unwind .unwind-list li { opacity: 1 !important; transform: none !important; }
  /* Below 1024 px: the line itself, drawn straight down through the six answers. */
  @media (max-width: 63.9375rem) {
    .unwind-figure, .unwind-replay { display: none !important; }
    .unwind-list { position: relative; grid-template-columns: minmax(0, 1fr); gap: 0; max-width: 30rem; padding: 0; min-height: 0; }
    .unwind-list::before { content: ''; position: absolute; left: 50%; top: 15px; bottom: 15px; width: 2px; transform: translateX(-1px); background: var(--ink); }
    .unwind-list li { position: relative; padding: 0 0 28px; }
    .unwind-list li > :not(.unwind-n) { position: relative; background: var(--mist); padding-inline: 8px; }
    .unwind-n { position: relative; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--sun); border: 2px solid var(--ink); font-size: 14px; font-weight: 700; }
  }
</style>

<script>
  /* The loop (as drawn in the problem section) unwinds into a line. Each of the six arcs is sampled
     into points and moved, point by point, onto its straight segment; the nodes ride along. */
  const N = 6, SAMPLES = 28, R = 104, CX = 500, CY = 140, GAP = 7;
  const LINE_Y = 24, X0 = 80, X1 = 920;
  const ease = (t: number) => t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  const arcPoint = (deg: number): [number, number] => [CX + R * Math.cos((deg - 90) * Math.PI / 180), CY + R * Math.sin((deg - 90) * Math.PI / 180)];
  const loopPoints = (i: number) => Array.from({ length: SAMPLES }, (_, k) => arcPoint(i * 60 + GAP + (60 - 2 * GAP) * k / (SAMPLES - 1)));
  const step = (X1 - X0) / N;
  const linePoints = (i: number) => Array.from({ length: SAMPLES }, (_, k): [number, number] => [X0 + step * i + 10 + (step - 20) * k / (SAMPLES - 1), LINE_Y]);
  const loopNode = (i: number) => arcPoint(i * 60 + 30);
  const lineNode = (i: number): [number, number] => [X0 + step * (i + .5), LINE_Y];
  const mix = (a: [number, number], b: [number, number], t: number): [number, number] => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
  for (const root of document.querySelectorAll<HTMLElement>('[data-unwind]')) {
    const segs = [...root.querySelectorAll<SVGPathElement>('[data-seg]')], nodes = [...root.querySelectorAll<SVGGElement>('[data-node]')];
    const replay = root.querySelector<HTMLButtonElement>('[data-replay]');
    const loops = segs.map((_, i) => loopPoints(i)), lines = segs.map((_, i) => linePoints(i));
    const draw = (t: number) => {
      segs.forEach((seg, i) => {
        // Each segment unwinds a little after the one before it: the loop opens at the top and runs out into the line.
        const local = ease(Math.min(1, Math.max(0, (t * 1.5 - i * .1))));
        const pts = loops[i].map((p, k) => mix(p, lines[i][k], local));
        seg.setAttribute('d', 'M' + pts.map(p => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join('L'));
        const n = mix(loopNode(i), lineNode(i), local);
        nodes[i].setAttribute('transform', `translate(${n[0].toFixed(1)} ${n[1].toFixed(1)})`);
      });
    };
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let running = 0;
    const play = () => {
      cancelAnimationFrame(running);
      root.dataset.state = 'loop'; draw(0);
      const start = performance.now(), DURATION = 1800;
      const frame = (now: number) => {
        const t = Math.min(1, (now - start) / DURATION);
        draw(t);
        if (t < 1) running = requestAnimationFrame(frame);
        else { root.dataset.state = 'line'; if (replay) replay.hidden = false; }
      };
      running = requestAnimationFrame(frame);
    };
    const narrow = matchMedia('(max-width: 63.9375rem)');
    if (still || narrow.matches || !('IntersectionObserver' in window)) { draw(1); root.dataset.state = 'line'; continue; }
    draw(0); root.dataset.state = 'loop';
    const seen = new IntersectionObserver(entries => {
      if (entries.some(e => e.isIntersecting)) { seen.disconnect(); setTimeout(play, 250); }
    }, { threshold: .55 });
    seen.observe(root.querySelector('[data-svg]')!);
    replay?.addEventListener('click', () => play());
  }
</script>

---
/* The preview's variant switcher (Concept A8): a small panel, folded by default, that exists only
   in preview builds (PUBLIC_PREVIEW_VARIANTS=1; the layout renders it only then, and a test proves
   a production build carries none of it). It sets the axes from src/lib/variants.ts on <html>
   and writes them to the address, so the founder can share exact combinations. */
import { AXES, DEFAULTS } from '../lib/variants';
---
<details class="variants" data-variants-panel>
  <summary><span>Variants</span></summary>
  <form class="variants-form" data-variants-form>
    {AXES.map(axis => <label><span>{axis.label}</span><select name={axis.id} data-axis={axis.id}>{axis.values.map(([value, label]) => <option value={value} selected={value === DEFAULTS[axis.id]}>{label}</option>)}</select></label>)}
    <p class="variants-note">The first option of each axis is the recommendation. The address carries the choice; copy it to share. A direction opens its own home (<a href="/__preview/directions">all directions</a>).</p>
    <button type="button" data-variants-reset>Back to the recommendation</button>
  </form>
</details>

<script>
  import { AXES, DEFAULTS } from '../lib/variants';
  const root = document.documentElement, form = document.querySelector<HTMLFormElement>('[data-variants-form]');
  const current = () => Object.fromEntries(AXES.map(a => [a.id, root.dataset['v' + a.id[0].toUpperCase() + a.id.slice(1)] ?? DEFAULTS[a.id]]));
  /* The direction axis (A9 comparison) is a page, not a query value: /__preview/home/<key>, or / for
     none. Choosing another one opens that page with the other axes in its address. */
  const page = root.getAttribute('data-v-direction') ?? DEFAULTS.direction;
  const apply = (choice: Record<string, string>) => {
    const url = new URL(location.href);
    for (const axis of AXES) {
      const value = axis.values.some(([v]) => v === choice[axis.id]) ? choice[axis.id] : DEFAULTS[axis.id];
      root.setAttribute(`data-v-${axis.id}`, value);
      if (axis.id === 'direction' || value === DEFAULTS[axis.id]) url.searchParams.delete(axis.id); else url.searchParams.set(axis.id, value);
      const select = form?.querySelector<HTMLSelectElement>(`[data-axis="${axis.id}"]`);
      if (select) select.value = value;
    }
    const direction = root.getAttribute('data-v-direction') ?? DEFAULTS.direction;
    if (direction !== page) { location.assign(`${direction === 'none' ? '/' : `/__preview/home/${direction}`}${url.search}`); return; }
    history.replaceState(null, '', url);
    dispatchEvent(new CustomEvent('variants:change', { detail: current() }));
  };
  apply(current());
  form?.addEventListener('change', () => apply(Object.fromEntries(AXES.map(a => [a.id, form.querySelector<HTMLSelectElement>(`[data-axis="${a.id}"]`)!.value]))));
  form?.querySelector('[data-variants-reset]')?.addEventListener('click', () => apply({ ...DEFAULTS, direction: page }));
</script>

<style>
  .variants { position: fixed; right: 12px; bottom: 12px; z-index: 90; max-width: min(320px, calc(100vw - 24px)); font-family: var(--text); font-size: var(--size-micro); color: var(--ink); }
  .variants summary { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border: 1px solid var(--line-ink); border-radius: var(--pill); background: var(--surface); font-weight: 650; cursor: pointer; list-style: none; box-shadow: var(--shadow-float); }
  .variants summary::-webkit-details-marker { display: none; }
  .variants[open] summary { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
  .variants-form { display: grid; gap: 8px; padding: 12px; border: 1px solid var(--line-ink); border-radius: var(--r-3) 0 var(--r-3) var(--r-3); background: var(--surface); box-shadow: var(--shadow-float); }
  .variants label { display: grid; gap: 2px; font-weight: 600; }
  .variants select { min-height: 32px; padding: 0 8px; border: 1px solid var(--line-strong); border-radius: var(--r-1); background: var(--paper); font: inherit; color: inherit; }
  .variants-note { color: var(--ink-2); font-weight: 400; }
  .variants button { min-height: 32px; padding: 0 10px; border: 1px solid var(--line-strong); border-radius: var(--r-1); background: var(--paper); font: inherit; font-weight: 600; color: inherit; cursor: pointer; }
  @media print { .variants { display: none; } }
</style>

---
/* Demonstration 3: from repeated searches to quiet continuity, as the product actually behaves.
   A watched direction is checked once a day while it is active (one check per direction per
   day); new listings are marked when the person comes back; pausing stops the checks. There is
   no email or push yet, so nothing in this picture arrives on its own. The week and its listings
   are an example. */
const DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const FOUND: Record<number, string[]> = { 1: ['Backend Engineer, Payments', 'Platform Engineer (Go)'], 3: ['Senior Backend Engineer, Search'], 5: ['Staff Engineer, Data Platform'] };
---
<div class="watch" data-watch>
  <div class="watch-controls">
    <fieldset class="watch-visit">
      <legend>Your last visit</legend>
      {[0, 2, 4].map((day, index) => <label><input type="radio" name="watch-visit" value={day} checked={index === 1} /><span>{['Monday', 'Wednesday', 'Friday'][index]}</span></label>)}
    </fieldset>
    <label class="watch-pause"><input type="checkbox" data-pause /><span>Pause from Thursday</span></label>
  </div>
  <ol class="watch-week" aria-label="One example week of a watched direction" data-week>
    {DAYS.map((name, day) => <li data-day={day} data-found={(FOUND[day] ?? []).length} data-since={day > 2 ? '' : undefined} data-visit={day === 2 ? '' : undefined}>
      <span class="watch-day">{name}{day === 6 && <small>today</small>}</span>
      <span class="watch-check" data-check><span class="sr" data-check-word>checked</span></span>
      <span class="watch-new">{(FOUND[day] ?? []).map(() => <i />)}</span>
    </li>)}
  </ol>
  <div class="watch-result" aria-live="polite" data-result>
    <p class="watch-count"><b data-count>2</b> <span data-count-word>new since your last visit on Wednesday</span></p>
    <ul class="watch-list" data-list>
      {Object.entries(FOUND).map(([day, titles]) => titles.map(title => <li data-from={day} hidden={Number(day) <= 2}><span class="watch-tag">New</span>{title}</li>))}
    </ul>
    <p class="watch-paused" data-paused hidden>Paused on Thursday: no checks from then on, so nothing new was found. Resume any time.</p>
  </div>
  <p class="watch-caption">An example week. Each square is the day’s check; each yellow mark is a new listing it found.</p>
</div>

<style>
  .watch { display: grid; gap: 18px; padding: clamp(20px, 3vw, 32px); border: 1px solid var(--line-strong); border-radius: var(--r-3); background: var(--paper); }
  .watch-controls { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 12px 24px; }
  .watch-visit { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; border: 0; }
  .watch-visit legend { width: 100%; margin-bottom: 6px; font-size: var(--size-micro); font-weight: 650; color: var(--ink-3); }
  .watch-visit label { position: relative; }
  .watch-visit input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .watch-visit span { display: inline-flex; align-items: center; min-height: var(--target); padding: 0 14px; border: 1px solid var(--line-strong); border-radius: var(--r-2); font-size: var(--size-small); font-weight: 600; color: var(--ink-2); }
  .watch-visit input:checked + span { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .watch-visit input:focus-visible + span { outline: 2px solid var(--cobalt); outline-offset: 2px; }
  .watch-pause { display: inline-flex; align-items: center; gap: 10px; min-height: var(--target); font-size: var(--size-small); font-weight: 600; cursor: pointer; }
  .watch-pause input { width: 22px; height: 22px; margin: 0; accent-color: var(--ink); }
  .watch-week { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
  .watch-week li { display: grid; justify-items: center; align-content: start; gap: 8px; padding: 10px 2px 12px; border-radius: var(--r-2); transition: background var(--base); }
  .watch-week li[data-since] { background: var(--mist); }
  .watch-week li[data-visit] { box-shadow: inset 0 0 0 1px var(--line-ink); }
  .watch-day { display: grid; justify-items: center; font-size: var(--size-micro); font-weight: 650; color: var(--ink-2); }
  .watch-day small { font-size: 12px; font-weight: 600; color: var(--cobalt); }
  .watch-check { width: 16px; height: 16px; background: var(--ink); }
  .watch-week li[data-paused] .watch-check { background: none; outline: 1.5px dashed var(--ink-3); outline-offset: -1.5px; }
  .watch-new { display: grid; gap: 4px; min-height: 30px; }
  .watch-new i { width: 14px; height: 14px; background: var(--sun); outline: 1px solid var(--sun-line); outline-offset: -1px; }
  .watch-week li[data-paused] .watch-new i { visibility: hidden; }
  .watch-result { display: grid; gap: 10px; padding-top: 14px; border-top: 2px solid var(--ink); }
  .watch-count { display: flex; align-items: baseline; gap: 10px; font-size: var(--size-small); }
  .watch-count b { font-size: 2.5rem; font-weight: 640; letter-spacing: -.04em; line-height: 1; }
  .watch-list { display: grid; gap: 6px; }
  .watch-list li { display: flex; align-items: center; gap: 10px; font-size: var(--size-small); font-weight: 560; }
  .watch-list li[hidden] { display: none; }
  .watch-tag { padding: 1px 8px; border-radius: var(--r-1); background: var(--sun); font-size: 12px; font-weight: 700; }
  .watch-paused { font-size: var(--size-small); color: var(--ink-2); }
  .watch-caption { font-size: var(--size-micro); color: var(--ink-3); }
</style>

<script>
  const NAMES = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
  for (const demo of document.querySelectorAll<HTMLElement>('[data-watch]')) {
    const days = [...demo.querySelectorAll<HTMLElement>('[data-day]')];
    const pause = demo.querySelector<HTMLInputElement>('[data-pause]');
    const update = () => {
      const visit = Number(demo.querySelector<HTMLInputElement>('input[name="watch-visit"]:checked')?.value ?? 2);
      const paused = !!pause?.checked, pausedFrom = 3;
      let count = 0;
      for (const li of days) {
        const day = Number(li.dataset.day), off = paused && day >= pausedFrom;
        li.toggleAttribute('data-since', day > visit);
        li.toggleAttribute('data-visit', day === visit);
        li.toggleAttribute('data-paused', off);
        const word = li.querySelector('[data-check-word]');
        if (word) word.textContent = off ? 'not checked, paused' : 'checked';
        if (day > visit && !off) count += Number(li.dataset.found);
      }
      demo.querySelectorAll<HTMLElement>('[data-from]').forEach(item => { const day = Number(item.dataset.from); item.hidden = !(day > visit && !(paused && day >= pausedFrom)); });
      const c = demo.querySelector('[data-count]'), w = demo.querySelector('[data-count-word]');
      if (c) c.textContent = String(count);
      if (w) w.textContent = `new since your last visit on ${NAMES[visit]}`;
      const note = demo.querySelector<HTMLElement>('[data-paused]');
      if (note) note.hidden = !paused;
    };
    demo.addEventListener('change', update);
    update();
  }
</script>

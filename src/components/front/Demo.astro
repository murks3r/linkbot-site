---
/* The demo page (/demo), as the landing page plan has it (docs/front/landing-plan.md, ST-D3): the recorded walkthrough,
   with the role switch "As a buyer" / "As a supplier" on top (src/front/sides.ts). The buyer's side is the whole path
   in six steps and keeping looking (Replay.astro, anchors #step-1 to #step-6 and #keep-looking); the supplier's side is
   the one supplier step that is recorded, its yes. A switch, off by default, mounts the widget for a configured demo
   space instead of opening on the recording (src/demo/space.ts: PUBLIC_DEMO_LIVE with an embed.js and a publishable
   key; never production): then the page opens with "Try it" and the widget in describe mode, one per side under the
   same role switch, and the recording follows. While the switch is off the page says nothing about a test space and
   offers no "Try it", only that the widget waits for a demo space (tests/demo.test.mjs). The widget asks the Space
   API on the origin embed.js came from, takes the page's language and shows the page's notice above its confirm
   button (Connect, docs/reference/embed.md). Words: src/front/demo-copy.ts and the landing page's switch and "Try it"
   (rows in docs/truth-check.md), in the reader's language through src/front/copy.ts. */
import { FRONT } from '../../front/copy';
import { buildSpace } from '../../demo/build-space';
import { SHOTS, picture } from '../../front/shots';
import Replay from './Replay.astro';
import Icon from '../Icon.astro';
import { pathFor, type Catalogue, type Lang } from '../../i18n';
import '../../front/theme.css';
import '../../front/demo.css';
interface Props { lang: Lang; t: Catalogue }
const { lang, t } = Astro.props;
const { demo: D, landing: L } = FRONT[lang];
const space = buildSpace();
/** The widget's side for each role (Connect, docs/reference/embed.md: data-side). */
const WIDGET_SIDE = { buyer: 'seeking', supplier: 'offer' } as const;
/** The supplier's recorded step: step 4, its second picture (src/front/shots.ts). */
const SUPPLIER = { step: 3, shot: 1 } as const;
const supplierStep = D.steps.items[SUPPLIER.step];
const position = (n: number) => D.replay.position.replace('{n}', String(n)).replace('{total}', String(D.steps.items.length));
---
<section class="fd-hero" aria-labelledby="hero-title">
  <div class="wrap fd-hero-inner">
    <p class="eyebrow">{D.hero.eyebrow}</p>
    <h1 id="hero-title"><span class="fd-line">{D.hero.h1[0]}</span> <span class="fd-line">{D.hero.h1[1]}</span></h1>
    <p class="lede fd-lede">{D.hero.lede}</p>
    {space && <p class="fd-test" role="note">{D.test}</p>}
    {space && <p><a class="btn btn-primary" href="#try">{L.opening.try}<Icon name="arrow" /></a></p>}
  </div>
</section>

{space && <section class="fp-section" id="try" aria-labelledby="try-title">
  <div class="wrap">
    <div class="fp-head"><h2 id="try-title">{L.opening.try}</h2><p>{D.live.p}</p></div>
    <script is:inline src={space.script} async></script>
    <div class="fd-stage" data-sides>
      <div class="fp-switch" role="group" aria-label={L.stage.roles} hidden data-switch>
        {(['buyer', 'supplier'] as const).map((side, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`try-${side}`} data-show={side}>{L.stage[side]}</button>)}
      </div>
      {(['buyer', 'supplier'] as const).map(side => <section id={`try-${side}`} aria-label={L.stage[side]} data-panel={side}>
        <h3 class="fd-side-title fp-side-title">{L.stage[side]}</h3>
        <div class="fd-widget" data-linkbot={space.key} data-mode="describe" data-side={WIDGET_SIDE[side]} data-locale={lang}>
          <p slot="notice">{D.space.notice}</p>
        </div>
      </section>)}
    </div>
  </div>
</section>}

<section class="fp-section" id="path" aria-labelledby="path-title">
  <div class="wrap">
    <div class="fp-head"><h2 id="path-title">{D.steps.h2}</h2><p>{D.replay.lede}</p></div>
    <div class="fd-stage" data-sides>
      <div class="fp-switch" role="group" aria-label={L.stage.roles} hidden data-switch>
        {(['buyer', 'supplier'] as const).map((side, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`path-${side}`} data-show={side}>{L.stage[side]}</button>)}
      </div>
      <section id="path-buyer" aria-label={L.stage.buyer} data-panel="buyer">
        <h3 class="fd-side-title fp-side-title">{L.stage.buyer}</h3>
        <Replay lang={lang} />
      </section>
      <section id="path-supplier" aria-label={L.stage.supplier} data-panel="supplier">
        <h3 class="fd-side-title fp-side-title">{L.stage.supplier}</h3>
        <div class="fr-step fr-aside" data-count="1">
          <div class="fr-screens">
            <img {...picture(lang, SHOTS[SUPPLIER.step][SUPPLIER.shot], 1)} alt={D.replay.screens[SUPPLIER.step][SUPPLIER.shot]} width="640" height="880" loading="lazy" decoding="async" />
          </div>
          <div class="fr-caption">
            <p class="fr-label">{D.replay.label}</p>
            <p class="fd-n">{position(SUPPLIER.step + 1)}</p>
            <h4>{supplierStep.name}</h4>
            <p class="fd-who"><span class="eyebrow">{D.steps.who}</span>{supplierStep.who}</p>
            <p class="fr-text">{supplierStep.text}</p>
            <p class="fr-text">{L.stage.supplierNote}</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</section>

<section class="fp-section" id="space">
  <div class="wrap">
    <div class="fp-head">{!space && <p>{D.space.off}</p>}<p>{t.site.synthetic}</p><p><a class="link" href={pathFor(lang, '/request-a-demo')}>{t.requestDemo.eyebrow}<Icon name="arrow" /></a></p></div>
  </div>
</section>

<script>
  import { sides } from '../../front/sides';
  document.querySelectorAll<HTMLElement>('[data-sides]').forEach(sides);
</script>

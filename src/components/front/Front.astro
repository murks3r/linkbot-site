---
/* The home (redesign pass, GEO-188, 2026-10-24): B as the hero, with the Venn as the signature object beside the
   field; the pack's questions when a line is asked; section A, what happens after confirm (sketch 1, with A's
   verdict sequence folded beneath it); why it asks instead of guessing; who sees what (a teaser for its own page); the platform and the pack;
   where it stands. Words: src/front/home-copy.ts, b-copy.ts, b-pack.ts, a-copy.ts, a-match.ts, and the stage names of
   c-stages.ts (rows in docs/truth-check.md), in the reader's language through src/front/copy.ts. */
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Reach from './Reach.astro';
import Question from './Question.astro';
import Ledger from './Ledger.astro';
import Story from './Story.astro';
import Venn from './Venn.astro';
import Eye from './Eye.astro';
import { FRONT } from '../../front/copy';
import { pathFor, type Catalogue, type Lang } from '../../i18n';
import '../../front/theme.css';
import '../../front/home.css';
interface Props { lang: Lang; t: Catalogue }
const { lang, t } = Astro.props;
const { home: HOME, b: B, criteria: CRITERIA, words: WORDS, stages: STAGES, a: A, rows: ROWS, locale, decimal } = FRONT[lang];
const to = (path: string) => pathFor(lang, path);
const required = CRITERIA.filter(c => c.required), more = CRITERIA.filter(c => !c.required);
const words = JSON.stringify({ ambiguous: WORDS.ambiguous, other: WORDS.other, any: WORDS.any, min: B.ask.storedMin, max: B.ask.storedMax, storedSource: B.ask.storedSource, storedUnknown: B.ask.storedUnknown, storedOther: B.ask.storedOther, locale, decimal });
---
<Base lang={lang} t={t} title={HOME.meta.title} description={HOME.meta.description} path="/" front>

  <!-- 1 · The opening: the invitation and the line on the left, the Venn on the right. -->
  <section class="hm-hero" aria-labelledby="hero-title">
    <div class="wrap hm-hero-grid">
      <div class="hm-hero-copy">
        <p class="eyebrow">{B.hero.eyebrow}</p>
        <h1 id="hero-title"><span class="hm-line">{B.hero.h1[0]}</span> <span class="hm-line">{B.hero.h1[1]}</span></h1>
        <p class="lede hm-lede">{B.hero.lede}</p>
        <p class="hm-demo"><a class="link" href={to('/demo')}>{B.hero.demo}<Icon name="arrow" /></a></p>
      </div>
    <!-- method="dialog": outside a dialog a submit goes nowhere, so without scripts nothing typed here leaves the page
         either; with them, src/front/ask.ts handles the submit event, which still fires. -->
    <form class="ask hm-ask" method="dialog" data-ask data-words={words} novalidate>
      <label class="ask-label" for="ask-line">{B.ask.label}</label>
      <div class="ask-field">
        <input id="ask-line" class="ask-input" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go" maxlength="200" placeholder={B.ask.placeholder} data-ask-line aria-describedby="ask-privacy" />
        <Reach label={B.ask.button}><span class="ask-icon ask-icon-arrow"><Icon name="arrow" /></span><span class="ask-icon ask-icon-match"><Icon name="menu" /></span></Reach>
      </div>
      <p id="ask-privacy" class="ask-privacy">{B.ask.privacy}</p>
      <p class="ask-empty" role="status">{B.ask.empty}</p>
      <div class="ask-result" data-ask-result>
        <section class="ask-yours" data-yours hidden aria-labelledby="yours-title">
          <h2 id="yours-title" class="eyebrow">{B.ask.yoursLabel}</h2>
          <blockquote class="ask-quote" data-yours-text></blockquote>
          <p class="ask-note">{B.ask.yoursNote}</p>
        </section>
        <div class="ask-grid">
          <section class="ask-asks" aria-labelledby="asks-title">
            <h2 id="asks-title">{B.ask.asksTitle}</h2>
            <p class="ask-pack">{B.ask.packNote}</p>
            <p class="eyebrow ask-group">{WORDS.essentials}</p>
            <ol class="ask-list">{required.map((c, i) => <Question c={c} n={i + 1} words={WORDS} ask={B.ask} />)}</ol>
            <details class="ask-more">
              <summary><span>{WORDS.details}</span><Icon name="down" /></summary>
              <ol class="ask-list" start={required.length + 1}>{more.map((c, i) => <Question c={c} n={required.length + i + 1} words={WORDS} ask={B.ask} />)}</ol>
            </details>
          </section>
          <aside class="ask-stored" aria-labelledby="stored-title" data-stored>
            <h2 id="stored-title">{B.ask.storedTitle}</h2>
            <p class="ask-stored-empty" data-stored-empty>{B.ask.storedEmpty}</p>
            <dl class="ask-stored-list" data-stored-list aria-live="polite"></dl>
            <p class="ask-end">{B.ask.end}</p>
            <p><button type="button" class="btn btn-secondary" data-ask-reset>{B.ask.reset}</button></p>
          </aside>
        </div>
      </div>
    </form>
    <!-- After the form in the source, as on a phone, where the Venn stands below the line: the page then never paints the
         Venn first and pushes it down when the form arrives. On wide screens home.css places it on the right. -->
    <div class="hm-hero-venn"><Venn study={1} rows={ROWS} verdicts={A.ledger.verdicts} label={HOME.venn.label} need={HOME.venn.need} offer={HOME.venn.offer} caption={HOME.venn.caption} pause={HOME.venn.pause} /></div>
    </div>
  </section>

  <!-- 2 · What happens after confirm: sketch 1, one Venn for the whole story; the same pair in full, folded, beneath it. -->
  <section class="fp-section" id="match" aria-labelledby="match-title">
    <div class="wrap">
      <div class="fp-head"><p class="eyebrow">{HOME.ledger.eyebrow}</p><h2 id="match-title">{HOME.ledger.h2}</h2><p>{HOME.ledger.lede}</p></div>
      <Story story={HOME.story} rows={ROWS} />
      <details class="ask-more hm-pair">
        <summary><span>{HOME.ledger.pair}</span><Icon name="down" /></summary>
        <Ledger a={A} rows={ROWS} />
      </details>
    </div>
  </section>

  <!-- 3 · Why it asks instead of guessing. -->
  <section class="fp-section" id="why" aria-labelledby="why-title">
    <div class="wrap">
      <div class="fp-head"><h2 id="why-title">{B.why.h2}</h2></div>
      <ul class="hm-four">{B.why.items.map(item => <li><h3>{item.h3}</h3><p>{item.p}</p></li>)}</ul>
      <p class="hm-more"><a class="link" href={`${to('/how-it-works')}#describe`}>{B.why.link}<Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- 4 · Who sees what: the question's own page. -->
  <section class="fp-section" id="sees" aria-labelledby="sees-title">
    <div class="wrap hm-sees">
      <div class="fp-head hm-sees-head"><p class="eyebrow">{HOME.sees.eyebrow}</p><h2 id="sees-title">{HOME.sees.h2}</h2><p>{HOME.sees.p}</p><p class="hm-more"><a class="link" href={to('/who-sees-what')}>{HOME.sees.link}<Icon name="arrow" /></a></p></div>
      <ol class="hm-stages" aria-hidden="true">
        {STAGES.map(stage => <li><Eye eyes={stage.eyes} open={stage.open} /><span>{stage.name}</span></li>)}
      </ol>
    </div>
  </section>

  <!-- 5 · For platforms and for verticals. -->
  <section class="fp-section" id="for" aria-labelledby="platforms-title">
    <div class="wrap hm-two">
      <div class="hm-card"><h2 id="platforms-title">{B.platforms.h2}</h2><p>{B.platforms.p}</p><a class="link" href={to('/for-platforms')}>{B.platforms.link}<Icon name="arrow" /></a></div>
      <div class="hm-card"><h2 id="verticals-title">{B.verticals.h2}</h2><p>{B.verticals.p}</p><a class="link" href={to('/verticals')}>{B.verticals.link}<Icon name="arrow" /></a></div>
    </div>
  </section>

  <!-- 6 · Where it stands. -->
  <section class="fp-section hm-state" id="state" aria-labelledby="state-title">
    <div class="wrap"><div class="fp-head"><h2 id="state-title">{B.state.h2}</h2><p>{t.site.synthetic}</p><p>{B.state.p}</p></div></div>
  </section>
</Base>

<script>import '../../front/ask';</script>

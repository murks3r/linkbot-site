---
/* The home (/) of the developer site (docs.sensalio.de, agreed with Verticals 2026-11-11): one headline with the problem
   and the promise, its sub-line (src/front/hero.ts picks today's or the full one), the page's one button to the docs'
   5-minute quickstart with a quiet link to the docs beside it, and directly under them the "both say yes" demo
   (Trial.astro) as a small proof; then the shortest embed, and the bottom with a quiet link to the marketing site
   (owner's page rules of 2026-10-29: one headline, one line, one button). Words: src/front/landing-copy.ts in the
   reader's language through src/front/copy.ts. */
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Trial from './Trial.astro';
import { FRONT } from '../../front/copy';
import { SUBLINE } from '../../front/hero';
import { EMBED_SNIPPET } from '../../lib/connect-docs';
import { DOCS_BASE, LINKED_SECTIONS } from '../../lib/open-core-docs';
import { marketingHome } from '../../lib/marketing';
import { statusDate } from '../../i18n/status-date';
import { pathFor, type Catalogue, type Lang } from '../../i18n';
import '../../front/theme.css';
import '../../front/landing.css';
import '../../front/trial.css';
interface Props { lang: Lang; t: Catalogue }
const { lang, t } = Astro.props;
const { landing: L } = FRONT[lang];
const to = (path: string) => pathFor(lang, path);
/* The docs are in English only: their links say so to a reader of another language. */
const docsLang = lang === 'en' ? undefined : 'en';
const quickstart = LINKED_SECTIONS.find(section => section.id === 'quickstart')!.href;
---
<Base lang={lang} t={t} title={L.meta.title} description={L.meta.description} path="/" front>

  <!-- 1 · One headline, its sub-line, the one button, and directly under it the demo. -->
  <section class="ln-open" aria-labelledby="open-title">
    <div class="wrap">
      <div class="ln-open-inner">
        <h1 id="open-title">{L.opening.h1}</h1>
        <p class="lede">{L.opening.sub[SUBLINE]}</p>
        <p class="ln-actions ln-start">
          <a class="btn btn-primary" href={quickstart} hreflang={docsLang}>{L.opening.start}<Icon name="arrow" /></a>
          <a class="link ln-quiet" href={DOCS_BASE} hreflang={docsLang}>{L.opening.docs}</a>
        </p>
      </div>
      <Trial T={L.trial} />
    </div>
  </section>

  <!-- 2 · The shortest embed, verbatim from Connect (src/lib/connect-docs.ts). -->
  <section class="fp-section" id="embed" aria-labelledby="embed-title">
    <div class="wrap ln-platforms">
      <div class="fp-head"><h2 id="embed-title">{L.embed.h2}</h2><p>{L.embed.p}</p></div>
      <div class="ln-snippet">
        <pre class="fp-code" translate="no"><code>{EMBED_SNIPPET}</code></pre>
        <p class="ln-snippet-head"><span>{L.embed.hosted}</span><span class="ln-label" data-state="soon">{L.labels.soon}</span></p>
      </div>
      <p class="ln-actions"><a class="link" href={to('/developers')}>{L.embed.developers}<Icon name="arrow" /></a><a class="link" href={DOCS_BASE} hreflang={docsLang}>{L.embed.docs}</a></p>
    </div>
  </section>

  <!-- 3 · The bottom: one quiet link to the marketing site, the fictional-data line with the date of the last check. -->
  <section class="fp-section ln-bottom" id="about" aria-labelledby="about-title">
    <div class="wrap"><div class="ln-bottom-inner">
      <h2 id="about-title">{L.bottom.h2}</h2>
      <p><a class="link" href={marketingHome(lang)}>{L.bottom.button}<Icon name="arrow" /></a></p>
      <p class="ln-small">{L.bottom.line.replace('{date}', statusDate(lang))} <a href={to('/status')}>{L.bottom.status}</a></p>
    </div></div>
  </section>
</Base>

<script>
  import { mount } from '../../front/trial';
  document.querySelectorAll<HTMLElement>('[data-trial]').forEach(mount);
</script>

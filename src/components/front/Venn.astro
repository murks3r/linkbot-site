---
/* The Venn: the site's signature object (brief of 2026-10-24), in two dimensions at the highest craft the page can
   carry: exact geometry, soft radial shading on each disc, a lens that forms where they overlap and brightens with
   each criterion that meets. Inline SVG, no library, no WebGL and so no fallback image: under reduced motion, without
   scripts, or before the script runs, the final frame stands. The marks are the four verdicts (solid meets, split
   partly, crossed conflicts, dashed unknown); the HTML list beside the figure names them and always stands complete,
   so the motion never takes text away from a reader. Nothing in the layout moves: the figure's box is fixed by its
   viewBox. The values are the synthetic pair of src/front/a-match.ts; the caption says so.

   Motion (third pass, GEO-188): it runs by itself and loops, calmly and without a jump: the two intents approach, the
   lens forms, the criteria settle one by one, rest; then the marks fade, the discs part as slowly as they came, and
   the next round begins from the same frame the first one did. It pauses while the figure is off-screen or the tab is
   hidden. A loop that runs for longer than five seconds needs a way to stop it (WCAG 2.2.2, level A), so one small
   control pauses it and shows the final frame; it starts nothing, and there is no "play again". ?venn=2 shows the
   second study, for comparison only. */
import Icon from '../Icon.astro';
import type { Row, Verdict } from '../../front/a-match';
interface Props { study?: 1 | 2; rows: Row[]; verdicts: Record<Verdict, string>; label: string; need: string; offer: string; caption: string; pause: string }
const { study = 1, verdicts, label, need, offer, caption, pause } = Astro.props;
const rows = Astro.props.rows.slice(0, 9);
/* The geometry: discs of r 150 whose centres end 160 apart; the lens is the intersection; nine marks sit in a 3 × 3 grid
   at its centre. Study 1 starts the discs 400 apart. */
const R = 150, CX = 280, CY = 196, D = 160, L = CX - D / 2, Rr = CX + D / 2;
const grid = (i: number) => ({ x: CX + ((i % 3) - 1) * 30, y: CY + (Math.floor(i / 3) - 1) * 30 });
---
<figure class="venn" data-venn data-study={study} aria-labelledby="venn-cap">
  <svg class="venn-svg" viewBox="0 0 560 392" width="560" height="392" role="img" aria-label={label}>
    <defs>
      <radialGradient id="venn-need" cx="38%" cy="34%" r="80%"><stop offset="0" stop-color="var(--blue)" stop-opacity=".2" /><stop offset=".55" stop-color="var(--blue)" stop-opacity=".09" /><stop offset="1" stop-color="var(--blue)" stop-opacity=".16" /></radialGradient>
      <radialGradient id="venn-offer" cx="62%" cy="34%" r="80%"><stop offset="0" stop-color="var(--ink)" stop-opacity=".12" /><stop offset=".55" stop-color="var(--ink)" stop-opacity=".05" /><stop offset="1" stop-color="var(--ink)" stop-opacity=".1" /></radialGradient>
      <radialGradient id="venn-lens" cx="50%" cy="42%" r="70%"><stop offset="0" stop-color="var(--blue)" stop-opacity=".34" /><stop offset="1" stop-color="var(--blue)" stop-opacity=".12" /></radialGradient>
      <clipPath id="venn-clip-need"><circle data-clip-need cx={L} cy={CY} r={R} /></clipPath>
    </defs>
    <g data-disc="need"><circle cx={L} cy={CY} r={R} fill="url(#venn-need)" stroke="var(--blue)" stroke-opacity=".55" stroke-width="1" /></g>
    <g data-disc="offer"><circle cx={Rr} cy={CY} r={R} fill="url(#venn-offer)" stroke="var(--ink)" stroke-opacity=".45" stroke-width="1" /></g>
    <g clip-path="url(#venn-clip-need)"><circle data-lens cx={Rr} cy={CY} r={R} fill="url(#venn-lens)" style="opacity:1" /></g>
    <g data-marks fill="none" stroke-linecap="round">
      {rows.map((row, i) => { const p = grid(i); return <g data-mark data-verdict={row.verdict} transform={`translate(${p.x} ${p.y})`} style="opacity:1">
        {row.verdict === 'meets' && <rect x="-7" y="-7" width="14" height="14" fill="var(--blue)" />}
        {row.verdict === 'partly' && <><rect x="-7" y="-7" width="14" height="14" stroke="var(--ink)" stroke-width="1.5" /><path d="M7 -7V7H-7Z" fill="var(--ink)" /></>}
        {row.verdict === 'conflicts' && <><rect x="-7" y="-7" width="14" height="14" stroke="var(--orange)" stroke-width="1.5" /><path d="M-3.5 -3.5l7 7M3.5 -3.5l-7 7" stroke="var(--orange)" stroke-width="1.6" /></>}
        {row.verdict === 'unknown' && <rect x="-7" y="-7" width="14" height="14" stroke="var(--ink-3)" stroke-width="1.5" stroke-dasharray="2.6 1.9" />}
      </g>; })}
    </g>
    <g class="venn-labels" font-family="var(--text)" font-size="13" font-weight="700" fill="var(--ink-2)" letter-spacing=".06em">
      <text data-label="need" x={L - R + 4} y={CY + R + 26}>{need.toUpperCase()}</text>
      <text data-label="offer" x={Rr + R - 4} y={CY + R + 26} text-anchor="end">{offer.toUpperCase()}</text>
    </g>
  </svg>
  <ol class="venn-list" aria-label={label}>
    {rows.map((row, i) => <li data-verdict={row.verdict} style={`--i:${i}`}><span class="venn-sq" aria-hidden="true"></span><span>{row.label}</span><small>{verdicts[row.verdict]}</small></li>)}
  </ol>
  <button type="button" class="venn-motion motion-toggle" data-motion-toggle aria-pressed="false" hidden><span class="motion-pause"><Icon name="pause" /></span><span class="motion-play"><Icon name="play" /></span><span class="sr">{pause}</span></button>
  <script is:inline>
    /* Before the first paint: with motion allowed the figure starts at the loop's first frame (study 1: the discs 400
       apart; both: no marks yet, the lens unlit), so the page never shows the final frame and then takes it back. */
    (function () {
      var f = document.currentScript.closest('[data-venn]');
      if (!f || !matchMedia('(prefers-reduced-motion: no-preference)').matches || !('IntersectionObserver' in window)) return;
      var q = new URLSearchParams(location.search).get('venn'), study = q === '2' ? 2 : q === '1' ? 1 : f.getAttribute('data-study') === '2' ? 2 : 1;
      f.setAttribute('data-study', String(study)); f.setAttribute('data-armed', '');
      f.querySelectorAll('[data-mark]').forEach(function (m) { m.style.opacity = '0'; });
      f.querySelector('[data-lens]').style.opacity = '.25';
      if (study === 1) {
        var nx = 80, ox = 480; /* the centres 400 apart around x 280 */
        f.querySelector('[data-disc="need"]').setAttribute('transform', 'translate(' + (nx - 200) + ' 0)');
        f.querySelector('[data-disc="offer"]').setAttribute('transform', 'translate(' + (ox - 360) + ' 0)');
        f.querySelector('[data-clip-need]').setAttribute('cx', String(nx)); f.querySelector('[data-lens]').setAttribute('cx', String(ox));
        f.querySelector('[data-label="need"]').setAttribute('x', String(nx - 146)); f.querySelector('[data-label="offer"]').setAttribute('x', String(ox + 146));
      }
    })();
  </script>
  <figcaption id="venn-cap" class="venn-cap">{caption}</figcaption>
</figure>

<style>
  .venn { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px 16px; align-items: center; min-width: 0; max-width: 34rem; }
  .venn-svg, .venn-list { grid-column: 1 / -1; }
  .venn-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .venn-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px 14px; width: 100%; font-size: var(--size-small); line-height: 1.35; }
  .venn-list li { display: grid; grid-template-columns: 14px minmax(0, 1fr); gap: 2px 8px; align-items: center; color: var(--ink); }
  .venn-list small { grid-column: 2; font-size: var(--size-caption); color: var(--ink-3); }
  .venn-list li[data-verdict='conflicts'] small { color: var(--orange-ink); }
  .venn-sq { width: 12px; height: 12px; border: 1.5px solid var(--ink); }
  .venn-list li[data-verdict='meets'] .venn-sq { background: var(--blue); border-color: var(--blue); }
  .venn-list li[data-verdict='partly'] .venn-sq { background: linear-gradient(135deg, transparent 50%, var(--ink) 50%); }
  .venn-list li[data-verdict='conflicts'] .venn-sq { border-color: var(--orange); background: linear-gradient(45deg, transparent 44%, var(--orange) 44% 56%, transparent 56%), linear-gradient(-45deg, transparent 44%, var(--orange) 44% 56%, transparent 56%); }
  .venn-list li[data-verdict='unknown'] .venn-sq { border-style: dashed; border-color: var(--ink-3); }
  .venn-cap { grid-column: 1; grid-row: 3; font-size: var(--size-caption); font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3); }
  .venn-motion { grid-column: 2; grid-row: 3; }
  @media (max-width: 36rem) { .venn-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

<script>
  /* The loop (src/front/loop.ts runs the clock and the control). Study 1,
     "approach" (11 s): the discs 400 apart come together (0.4–2.0 s, ease in and out), the nine marks settle into the
     lens 220 ms apart (ease-out back), the lens brightens with each meets; rest until 8.2 s; the marks fade and the lens
     dims (8.2–8.9 s), the discs part (8.5–10.4 s); apart until the round ends, which is the frame it began with. Study 2,
     "criteria travel" (10.6 s): the discs rest overlapped; per criterion the mark travels from the need's far side into
     the lens (520 ms apart) and settles; rest until 8.8 s; the marks fade (8.8–9.6 s); the empty lens until the round
     ends. */
  import { loop, easeOutQuint, easeInOutCubic, easeOutBack, clamp01 } from '../../front/loop';
  const R = 150, CX = 280, CY = 196, D = 160, L = CX - D / 2, Rr = CX + D / 2;
  const STUDY = {
    1: { round: 11000, rest: 6000 },
    2: { round: 10600, rest: 7000 },
  } as const;

  for (const venn of document.querySelectorAll<HTMLElement>('[data-venn][data-armed]')) {
    const study = venn.dataset.study === '2' ? 2 : 1;
    const { round, rest: restAt } = STUDY[study];
    const needDisc = venn.querySelector<SVGGElement>('[data-disc="need"]')!, offerDisc = venn.querySelector<SVGGElement>('[data-disc="offer"]')!;
    const clip = venn.querySelector<SVGCircleElement>('[data-clip-need]')!, lens = venn.querySelector<SVGCircleElement>('[data-lens]')!;
    const marks = [...venn.querySelectorAll<SVGGElement>('[data-mark]')];
    const labelNeed = venn.querySelector<SVGTextElement>('[data-label="need"]')!, labelOffer = venn.querySelector<SVGTextElement>('[data-label="offer"]')!;
    const toggle = venn.querySelector<HTMLButtonElement>('[data-motion-toggle]')!;
    const home = marks.map((_, i) => ({ x: CX + ((i % 3) - 1) * 30, y: CY + (Math.floor(i / 3) - 1) * 30 }));
    const meets = marks.map(m => m.dataset.verdict === 'meets'), lit = meets.filter(Boolean).length;

    const place = (gap: number) => { // the discs' centres, gap apart
      const nx = CX - gap / 2, ox = CX + gap / 2;
      needDisc.setAttribute('transform', `translate(${(nx - L).toFixed(2)} 0)`); offerDisc.setAttribute('transform', `translate(${(ox - Rr).toFixed(2)} 0)`);
      clip.setAttribute('cx', nx.toFixed(2)); lens.setAttribute('cx', ox.toFixed(2));
      labelNeed.setAttribute('x', (nx - R + 4).toFixed(2)); labelOffer.setAttribute('x', (ox + R - 4).toFixed(2));
    };
    const glow = (v: number) => { lens.style.opacity = (.25 + .75 * clamp01(v)).toFixed(3); };
    const setMark = (i: number, x: number, y: number, scale: number, opacity: number) => { marks[i].setAttribute('transform', `translate(${x.toFixed(2)} ${y.toFixed(2)}) scale(${scale.toFixed(3)})`); marks[i].style.opacity = clamp01(opacity).toFixed(3); };

    const frame1 = (ms: number) => {
      const out = easeInOutCubic(clamp01((ms - 8200) / 700)); // the marks' fade at the round's end
      const gap = ms < 8500 ? 400 - 240 * easeInOutCubic(clamp01((ms - 400) / 1600)) : D + 240 * easeInOutCubic(clamp01((ms - 8500) / 1900));
      place(gap);
      let sum = 0;
      marks.forEach((_, i) => {
        const p = clamp01((ms - 2100 - i * 220) / 560);
        const s = p === 0 ? 0 : (.6 + .4 * easeOutBack(p)) * (1 - .15 * out);
        setMark(i, home[i].x, home[i].y + (1 - easeOutQuint(p)) * 10, s, p * (1 - out));
        if (meets[i]) sum += p;
      });
      glow((sum / lit) * (1 - out));
    };
    const frame2 = (ms: number) => {
      place(D);
      const out = easeInOutCubic(clamp01((ms - 8800) / 800));
      let sum = 0;
      marks.forEach((_, i) => {
        const t0 = 400 + i * 520, p = clamp01((ms - t0) / 420), q = clamp01((ms - t0 - 420) / 220), e = easeInOutCubic(p);
        const x = p < 1 ? (L - R + 22) + (home[i].x - (L - R + 22)) * e : home[i].x;
        const y = p < 1 ? CY - 60 + (home[i].y - (CY - 60)) * e : home[i].y;
        const s = (p < 1 ? .55 + .45 * e : .9 + .1 * easeOutBack(q)) * (1 - .15 * out);
        setMark(i, x, y, s, (p === 0 ? 0 : 1) * (1 - out));
        if (p >= 1) sum += meets[i] ? 1 : marks[i].dataset.verdict === 'conflicts' ? -.15 : 0;
      });
      glow((sum / lit) * (1 - out));
    };
    const frame = study === 2 ? frame2 : frame1;

    loop({ figure: venn, toggle, round, restAt, frame });
  }
</script>

---
import ThreeIsland from './ThreeIsland';
---

<section
  id="scene-pinned"
  aria-label="Interactive 3D demonstration: public profile exposure versus private eligibility"
  class="relative h-[280vh] w-full"
  data-pinned-scene
>
  <div class="sticky top-0 flex h-screen w-full items-center justify-center overflow-hidden" data-stage>
    <div class="absolute inset-0 bg-grid" aria-hidden="true" data-poster></div>
    <ThreeIsland client:visible />

    <div class="pointer-events-none absolute right-0 top-0 hidden h-full w-full md:block" aria-hidden="false">
      <div class="container-prose flex h-full items-center">
        <ol class="ml-auto max-w-md space-y-10 text-right" data-reveals>
          <li class="reveal" data-reveal data-at="0.05">
            <p class="text-xs uppercase tracking-[0.18em] text-bone-200/50">01 — Exposed</p>
            <p class="mt-2 font-display text-2xl font-light text-balance text-bone-50">Your career became a public dataset.</p>
          </li>
          <li class="reveal" data-reveal data-at="0.32">
            <p class="text-xs uppercase tracking-[0.18em] text-bone-200/50">02 — Scraped</p>
            <p class="mt-2 font-display text-2xl font-light text-balance text-bone-50">Relevance collapsed into exposure.</p>
          </li>
          <li class="reveal" data-reveal data-at="0.62">
            <p class="text-xs uppercase tracking-[0.18em] text-bone-200/50">03 — Locked</p>
            <p class="mt-2 font-display text-2xl font-light text-balance text-bone-50">Access without permission became normal.</p>
          </li>
          <li class="reveal" data-reveal data-at="0.88">
            <p class="text-xs uppercase tracking-[0.18em] text-signal-400">04 — Matched</p>
            <p class="mt-2 font-display text-2xl font-light text-balance text-signal-400">From public exposure to private eligibility.</p>
          </li>
        </ol>
      </div>
    </div>

    <div class="pointer-events-none absolute bottom-6 left-0 right-0 md:hidden">
      <div class="container-prose">
        <p class="reveal text-sm uppercase tracking-[0.18em] text-bone-200/60" data-reveal data-at="0.05">
          Exposed · Scraped · Locked · Matched
        </p>
      </div>
    </div>
  </div>
</section>

<noscript>
  <div class="container-prose py-12 text-bone-200">
    <p class="text-sm uppercase tracking-[0.18em] text-bone-200/60">Without JavaScript</p>
    <h2 class="mt-3 text-2xl font-display font-light text-balance">Public career profiles are an attack surface. Linkbot returns control.</h2>
    <p class="mt-3 text-pretty text-bone-200/80">
      The interactive 3D demonstration requires JavaScript and WebGL.
      The argument stands without it: visible career data attracts
      uninvited scanning, scraping, and unsolicited contact. Linkbot
      replaces public exposure with permissioned, private eligibility.
    </p>
  </div>
</noscript>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) { entry.target.classList.add('is-visible'); io.unobserve(entry.target); }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
    );
    items.forEach((el) => io.observe(el));
  } else {
    items.forEach((el) => el.classList.add('is-visible'));
  }
</script>

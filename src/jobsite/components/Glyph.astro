---
/** Astro-side renderer for the shared glyph set (see ui/glyphs.ts). */
import { GLYPHS, type GlyphDef, type GlyphName } from '../ui/glyphs.ts';

interface Props {
  name: GlyphName;
  size?: number;
  class?: string;
  title?: string;
}

const { name, size = 12, class: className, title } = Astro.props;
const def: GlyphDef = GLYPHS[name];
const strokeWidth = def.strokeWidth ?? 1.4;
---

<svg
  viewBox={def.viewBox}
  width={size}
  height={size}
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  focusable="false"
>
  {title ? <title>{title}</title> : null}
  {(def.stroke ?? []).map((d) => (
    <path d={d} fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" />
  ))}
  {(def.fill ?? []).map((d) => (
    <path d={d} fill="currentColor" stroke="none" />
  ))}
</svg>

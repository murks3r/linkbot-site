---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/site.css';
import SEO from '../components/SEO.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_LANG, FALLBACK_NOTICE, type Catalogue, type Lang } from '../i18n';
/* lang: the language the reader asked for; t: the words, English when that language has no
   catalogue yet (fallback), and then the page says so in the reader's language. path: the
   language-neutral address of the page ('/developers'); every language gets its own. */
/* front: the home: the body carries data-front for src/front/theme.css. */
/* oneLanguage: a page in English only (the developer docs): indexed, but no alternates and no language switch. */
/* ld: schema.org nodes the page adds to its structured data (src/components/SEO.astro). */
/* draft: a page for the owner's review (src/drafts): never indexed, no alternates, no language switch. */
interface Props { lang: Lang; t: Catalogue; fallback?: boolean; title: string; description: string; path: string; crumbs?: [string, string][]; front?: boolean; draft?: boolean; oneLanguage?: boolean; ld?: Record<string, unknown>[] }
const { lang, t, fallback = false, title, description, path, crumbs, front = false, draft = false, oneLanguage = false, ld } = Astro.props;
const contentLang = fallback ? DEFAULT_LANG : lang;
---
<!doctype html>
<html lang={contentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href="/fonts/schibsted-grotesk/schibsted-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <SEO lang={lang} t={t} title={title} description={description} path={path} crumbs={crumbs} draft={draft} oneLanguage={oneLanguage} ld={ld} />
    <!-- Light only: the widget design spec has no dark values. The colour is --lb-ground, Sensalio's paper (src/styles/tokens.css). -->
    <meta name="theme-color" content="#F6F2E8" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Scripts mark the page so enhancements (the masthead's blur, the table of contents) can take
         over from the complete, static version every page ships with. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body data-front={front ? '' : undefined}>
    <a class="skip" href="#main">{t.site.skip}</a>
    <Masthead lang={lang} t={t} path={path} />
    <main id="main" tabindex="-1">
      {fallback && <p class="fallback" lang={lang} role="note"><span class="wrap">{FALLBACK_NOTICE[lang]}</span></p>}
      <slot />
    </main>
    <Footer lang={lang} t={t} path={path} langs={!draft && !oneLanguage} />
  </body>
</html>
<style is:global>
  main { outline: none; }
  /* A page shown in English for a language that has no translation yet says so first. */
  .fallback { padding: 12px 0; border-bottom: 1px solid var(--lb-line); background: var(--lb-line-quiet); font-size: var(--size-small); font-weight: 600; }
  .fallback .wrap { display: block; }
</style>

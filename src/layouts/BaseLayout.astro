---
import '../styles/global.css';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = 'Linkbot',
  description = 'Linkbot is building a matching layer that platforms embed in their own pages. This site is being rebuilt.',
  canonicalPath = '/',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-ink-950 text-bone-50 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#05060a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SEO title={title} description={description} canonicalPath={canonicalPath} />
  </head>
  <body class="bg-ink-950 text-bone-50 font-sans selection:bg-signal-500/30 selection:text-bone-50">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-ink-800 focus:px-3 focus:py-2 focus:text-bone-50">Skip to content</a>
    <slot />
    <script>
      import { initSmoothScroll } from '../lib/smooth-scroll';
      initSmoothScroll();
    </script>
  </body>
</html>

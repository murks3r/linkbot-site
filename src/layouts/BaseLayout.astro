---
import '../styles/global.css';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = 'Linkbot — Find work. Find talent. Keep your privacy.',
  description = 'Linkbot shows people current job listings with the evidence for every claim, and gives recruiting agencies and companies one place to describe a role and work from evidence. No public profile; nothing is shared until you confirm it.',
  canonicalPath = '/',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-ground text-ink antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#fbf7f0" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO title={title} description={description} canonicalPath={canonicalPath} />
  </head>
  <body class="bg-ground text-ink font-sans selection:bg-you-wash">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-ink focus:px-3 focus:py-2 focus:text-surface">Skip to content</a>
    <slot />
  </body>
</html>

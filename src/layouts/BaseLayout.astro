---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import PreviewNotice from '../components/preview/PreviewNotice.astro';
import { resolveSite } from '../lib/site-origin.mjs';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = 'Linkbot — Private eligibility, not public exposure',
  description = 'Public career profiles have become attack surfaces. Linkbot replaces public exposure with permissioned, private eligibility for the people employers are actually looking for.',
  canonicalPath = '/',
} = Astro.props;

/**
 * Non-production guard. `site` is resolved from the same module astro.config.mjs
 * uses, so the document, the canonical URL and the visible notice all agree.
 *
 * A build is indexable only when it has an explicit, publicly servable
 * `SITE_ORIGIN` and is not a Vercel preview. If `Astro.site` ever disagrees with
 * that decision the build is treated as non-production: failing closed is the
 * only safe direction for a `noindex` guard.
 */
const site = resolveSite(process.env);
const originDisagrees = !Astro.site || Astro.site.origin !== site.origin;
const noindex = !site.indexable || originDisagrees;
---

<!doctype html>
<html lang="en" class="bg-ink-950 text-bone-50 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#05060a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />

    <SEO title={title} description={description} canonicalPath={canonicalPath} />

    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
  </head>
  <body class="bg-ink-950 text-bone-50 font-sans selection:bg-signal-500/30 selection:text-bone-50">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-ink-800 focus:px-3 focus:py-2 focus:text-bone-50">Skip to content</a>
    <PreviewNotice />
    <slot />
    <script>
      import { initSmoothScroll } from '../lib/smooth-scroll';
      initSmoothScroll();
    </script>
  </body>
</html>

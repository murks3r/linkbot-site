---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Ways from '../../components/Ways.astro';
import Stages from '../../components/Stages.astro';
import Status from '../../components/Status.astro';
import { FRONT } from '../../front/copy';
import { langPaths, pathFor, resolve, type Lang } from '../../i18n';
export const getStaticPaths = () => langPaths();
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t, fallback } = resolve(lang);
const d = t.how;
/* The six steps are the demo page's own (src/front/demo-copy.ts), so the two pages cannot tell the path differently. */
const steps = FRONT[lang].demo.steps;
const prose = [d.space, d.pack, d.confirm, d.matching, d.approval, d.yes, d.introduction, d.after, d.languages];
const ids = ['space', 'pack', 'confirm', 'matching', 'approval', 'yes', 'introduction', 'after', 'languages'];
const section = (id: string) => ({ id, ...prose[ids.indexOf(id)] });
---
<Base lang={lang} t={t} fallback={fallback} title={d.title} description={d.description} path="/how-it-works" crumbs={[[t.site.nav.how, '/how-it-works']]}>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{d.eyebrow}</p>
      <h1>{d.h1.map((line, index) => <span class:list={['h1-line', { 'h1-soft': index > 0 }]}>{line}</span>)}</h1>
      <p class="lede">{d.lede}</p>
    </div>
  </section>

  <div class="wrap doc">
    <Toc items={d.toc} label={t.site.toc} />
    <div class="doc-body">
      <section id="blocks" aria-labelledby="blocks-title">
        <h2 id="blocks-title">{d.blocks.title}</h2>
        <p>{d.blocks.lede}</p>
        <dl class="blocks">{d.blocks.items.map(block => <div><dt>{block.name}</dt><dd>{block.text}</dd></div>)}</dl>
      </section>

      <section id="rule" aria-labelledby="rule-title">
        <h2 id="rule-title">{d.rule.title}</h2>
        {d.rule.paras.map(para => <p>{para}</p>)}
      </section>

      <section id="path" aria-labelledby="path-title">
        <h2 id="path-title">{d.path.title}</h2>
        <p>{d.path.lede} <a href={pathFor(lang, '/demo')}>{d.path.link}</a></p>
        <ol class="steps">{steps.items.map(step => <li><h3>{step.name}</h3><p class="who"><span>{steps.who}:</span> {step.who}</p><p>{step.text}</p></li>)}</ol>
      </section>

      {['space', 'pack'].map(id => { const s = section(id); return <section id={s.id} aria-labelledby={`${s.id}-title`}><h2 id={`${s.id}-title`}>{s.title}</h2>{s.paras.map(para => <p>{para}</p>)}</section>; })}

      <section id="describe" aria-labelledby="describe-title">
        <h2 id="describe-title">{d.describe.title}</h2>
        <p>{d.describe.lede}</p>
        <Ways t={t} items={d.describe.items} />
      </section>

      {['confirm', 'matching', 'approval', 'yes', 'introduction', 'after'].map(id => { const s = section(id); return <section id={s.id} aria-labelledby={`${s.id}-title`}><h2 id={`${s.id}-title`}>{s.title}</h2>{s.paras.map(para => <p>{para}</p>)}</section>; })}

      <section id="sees" aria-labelledby="sees-title">
        <h2 id="sees-title">{d.sees.title}</h2>
        <p>{d.sees.lede}</p>
        <Stages stages={d.sees.stages} />
      </section>

      {(() => { const s = section('languages'); return <section id={s.id} aria-labelledby={`${s.id}-title`}><h2 id={`${s.id}-title`}>{s.title}</h2>{s.paras.map(para => <p>{para}</p>)}</section>; })()}

      <section id="today" aria-labelledby="today-title">
        <h2 id="today-title">{d.today.title}</h2>
        <p>{d.today.lede}</p>
        <Status t={t} />
        <p><a class="link" href={pathFor(lang, '/status')}>{t.status.link}</a></p>
        <p class="note">{t.site.synthetic}</p>
      </section>
    </div>
  </div>
</Base>

<style>
  .blocks, .steps { display: grid; gap: 0; border-top: 2px solid var(--lb-ink); }
  .blocks > div { display: grid; gap: 4px; padding: 14px 0; border-bottom: 1px solid var(--lb-line-quiet); }
  .steps li { display: list-item; padding: 14px 0; border-bottom: 1px solid var(--lb-line-quiet); }
  .steps li > p { margin-top: 4px; }
  .blocks dt, .steps h3 { font-weight: 650; color: var(--lb-ink); }
  .steps { list-style: decimal inside; }
  .steps li::marker { font-weight: 650; color: var(--lb-ink); }
  .steps h3 { display: inline; font-size: inherit; }
  .who { font-size: var(--size-small); color: var(--lb-slate); }
  .who span { font-weight: 600; }
</style>

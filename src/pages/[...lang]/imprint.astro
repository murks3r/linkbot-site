---
/* The imprint, as a clearly marked placeholder until the legal notice is confirmed: nothing here
   is invented. */
import Base from '../../layouts/Base.astro';
import { langPaths, resolve, type Lang } from '../../i18n';
export const getStaticPaths = () => langPaths();
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t, fallback } = resolve(lang);
const i = t.imprint;
---
<Base lang={lang} t={t} fallback={fallback} title={i.title} description={i.description} path="/imprint" crumbs={[[t.site.footer.imprint, '/imprint']]}>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{i.eyebrow}</p>
      <h1>{i.h1}</h1>
    </div>
  </section>
  <div class="wrap doc-one">
    <div class="placeholder" role="note" aria-label={i.eyebrow}>
      <p>{i.lede}</p>
    </div>
  </div>
</Base>

---
/* The home. English (the root) renders the front-page preview of this branch (src/components/front/Front.astro, one
   direction per preview branch; GEO-188, 2026-10-24); the four other languages keep the catalogue's home
   (src/components/HomeA8.astro) until the founder has picked a direction and the words are translated. */
import HomeA8 from '../../components/HomeA8.astro';
import Front from '../../components/front/Front.astro';
import { langPaths, resolve, type Lang } from '../../i18n';
export const getStaticPaths = () => langPaths();
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t, fallback } = resolve(lang);
---
{lang === 'en' ? <Front lang={lang} t={t} /> : <HomeA8 lang={lang} t={t} fallback={fallback} />}

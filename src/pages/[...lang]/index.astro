---
/* The home. English (the root) renders the front the owner picked on 2026-10-24 (GEO-188): B as the hero, A's verdict
   sequence second (src/components/front/Front.astro). The four other languages keep the catalogue's home
   (src/components/HomeA8.astro) until the front's words are translated. */
import HomeA8 from '../../components/HomeA8.astro';
import Front from '../../components/front/Front.astro';
import { langPaths, resolve, type Lang } from '../../i18n';
export const getStaticPaths = () => langPaths();
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t, fallback } = resolve(lang);
---
{lang === 'en' ? <Front lang={lang} t={t} /> : <HomeA8 lang={lang} t={t} fallback={fallback} />}

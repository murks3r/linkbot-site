---
/* The privacy notice, as a clearly marked placeholder until Trust's T6 drafts are released: no
   legal text is invented. What is already true of this site is listed, as technical facts. */
import Base from '../../layouts/Base.astro';
import { langPaths, resolve, type Lang } from '../../i18n';
export const getStaticPaths = () => langPaths();
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t, fallback } = resolve(lang);
const p = t.privacy;
---
<Base lang={lang} t={t} fallback={fallback} title={p.title} description={p.description} path="/privacy" crumbs={[[t.site.footer.privacy, '/privacy']]}>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1>{p.h1}</h1>
    </div>
  </section>
  <div class="wrap doc-one">
    <div class="placeholder" role="note" aria-label={p.eyebrow}>
      <p>{p.lede}</p>
    </div>
    <section aria-labelledby="facts-title">
      <h2 id="facts-title">{p.facts.title}</h2>
      <ul class="plain">{p.facts.items.map(item => <li>{item}</li>)}</ul>
    </section>
  </div>
</Base>

---
/* The privacy notice: the released text from src/legal/privacy.ts, or, until there is one, a clearly marked placeholder
   that says it is in preparation. No legal text is invented. What is already true of this site is listed either way, as
   technical facts. */
import Base from '../../layouts/Base.astro';
import LegalText from '../../components/LegalText.astro';
import { PRIVACY } from '../../legal/privacy';
import { langPaths, resolve, type Lang } from '../../i18n';
export const getStaticPaths = () => langPaths();
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t, fallback } = resolve(lang);
const p = t.privacy;
---
<Base lang={lang} t={t} fallback={fallback} title={p.title} description={PRIVACY ? p.released.description : p.description} path="/privacy" crumbs={[[t.site.footer.privacy, '/privacy']]}>
  <section class="page-hero">
    <div class="wrap">
      {PRIVACY ? <h1>{p.eyebrow}</h1> : <><p class="eyebrow">{p.eyebrow}</p><h1>{p.h1}</h1></>}
    </div>
  </section>
  <div class="wrap doc-one">
    {PRIVACY ? <LegalText text={PRIVACY} /> : (
      <div class="placeholder" role="note" aria-label={p.eyebrow} data-legal-pending>
        <p>{p.lede}</p>
      </div>
    )}
    <section aria-labelledby="facts-title">
      <h2 id="facts-title">{p.facts.title}</h2>
      <ul class="plain">{p.facts.items.map(item => <li>{item}</li>)}</ul>
    </section>
  </div>
</Base>

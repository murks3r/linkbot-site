---
/* Who sees what, and when (redesign pass, GEO-188, 2026-10-24): direction C as its own page, in every language; its
   words from src/front/copy.ts, the rules, deletion and the synthetic note from the catalogue. */
import Base from '../../layouts/Base.astro';
import WhoSeesWhat from '../../components/front/WhoSeesWhat.astro';
import { FRONT } from '../../front/copy';
import { langPaths, resolve, type Lang } from '../../i18n';
export const getStaticPaths = () => langPaths();
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = resolve(lang);
const { c: C } = FRONT[lang];
---
<Base lang={lang} t={t} title={C.meta.title} description={C.meta.description} path="/who-sees-what" crumbs={[[t.site.nav.sees, '/who-sees-what']]} front>
  <WhoSeesWhat lang={lang} t={t} />
</Base>

---
/* Who sees what, and when (redesign pass, GEO-188, 2026-10-24): direction C as its own page. The words are English
   for every language until they are translated; a page in another language says so at the top (the fallback notice)
   and carries lang="en". */
import Base from '../../layouts/Base.astro';
import WhoSeesWhat from '../../components/front/WhoSeesWhat.astro';
import { C } from '../../front/c-copy';
import { langPaths, resolve, type Lang } from '../../i18n';
export const getStaticPaths = () => langPaths();
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = resolve(lang);
---
<Base lang={lang} t={t} fallback={lang !== 'en'} title={C.meta.title} description={C.meta.description} path="/who-sees-what" crumbs={[[t.site.nav.sees, '/who-sees-what']]} front>
  <WhoSeesWhat lang={lang} t={t} />
</Base>

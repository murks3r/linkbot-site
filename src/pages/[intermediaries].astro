---
/* Draft for the owner's review, English only: what an intermediary (recruiter, broker, agency) gets from Linkbot as an
   introduction layer. Linked from nowhere, never indexed (Base's draft), out of the sitemap (astro.config.mjs), and
   absent from a production build (getStaticPaths returns no route there; src/drafts/intermediaries.ts). Words:
   src/drafts/intermediaries.ts, each sentence with its row in docs/truth-check.md. */
import DraftPage from '../components/DraftPage.astro';
import { buildsIntermediaries, intermediaries } from '../drafts/intermediaries';
export function getStaticPaths() { return buildsIntermediaries({ VERCEL_ENV: process.env.VERCEL_ENV }) ? [{ params: { intermediaries: 'for-intermediaries' } }] : []; }
---
<DraftPage d={intermediaries} path="/for-intermediaries" />

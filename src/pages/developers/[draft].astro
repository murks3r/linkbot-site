---
/* Drafts for the owner's review in the developer docs, English only: the planned sign-in with Linkbot
   (src/drafts/login.ts) and a new vertical as a pack (src/drafts/new-vertical.ts). Planned, not on the staging space.
   Linked from nowhere, never indexed (Base's draft), out of the sitemap (astro.config.mjs), and absent from a
   production build (getStaticPaths returns no route there). Each sentence has its row in docs/truth-check.md. */
import DraftPage from '../../components/DraftPage.astro';
import type { Draft } from '../../drafts/draft';
import { buildsLogin, login } from '../../drafts/login';
import { buildsNewVertical, newVertical } from '../../drafts/new-vertical';
export function getStaticPaths() {
  const env = { VERCEL_ENV: process.env.VERCEL_ENV };
  const drafts: [string, Draft, boolean][] = [
    ['login-with-linkbot', login, buildsLogin(env)],
    ['a-new-vertical', newVertical, buildsNewVertical(env)],
  ];
  return drafts.filter(([, , builds]) => builds).map(([draft, d]) => ({ params: { draft }, props: { d } }));
}
const { d } = Astro.props as { d: Draft };
---
<DraftPage d={d} path={`/developers/${Astro.params.draft}`} />

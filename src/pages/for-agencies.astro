---
import BaseLayout from '../layouts/BaseLayout.astro';
import AgencyDemo from '../components/agency/AgencyDemo';
import AgencyPilotForm from '../components/agency/AgencyPilotForm';

const steps = [
  { number: '01', label: 'Interpret', title: 'Make the mandate explicit.', description: 'Translate the role brief into reviewable hard constraints, preferences and unanswered questions. The agency reviews, corrects and owns the criteria before anything else happens.' },
  { number: '02', label: 'Verify', title: 'Show the evidence, including the gaps.', description: 'Compare those criteria with sources the agency is authorised to use. Each criterion is answered separately: supported, missing, or failing a stated hard requirement.' },
  { number: '03', label: 'Review', title: 'The recruiter decides.', description: 'Ranking is a review aid, not a verdict. Your recruiter can override, add, exclude or ask for more evidence, and the reasoning stays attached to the list.' },
  { number: '04', label: 'Confirm', title: 'Ask whether there is interest.', description: 'A promising match is not an interested candidate. Confirm the person wants to explore the opportunity before anything moves forward.' },
  { number: '05', label: 'Introduce', title: 'Share only with permission.', description: 'An introduction is a separate, explicit step: the candidate knows what is shared, with whom and why before any disclosure.' },
];

const responsibilities = [
  { owner: 'Linkbot', label: 'Drafts and shows', description: 'Structures the mandate, surfaces evidence and gaps, and keeps exclusions visible. It produces a review, never a decision.' },
  { owner: 'Your recruiters', label: 'Decide and override', description: 'Own the criteria, the shortlist and the client relationship. Every override and rejection remains theirs, with the reason recorded.' },
  { owner: 'Candidates', label: 'Consent, always separately', description: 'Interest is confirmed first; disclosure of details is a second, explicit decision the person makes for themselves.' },
];

const principles = [
  { label: 'Your relationships remain yours', description: 'Keep your pool, engagement and client relationships under your agency’s control. Linkbot is intended as a decision-support layer, not another candidate marketplace.' },
  { label: 'Your systems remain in place', description: 'Work alongside the ATS and sourcing process you already use. The pilot starts with a bounded mandate, not a platform migration.' },
  { label: 'Every gap stays visible', description: 'Missing evidence is not silently converted into a pass. Hard failures, unknowns and preferences receive different treatment and separate labels.' },
];

const faqs = [
  { question: 'Is this a live product we can use today?', answer: 'Not for this workflow. The agency offering is pre-production. The interactive workspace on this page is a self-contained illustration built from fictional data; there is no live candidate pool, matching service or ATS integration behind it. A pilot is a scoped discovery exercise, not a switch-on.' },
  { question: 'Does Linkbot replace our ATS or CRM?', answer: 'No. The intended role is a review layer for mandate interpretation, evidence review and permission-aware matching around the systems your agency already operates.' },
  { question: 'Is the candidate pool in the example real?', answer: 'No. Every mandate, profile, evidence statement and result is fictional and written for this page. The example does not process real candidate records, contact anyone, or access any pool.' },
  { question: 'What does the ranking claim?', answer: 'Nothing about model accuracy or commercial outcomes. It is a fixed documented rule — hard requirements first, then missing evidence, then preferred signals — included so the reasoning is inspectable. We publish no accuracy, speed or placement statistics because none have been validated.' },
  { question: 'Does a match mean we can introduce someone?', answer: 'No. Fit is a screening signal. The candidate must separately confirm interest and authorise the introduction and its data scope.' },
  { question: 'What would we need to supply for a pilot?', answer: 'A specific mandate, an understanding of your current workflow, and an authorised pool or sample if the exercise needs one. A first conversation needs no candidate data at all. We agree scope, data handling and feasibility before anything real is touched.' },
];
---

<BaseLayout
  title="Linkbot for Recruiting Agencies — Explainable, evidence-led shortlists"
  description="Turn a recruiting mandate into an explainable, evidence-backed shortlist without replacing your ATS. Walk through a synthetic interactive example, then request a scoped one-mandate pilot."
  canonicalPath="/for-agencies"
>
  <main id="main">
    <section class="relative isolate overflow-hidden border-b border-bone-50/10" aria-labelledby="agency-hero-heading">
      <div class="pointer-events-none absolute inset-0 -z-10 bg-grid opacity-70" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-40 top-10 -z-10 h-[34rem] w-[34rem] rounded-full bg-signal-500/10 blur-[130px]" aria-hidden="true"></div>
      <div class="container-prose">
        <header class="flex flex-wrap items-center justify-between gap-5 border-b border-bone-50/10 py-6">
          <a href="/" class="inline-flex items-center gap-3 text-sm font-medium text-bone-50" aria-label="Linkbot home">
            <svg width="24" height="24" viewBox="0 0 22 22" fill="none" aria-hidden="true" class="text-signal-400"><path d="M3 11 L11 3 L19 11 L11 19 Z" stroke="currentColor" stroke-width="1.2"/><circle cx="11" cy="11" r="2.2" fill="currentColor"/></svg>
            <span class="tracking-tight">Linkbot</span>
            <span class="hidden border-l border-bone-50/20 pl-3 text-xs font-normal text-bone-200/50 sm:inline">For agencies</span>
          </a>
          <nav aria-label="Agency page navigation" class="flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
            <a href="#workflow" class="inline-flex min-h-11 items-center text-bone-200/70 transition-colors hover:text-bone-50">How it works</a>
            <a href="#demo" class="inline-flex min-h-11 items-center text-bone-200/70 transition-colors hover:text-bone-50">Interactive example</a>
            <a href="#pilot" class="inline-flex min-h-11 items-center rounded-full border border-bone-50/30 px-4 py-2 font-medium text-bone-50 transition-colors hover:border-signal-400 hover:text-signal-400">Request a pilot <span aria-hidden="true">↗</span></a>
          </nav>
        </header>

        <div class="grid min-h-[70svh] items-center gap-14 py-20 sm:py-28 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-7">
            <p class="pill mb-7"><span class="h-1.5 w-1.5 rounded-full bg-signal-400"></span>Recruiting intelligence · private by design</p>
            <h1 id="agency-hero-heading" class="max-w-3xl font-display text-[clamp(2.8rem,5.5vw,5.3rem)] font-light leading-[1.02] tracking-tightest text-balance">
              Explainable shortlists. <span class="text-signal-400">Your candidates.</span> Your call.
            </h1>
            <p class="mt-7 max-w-2xl text-lg leading-8 text-bone-200/80 text-pretty sm:text-xl">
              Turn a mandate into clear requirements you can review. See why each candidate is on the list — and why the others are not. Confirm interest before any introduction. No ATS replacement, no claim over your relationships.
            </p>
            <div class="mt-9 flex flex-wrap items-center gap-3">
              <a href="#pilot" class="btn-primary">Request a scoped pilot <span aria-hidden="true">↗</span></a>
              <a href="#demo" class="btn-ghost">See the interactive example</a>
            </div>
            <p class="mt-5 text-xs leading-5 text-bone-200/60">
              <span class="font-medium text-bone-200/80">First conversation needs no candidate data.</span>
              The interactive example uses fictional mandates and synthetic profiles — no live matching, no real people.
            </p>
          </div>
          <div class="lg:col-span-5">
            <div class="relative overflow-hidden rounded-2xl border border-bone-50/15 bg-ink-900/90 p-6 shadow-2xl shadow-black/40 sm:p-8" aria-label="Illustration of the intended mandate to introduction process">
              <div class="mb-7 flex items-center justify-between gap-4">
                <span class="font-mono text-xs uppercase tracking-[0.18em] text-bone-200/55">THE INTENDED WORKFLOW</span>
                <span class="rounded-full border border-amber-200/25 bg-amber-200/10 px-3 py-1 font-mono text-[10px] tracking-widest text-amber-100">ILLUSTRATION</span>
              </div>
              <ol class="space-y-0">
                <li class="relative flex gap-5 pb-8">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-signal-400/60 font-mono text-xs text-signal-400">01</span>
                  <div><p class="font-medium text-bone-50">Mandate → criteria</p><p class="mt-1 text-sm text-bone-200/65">Required vs. preferred, reviewed by you.</p></div>
                  <span class="absolute bottom-1 left-5 h-6 w-px bg-bone-50/20" aria-hidden="true"></span>
                </li>
                <li class="relative flex gap-5 pb-8">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-signal-400/60 font-mono text-xs text-signal-400">02</span>
                  <div><p class="font-medium text-bone-50">Criteria → evidence</p><p class="mt-1 text-sm text-bone-200/65">Shortlist with fit, uncertainty and exclusions.</p></div>
                  <span class="absolute bottom-1 left-5 h-6 w-px bg-bone-50/20" aria-hidden="true"></span>
                </li>
                <li class="relative flex gap-5 pb-8">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-signal-400/60 font-mono text-xs text-signal-400">03</span>
                  <div><p class="font-medium text-bone-50">Review → recruiter's call</p><p class="mt-1 text-sm text-bone-200/65">Override, add or exclude, with reasons kept.</p></div>
                  <span class="absolute bottom-1 left-5 h-6 w-px bg-bone-50/20" aria-hidden="true"></span>
                </li>
                <li class="relative flex gap-5 pb-8">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-signal-400/60 font-mono text-xs text-signal-400">04</span>
                  <div><p class="font-medium text-bone-50">Potential fit → interest</p><p class="mt-1 text-sm text-bone-200/65">Candidate chooses whether to engage.</p></div>
                  <span class="absolute bottom-1 left-5 h-6 w-px bg-bone-50/20" aria-hidden="true"></span>
                </li>
                <li class="flex gap-5">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-bone-50/30 font-mono text-xs text-bone-200/75">05</span>
                  <div><p class="font-medium text-bone-50">Interest → permitted introduction</p><p class="mt-1 text-sm text-bone-200/65">Disclosure is a separate, explicit decision.</p></div>
                </li>
              </ol>
              <div class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-bone-50/10 pt-5 font-mono text-[11px] uppercase tracking-[0.14em] text-bone-200/45">
                <span>Match ≠ interest ≠ consent</span>
                <span>Diagram, not a screenshot</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="workflow" class="border-b border-bone-50/10 py-24 sm:py-32" aria-labelledby="workflow-heading">
      <div class="container-prose">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8">
            <p class="pill mb-5"><span class="h-1.5 w-1.5 rounded-full bg-signal-400"></span>From brief to decision</p>
            <h2 id="workflow-heading" class="max-w-3xl font-display text-4xl font-light leading-[1.06] tracking-tightest text-balance sm:text-5xl">Know why a candidate belongs on the shortlist.</h2>
          </div>
          <p class="max-w-md text-base leading-7 text-bone-200/70 lg:col-span-4">The recruiter remains the decision-maker at every step. The product organises evidence and makes the next permitted step explicit.</p>
        </div>
        <ol class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-bone-50/10 bg-bone-50/10 sm:grid-cols-2 lg:grid-cols-5">
          {steps.map((step) => (
            <li class="bg-ink-950 p-7">
              <p class="font-mono text-xs uppercase tracking-widest text-signal-400">{step.number} / {step.label}</p>
              <h3 class="mt-6 font-display text-2xl font-light leading-tight">{step.title}</h3>
              <p class="mt-4 text-sm leading-6 text-bone-200/70">{step.description}</p>
            </li>
          ))}
        </ol>

        <div class="mt-12">
          <h3 class="text-sm font-semibold uppercase tracking-[0.16em] text-bone-200/70">Who does what</h3>
          <div class="mt-5 grid gap-px overflow-hidden rounded-2xl border border-bone-50/10 bg-bone-50/10 lg:grid-cols-3">
            {responsibilities.map((row) => (
              <div class="bg-ink-950 p-6 sm:p-7">
                <p class="font-mono text-xs uppercase tracking-widest text-signal-400">{row.owner}</p>
                <h4 class="mt-4 text-lg font-medium">{row.label}</h4>
                <p class="mt-2 text-sm leading-6 text-bone-200/70">{row.description}</p>
              </div>
            ))}
          </div>
          <p class="mt-5 max-w-3xl text-xs leading-6 text-bone-200/55">This is the intended division of responsibility for a pilot. The interactive example below demonstrates the review half of it — with fictional data only.</p>
        </div>
      </div>
    </section>

    <section id="ownership" class="relative border-b border-bone-50/10 py-24 sm:py-32" aria-labelledby="ownership-heading">
      <div class="container-prose grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="pill mb-5">Built around your pool</p>
          <h2 id="ownership-heading" class="font-display text-4xl font-light leading-[1.06] tracking-tightest text-balance sm:text-5xl">Your network is the asset. <span class="text-signal-400">Keep it that way.</span></h2>
          <p class="mt-6 max-w-md text-base leading-7 text-bone-200/75">Linkbot is not a competing talent marketplace. The proposed agency workflow is designed to help you reason over sources you are authorised to use while sourcing, judgement and relationships stay with your firm.</p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <div class="divide-y divide-bone-50/10 border-t border-bone-50/10">
            {principles.map((principle, index) => (
              <div class="grid gap-3 py-7 sm:grid-cols-[3rem_1fr]">
                <span class="font-mono text-xs text-signal-400">0{index + 1}</span>
                <div><h3 class="text-lg font-medium">{principle.label}</h3><p class="mt-2 max-w-lg text-sm leading-7 text-bone-200/70">{principle.description}</p></div>
              </div>
            ))}
          </div>
          <p class="mt-6 border-l-2 border-signal-400/60 pl-5 text-sm leading-7 text-bone-200/75">Pilot data access, retention and candidate-contact boundaries would be agreed before any real agency data is used. The demonstration below runs on fictional fixtures only.</p>
        </div>
      </div>
    </section>

    <section id="demo" class="relative border-b border-bone-50/10 py-24 sm:py-32" aria-labelledby="demo-heading">
      <div class="pointer-events-none absolute inset-0 bg-grid opacity-30" aria-hidden="true"></div>
      <div class="container-prose relative">
        <div class="mb-12 grid gap-6 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8">
            <p class="pill mb-5"><span class="h-1.5 w-1.5 rounded-full bg-signal-400"></span>Interactive example</p>
            <h2 id="demo-heading" class="font-display text-4xl font-light leading-[1.06] tracking-tightest text-balance sm:text-5xl">Walk through an example shortlist.</h2>
            <p class="mt-5 max-w-2xl text-base leading-7 text-bone-200/75">Choose an example mandate, read its interpretation, inspect the evidence behind each fictional profile, review who is excluded and why, then see what interest confirmation looks like from the candidate side.</p>
            <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-xs text-bone-200/60">
              <li>Seven steps, entirely in your browser</li>
              <li>Keyboard accessible</li>
              <li>No account, no data entry required</li>
            </ul>
          </div>
          <p class="max-w-sm rounded-lg border border-amber-200/25 bg-amber-200/10 px-4 py-3 text-xs leading-5 text-amber-100 lg:col-span-4">Status: demonstration only. All mandates, profiles, evidence and results are synthetic, and nothing here represents validated Linkbot performance or a live product integration.</p>
        </div>
        <AgencyDemo client:load />
        <noscript>
          <div class="mt-5 rounded-lg border border-bone-50/20 p-5 text-sm text-bone-200/80">JavaScript is required for the interactive example. The workflow is: choose a mandate, review requirements and supporting evidence, review exclusions, prepare a shortlist, then seek candidate interest and separate permission for disclosure. <a href="#pilot" class="text-signal-400 underline">Request a pilot</a> without running the example.</div>
        </noscript>

        <div class="mt-10 flex flex-col gap-5 rounded-2xl border border-signal-400/25 bg-signal-400/[0.06] p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
          <div>
            <h3 class="font-display text-2xl font-light">Finished the example? Start with one real mandate.</h3>
            <p class="mt-2 max-w-xl text-sm leading-6 text-bone-200/75">A pilot runs these steps against a bounded, authorised sample of your own pool, with your recruiters deciding. Bring a mandate and a workflow description — no candidate data needed to begin.</p>
          </div>
          <a href="#pilot" class="btn-primary shrink-0">Request a scoped pilot <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section id="pilot" class="border-b border-bone-50/10 py-24 sm:py-32" aria-labelledby="pilot-heading">
      <div class="container-prose">
        <div class="grid gap-14 lg:grid-cols-12">
          <div class="lg:col-span-5">
            <p class="pill mb-5"><span class="h-1.5 w-1.5 rounded-full bg-signal-400"></span>Scoped agency pilot</p>
            <h2 id="pilot-heading" class="font-display text-4xl font-light leading-[1.06] tracking-tightest text-balance sm:text-5xl">Start with one mandate. See what is worth testing.</h2>
            <p class="mt-5 text-base leading-7 text-bone-200/75">A scoped discovery pilot, not a promise of automatic placements and not a production integration. We agree the boundaries before any real data is involved.</p>
            <h3 class="mt-9 text-sm font-semibold uppercase tracking-[0.16em] text-bone-200/70">Proposed pilot scope</h3>
            <ul class="mt-5 space-y-4 text-sm leading-6 text-bone-200/80">
              <li class="flex gap-3"><span aria-hidden="true" class="text-signal-400">✓</span><span>One current recruiting mandate, interpreted with your team</span></li>
              <li class="flex gap-3"><span aria-hidden="true" class="text-signal-400">✓</span><span>A bounded, authorised sample of your candidate pool, if the exercise needs one</span></li>
              <li class="flex gap-3"><span aria-hidden="true" class="text-signal-400">✓</span><span>Review of fit, missing evidence, hard exclusions and recruiter overrides</span></li>
              <li class="flex gap-3"><span aria-hidden="true" class="text-signal-400">✓</span><span>A defined interest and permission workflow before any introduction</span></li>
              <li class="flex gap-3"><span aria-hidden="true" class="text-signal-400">✓</span><span>A written record of what was and was not validated</span></li>
            </ul>
            <h3 class="mt-9 text-sm font-semibold uppercase tracking-[0.16em] text-bone-200/70">What this page does not offer</h3>
            <ul class="mt-5 space-y-3 text-sm leading-6 text-bone-200/70">
              <li class="flex gap-3"><span aria-hidden="true" class="text-bone-200/45">–</span><span>No published accuracy, time-saving or placement figures</span></li>
              <li class="flex gap-3"><span aria-hidden="true" class="text-bone-200/45">–</span><span>No automated candidate outreach or database access</span></li>
              <li class="flex gap-3"><span aria-hidden="true" class="text-bone-200/45">–</span><span>No self-service signup or live candidate availability</span></li>
            </ul>
            <p class="mt-6 text-xs leading-6 text-bone-200/55">Timing, integration needs, commercial terms and data-processing safeguards are determined together; none are implied by this enquiry.</p>
          </div>
          <div class="rounded-2xl border border-bone-50/15 bg-ink-800/70 p-6 sm:p-9 lg:col-span-7">
            <h3 class="font-display text-2xl font-light">Tell us what your agency recruits for.</h3>
            <p class="mt-3 mb-8 text-sm leading-6 text-bone-200/70">We use this context to discuss whether a one-mandate pilot fits your workflow. The form below prepares an email draft on your device — it is not submitted to Linkbot’s website.</p>
            <AgencyPilotForm client:load />
            <noscript><p class="mt-6 text-sm text-bone-200/75">Email <a class="text-signal-400 underline" href="mailto:hello@linkbot.org?subject=Linkbot%20agency%20pilot%20enquiry">hello@linkbot.org</a> to enquire about a pilot.</p></noscript>
            <div class="mt-8 border-t border-bone-50/10 pt-6">
              <h4 class="text-xs font-semibold uppercase tracking-[0.16em] text-bone-200/65">What happens next</h4>
              <ol class="mt-4 space-y-3 text-sm leading-6 text-bone-200/75">
                <li class="flex gap-3"><span class="font-mono text-xs text-signal-400">01</span><span>We read your message and reply to arrange a short scoping conversation.</span></li>
                <li class="flex gap-3"><span class="font-mono text-xs text-signal-400">02</span><span>If a pilot makes sense, scope, data handling and access limits are agreed in writing first.</span></li>
                <li class="flex gap-3"><span class="font-mono text-xs text-signal-400">03</span><span>If it does not fit, we say so — there is no automated follow-up sequence.</span></li>
              </ol>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 sm:py-24" aria-labelledby="agency-faq-heading">
      <div class="container-prose grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4"><p class="pill mb-5">Questions</p><h2 id="agency-faq-heading" class="font-display text-3xl font-light sm:text-4xl">Before you try it.</h2></div>
        <dl class="divide-y divide-bone-50/10 border-t border-bone-50/10 lg:col-span-7 lg:col-start-6">
          {faqs.map((faq) => (
            <div class="py-6"><dt class="font-medium">{faq.question}</dt><dd class="mt-3 text-sm leading-7 text-bone-200/70">{faq.answer}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <footer class="border-t border-bone-50/10 py-9">
      <div class="container-prose flex flex-wrap items-center justify-between gap-5 text-sm text-bone-200/60">
        <p>© 2026 Linkbot OÜ · Tallinn, Estonia</p>
        <nav aria-label="Footer navigation" class="flex flex-wrap gap-x-6 gap-y-3">
          <a href="/" class="inline-flex min-h-11 items-center hover:text-bone-50">Home</a>
          <a href="#demo" class="inline-flex min-h-11 items-center hover:text-bone-50">Interactive example</a>
          <a href="#pilot" class="inline-flex min-h-11 items-center hover:text-bone-50">Agency pilot</a>
          <a href="mailto:hello@linkbot.org" class="inline-flex min-h-11 items-center hover:text-bone-50">Contact</a>
        </nav>
      </div>
    </footer>
  </main>
</BaseLayout>

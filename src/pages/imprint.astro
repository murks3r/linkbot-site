---
/* The legal notice (Impressum), drafted from Trust's T6-7 (GEO-135, section A, a draft for counsel and
   not legal advice). The company data are the Estonian e-Business Register's, as T6-7 records them
   (read there on 2026-10-20). Two points stay visibly open until they are settled:
   - CONTACT_EMAIL: a mailbox on the Linkbot domain, which the owner has not named yet
     (contact＠linkbot-domain-tbd.invalid until then; .invalid never resolves).
   - the board line: counsel decides whether the applicable law requires the name of the management
     board member. Then replace the bracketed line with the name, or delete it, and set
     BOARD_LINE_SETTLED to true.
   A production build stops while either is open, so an unfinished notice cannot go live. */
import BaseLayout from '../layouts/BaseLayout.astro';

const CONTACT_EMAIL: string | undefined = undefined;
const BOARD_LINE_SETTLED = false;
if (process.env.VERCEL_ENV === 'production' && (!CONTACT_EMAIL || !BOARD_LINE_SETTLED)) {
  throw new Error('src/pages/imprint.astro: set CONTACT_EMAIL and settle the board line before publishing.');
}
---

<BaseLayout title="Legal notice · Linkbot" description="Legal notice (Impressum) for this website: Linkbot OÜ, Tallinn, Estonia." canonicalPath="/imprint">
  <main id="main" class="relative isolate min-h-[100svh] overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-grid opacity-60" aria-hidden="true"></div>
    <div class="container-prose py-12 sm:py-20">
      <a href="/" class="font-display text-xl tracking-tight text-bone-50">Linkbot</a>
      <h1 class="mt-16 font-display text-4xl font-light leading-[1.05] tracking-tightest sm:text-5xl">Legal notice</h1>
      <address class="mt-8 max-w-2xl text-lg not-italic leading-relaxed text-bone-200/80">
        Linkbot OÜ (osaühing, a private limited company)<br />
        Registry code 17363936, Estonian e-Business Register (e-äriregister)<br />
        Ahtri tn 12, 15551 Tallinn, Estonia<br />
        Email: {CONTACT_EMAIL
          ? <a href={`mailto:${CONTACT_EMAIL}`} class="underline decoration-bone-50/30 underline-offset-4 hover:decoration-signal-400">{CONTACT_EMAIL}</a>
          : <span>[contact＠linkbot-domain-tbd.invalid: a mailbox on the Linkbot domain, to be named by the owner]</span>}
      </address>
      {!BOARD_LINE_SETTLED && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-bone-200/80">[Management board member (juhatuse liige): name, only if counsel confirms that the applicable law requires it]</p>}
    </div>
  </main>
</BaseLayout>

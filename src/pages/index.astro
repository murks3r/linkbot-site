---
/* A holding page until the rebuilt site replaces this one at the milestone. Every sentence here is
   true today (the Space API contract and the Connect lane's docs back the first paragraph); there is
   no form, so the page collects nothing, and it loads nothing from other sites. */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main id="main" class="relative isolate min-h-[100svh] overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-grid opacity-60" aria-hidden="true"></div>
    <div class="container-prose flex min-h-[100svh] flex-col justify-between py-12 sm:py-20">
      <p class="font-display text-xl tracking-tight text-bone-50">Linkbot</p>

      <section class="max-w-3xl" aria-labelledby="holding-headline">
        <h1 id="holding-headline" class="font-display text-4xl font-light leading-[1.05] tracking-tightest text-balance sm:text-6xl">
          Linkbot is building a matching layer that platforms embed in their own pages.
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-bone-200/80 text-pretty">
          One space per market. Needs and offers described as criteria the person confirms. An introduction only after both sides say yes.
        </p>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-bone-200/60 text-pretty">
          This site is being rebuilt. Until then it has no forms, sets no cookies and loads nothing from other sites.
        </p>
      </section>

      <footer class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs uppercase tracking-[0.18em] text-bone-200/50">
        <span>© 2026 Linkbot OÜ · Tallinn, Estonia</span>
        <a href="/imprint" class="inline-flex min-h-[44px] items-center underline decoration-bone-50/30 underline-offset-4 hover:text-bone-50">Legal notice</a>
      </footer>
    </div>
  </main>
</BaseLayout>

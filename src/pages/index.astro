---
import Home from '../components/Home.astro';
import Signal from '../components/Signal.astro';
import Yours from '../components/Yours.astro';
/* The home page (Concept A9): the shared composition (components/Home.astro: hero, story slot,
   invitation), with W1's default story in the slot. */
---
<Home>
  <!-- a9:story:start -->
  <!-- The story block (Concept A9's slot, fundament v0 contracts.md): a direction replaces only what
       lies between these two markers with its <Story /> (src/components/directions/<key>/), keeping
       the anchor #story for the hero's cue. Today: A8's two scenes. -->
  <!-- 2. The story: from openings everywhere to the right ones, step by step. -->
  <div id="story" class="story" data-stage="story">
    <Signal />
  </div>

  <!-- 3. Privacy, in the same bright world: what you see, and what an employer sees. -->
  <div class="story" data-stage="privacy">
    <Yours />
  </div>
  <!-- a9:story:end -->
</Home>

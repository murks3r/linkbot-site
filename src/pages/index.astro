---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import Clarity from '../components/Clarity.astro';
import Glass from '../components/Glass.astro';
import Icon from '../components/Icon.astro';
import { START_EXAMPLES, START_PLACEHOLDER } from '../data/content';
---
<Base title="Linkbot: find work that fits, keep your privacy"
  description="Say what matters in a few words. Linkbot reads current job listings against them and shows why each one fits, or doesn’t. No account needed."
  path="/" quietHeader sky>

  <!-- 1. The opening viewport: one focal unit (the headline, the search, the pink action) on the
       living atmosphere; three plain promises at its foot. -->
  <section class="hero" data-stage="value" aria-labelledby="hero-title">
    <div class="hero-focal">
      <h1 id="hero-title"><span class="h1-line">Find work that fits.</span> <span class="h1-line">Keep your privacy.</span></h1>
      <div class="hero-search" data-hero-search>
        <SearchForm id="q-hero" size="focal" />
      </div>
    </div>
    <div class="hero-foot">
      <ul class="promises" aria-label="Before you search">
        <li>No account needed to search</li>
        <li>See why each job fits</li>
        <li>Employers aren’t told you’re looking</li>
      </ul>
      <a class="hero-cue" href="#story" aria-label="See how it works"><span data-decor aria-hidden="true"></span></a>
    </div>
  </section>

  <!-- 2. The story: your words become clarity (one continuous scene). -->
  <div id="story" class="story" data-stage="story">
    <Clarity />
  </div>

  <!-- 3. The night: privacy, as two sides of the glass. -->
  <section class="night" data-stage="privacy" data-air-cover aria-label="Your privacy">
    <div class="night-ground" data-decor aria-hidden="true"></div>
    <svg class="night-grain" aria-hidden="true" focusable="false"><rect class="grain-coarse" width="100%" height="100%" fill="url(#grain-tile-coarse)" /><rect class="grain-fine" width="100%" height="100%" fill="url(#grain-tile-fine)" /></svg>
    <Glass />
  </section>

  <!-- 4. The invitation: the question the story leaves you with, and the search again. -->
  <section class="band start" data-stage="start" aria-labelledby="start-title">
    <div class="wrap start-inner">
      <h2 id="start-title">What would make your next move worth it?</h2>
      <SearchForm id="q-start" size="focal" placeholder={START_PLACEHOLDER} examples={START_EXAMPLES} />
      <p class="start-links"><a class="link" href="/how-it-works">How it works<Icon name="arrow" /></a><a class="link" href="/privacy">How your privacy works<Icon name="arrow" /></a><a class="link" href="/hiring">Hiring?<Icon name="arrow" /></a></p>
    </div>
  </section>
</Base>

<script>import '../scripts/atmosphere';</script>

<style>
  /* 1. The hero. The focal unit starts high enough that the search sits just above the middle of
     the viewport (its optical centre); the promises keep to the foot. */
  .hero { position: relative; min-height: calc(100svh - var(--header)); display: grid; grid-template-rows: 1fr auto; padding: clamp(48px, 15vh, 150px) var(--gutter) 0; }
  .hero-focal { display: grid; justify-items: center; align-content: start; gap: clamp(26px, 3.6vh, 38px); text-align: center; }
  /* One weight and one colour on both lines: the composition is balanced by measure, not by
     softening a line. */
  .hero h1 { max-width: 15ch; font-weight: 560; }
  .h1-line { display: block; }
  .hero-search { width: 100%; display: grid; justify-items: center; }
  .hero-foot { display: grid; justify-items: center; gap: 18px; padding-bottom: clamp(18px, 3vh, 28px); }
  .promises { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 0; font-size: var(--size-small); font-weight: 560; color: var(--ink-2); }
  .promises li { display: inline-flex; align-items: center; }
  .promises li + li::before { content: ''; width: 4px; height: 4px; margin: 0 18px; border-radius: 50%; background: currentColor; opacity: .7; }
  .hero-cue { position: relative; display: grid; place-items: center; width: var(--target); height: var(--target); color: var(--ink-2); }
  .hero-cue span { width: 1px; height: 28px; background: linear-gradient(currentColor, transparent); transform-origin: 0 0; }
  /* The cue draws itself three times, then rests: a hint, not a loop. */
  @media (prefers-reduced-motion: no-preference) { :global(.js) .hero-cue span { animation: cue 2.8s var(--ease) 1.2s 3 both; } }
  @keyframes cue { 0% { transform: scaleY(0); opacity: 0; } 30% { opacity: 1; } 70% { transform: scaleY(1); opacity: 1; } 99% { transform: scaleY(1) translateY(10px); opacity: 0; } 100% { transform: scaleY(1); opacity: 1; } }
  .hero-cue:hover { color: var(--ink); }

  /* 3. The night: a deep band lit from within by three proven dark tints, with the paper's grain.
     Its edges dissolve into the atmosphere rather than cut it. */
  /* The fades live inside the band's own padding, so no text of a neighbouring section ever sits on
     a half-dark ground. */
  .night { position: relative; isolation: isolate; padding-block: var(--fade); color: var(--on-green); --fade: clamp(96px, 16vh, 160px); }
  .night-ground { position: absolute; inset: 0; z-index: -2; pointer-events: none; background: var(--green);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 var(--fade), #000 calc(100% - var(--fade)), transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 var(--fade), #000 calc(100% - var(--fade)), transparent 100%); }
  /* The grain on the night is gentler (soft-light is strongest on mid-tones) and follows the
     band's own fades, so the edges never read as static. */
  .night-grain { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; mix-blend-mode: soft-light; opacity: .6; pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 calc(var(--fade) * 1.4), #000 calc(100% - var(--fade) * 1.4), transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 calc(var(--fade) * 1.4), #000 calc(100% - var(--fade) * 1.4), transparent 100%); }
  .night-grain .grain-fine { display: none; }
  @media (min-resolution: 1.5dppx) { .night-grain .grain-coarse { display: none; } .night-grain .grain-fine { display: inline; } }

  /* 4. The start: back on the centre line. */
  .start { padding-block: clamp(140px, 16vw, 240px) clamp(80px, 10vw, 140px); }
  .start-inner { display: grid; justify-items: center; text-align: center; gap: clamp(24px, 3vw, 36px); }
  .start h2 { max-width: 16ch; }
  .start-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 28px; margin-top: clamp(16px, 3vw, 32px); font-size: var(--size-small); }

  @media (max-width: 40rem) {
    .hero { padding-top: clamp(40px, 12vh, 110px); }
    .promises { flex-direction: column; align-items: center; gap: 4px; font-size: var(--size-micro); }
    .promises li + li::before { display: none; }
  }
</style>

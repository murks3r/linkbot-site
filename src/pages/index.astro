---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import Orbit from '../components/Orbit.astro';
import Priorities from '../components/Priorities.astro';
import Evidence from '../components/Evidence.astro';
import Boundary from '../components/Boundary.astro';
import Icon from '../components/Icon.astro';
import { START_EXAMPLES, START_PLACEHOLDER } from '../data/content';
---
<Base title="Linkbot: find work that fits, keep your privacy"
  description="Say what matters in a few words. Linkbot reads current job listings against them and shows why each one fits, or doesn’t. No account needed."
  path="/" quietHeader sky>

  <!-- 1. The opening viewport: one focal composition. The headline and the search are one unit, the
       search at the optical centre, the pink action the only filled control, one line beneath it. -->
  <section class="hero" data-stage="value" aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <h1 id="hero-title"><span class="h1-line">Find work that fits.</span> <span class="h1-line h1-soft">Keep your privacy.</span></h1>
      <div class="hero-search" data-hero-search>
        <SearchForm id="q-hero" size="monumental" describedBy="hero-note" />
      </div>
      <p class="hero-note" id="hero-note">Say what matters in a few words. Linkbot reads current listings against them and shows why each one fits, or doesn’t.</p>
    </div>
    <a class="hero-cue" href="#story" aria-label="Read how Linkbot works"><Icon name="down" /></a>
  </section>

  <!-- 2–5. The story, on pinned scenes driven by scroll position: the loop becomes a line; what
       matters to you; one opening explained; the boundary. -->
  <div id="story" class="story" data-stage="story">
    <Orbit />
    <Priorities />
    <Evidence />
  </div>

  <!-- The hinge into privacy: the one deep band. -->
  <section class="band hinge" data-tone="green" data-stage="trust" aria-labelledby="hinge-title">
    <div class="wrap hinge-inner">
      <h2 id="hinge-title">Being a good fit doesn’t make you visible.</h2>
      <p>Finding, matching, keeping, sharing and applying are five separate decisions. None of them happens because another one did.</p>
    </div>
  </section>

  <div class="story" data-stage="boundary">
    <Boundary />
  </div>

  <!-- 6. The invitation: the question the story leaves you with, and the search again. -->
  <section class="band start" data-stage="start" aria-labelledby="start-title">
    <div class="wrap start-inner">
      <h2 id="start-title">What would make your next move worth it?</h2>
      <SearchForm id="q-start" size="monumental" placeholder={START_PLACEHOLDER} examples={START_EXAMPLES} />
      <p class="start-links"><a class="link" href="/how-it-works">How it works<Icon name="arrow" /></a><a class="link" href="/privacy">How your privacy works<Icon name="arrow" /></a><a class="link" href="/hiring">Hiring?<Icon name="arrow" /></a></p>
    </div>
  </section>
</Base>

<style>
  /* 1. The hero. The block starts high enough that the search sits near the optical centre
     (about 45 % of the viewport), with the headline composed above it and air below. */
  .hero { position: relative; min-height: calc(100svh - var(--header)); display: grid; align-content: start; padding-top: clamp(56px, 13vh, 140px); padding-bottom: 96px; }
  .hero-inner { display: grid; justify-items: center; text-align: center; gap: clamp(22px, 3.2vh, 34px); }
  .hero h1 { max-width: 14ch; }
  .h1-line { display: block; }
  .h1-soft { font-weight: 320; color: var(--ink-2); }
  .hero-search { width: 100%; display: grid; justify-items: center; }
  .hero-note { max-width: 30em; font-size: var(--size-body); line-height: 1.5; color: var(--ink-2); text-wrap: balance; }
  .hero-cue { position: absolute; left: 50%; bottom: 24px; transform: translateX(-50%); display: grid; place-items: center; width: var(--target); height: var(--target); border-radius: 50%; color: var(--ink-3); text-decoration: none; transition: color var(--fast), transform var(--base) var(--ease); }
  .hero-cue:hover { color: var(--ink); transform: translate(-50%, 3px); }
  @media (prefers-reduced-motion: no-preference) { :global(.js) .hero-cue :global(.icon) { animation: cue 2.4s var(--ease) infinite; } }
  @keyframes cue { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }

  /* The hinge: the one deep band, composed off the centre line. */
  .hinge { padding-block: clamp(80px, 12vw, 160px); }
  .hinge-inner { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 6vw, 112px); align-items: end; }
  .hinge h2 { font-size: clamp(2.25rem, 1.2rem + 3.4vw, 4.25rem); color: var(--on-green); }
  .hinge p { font-size: var(--size-lede); color: var(--on-green-2); max-width: 30em; }

  /* 6. The start: back on the centre line. */
  .start { padding-block: clamp(96px, 14vw, 200px) clamp(80px, 10vw, 140px); }
  .start-inner { display: grid; justify-items: center; text-align: center; gap: clamp(24px, 3vw, 36px); }
  .start h2 { max-width: 16ch; }
  .start-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 28px; margin-top: clamp(16px, 3vw, 32px); font-size: var(--size-small); }

  @media (max-width: 64rem) { .hinge-inner { grid-template-columns: minmax(0, 1fr); align-items: start; } }
  @media (max-width: 40rem) {
    .hero { padding-top: clamp(48px, 12vh, 110px); padding-bottom: 80px; }
    .hero-note { font-size: var(--size-small); }
  }
</style>

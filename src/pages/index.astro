---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import ProblemLoop from '../components/ProblemLoop.astro';
import Unwind from '../components/Unwind.astro';
import Reader from '../components/Reader.astro';
import ListingDemo from '../components/ListingDemo.astro';
import Ladder from '../components/Ladder.astro';
import Today from '../components/Today.astro';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import { app } from '../lib/links';
const EXAMPLES = ['Product designer, hybrid', 'Data engineer, remote', 'Site reliability engineer, no on-call'];
---
<Base title="Linkbot: find work, keep your privacy"
  description="Describe the work you want in a few words. Linkbot reads current job listings and shows what fits, what differs and what isn’t said. No account needed."
  path="/" quietHeader>

  <!-- 1. Immediate value: one centred line of sight, from the promise to the search. -->
  <section class="hero" data-stage="value" aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <p class="eyebrow">Private job search · Free</p>
      <h1 id="hero-title" data-draw><span class="h1-line">Find work.</span> <span class="h1-line"><span class="hl">Keep your privacy.</span></span></h1>
      <p class="lede hero-lede">Describe the work you want in a few words. Linkbot reads current listings and shows what fits, what differs and what isn’t said.</p>
      <div class="hero-search" data-hero-search>
        <SearchForm id="q-hero" size="monumental" examples={EXAMPLES} hint="No account needed. Searches aren’t stored." />
      </div>
      <a class="hero-next" href="#problem">Why job search needs this<Icon name="down" /></a>
    </div>
  </section>

  <!-- 2. The market problem, as one connected loop. -->
  <section class="band story" id="problem" data-stage="problem" aria-labelledby="problem-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The problem</p>
        <h2 id="problem-title">Job search runs in circles.</h2>
        <p>Looking for work means looking everywhere, again and again, and still not knowing what fits. The more visible you make yourself, the noisier it gets. Each problem feeds the next.</p>
      </div>
      <ProblemLoop />
    </div>
  </section>

  <!-- 3. Linkbot's response: the same loop, unwound into a line of answers. -->
  <section class="band story" data-tone="mist" id="answer" data-stage="response" aria-labelledby="answer-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Linkbot’s answer</p>
        <h2 id="answer-title">Linkbot is built to break that loop.</h2>
        <p>Say what matters once. Linkbot does the reading, explains every listing and keeps watching, while you stay private until you decide.</p>
      </div>
      <Unwind />
    </div>
  </section>

  <!-- 4. How the intelligence works: words → criteria → a listing read against them → watching. -->
  <section class="band story" id="reading" data-stage="intelligence" aria-labelledby="reading-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it understands you</p>
        <h2 id="reading-title">It reads your words, and shows its reading.</h2>
        <p>Short phrases become criteria you can see and change. What Linkbot can’t read stays in view and never filters anything. Nothing is guessed, and a Must is always your choice.</p>
      </div>
      <div class="flow">
        <div class="flow-step"><Reader /></div>
        <div class="flow-join" aria-hidden="true"></div>
        <div class="flow-step">
          <h3 class="flow-title">Then every listing is read against your words.</h3>
          <p class="flow-lede">What it states, what it states differently and what it leaves out, with where each answer came from. There is no match score: a missing answer is never counted as a fit.</p>
          <ListingDemo />
          <ul class="facts">
            <li><Mark tone="fit" /><span><b>Source and date</b> on every listing</span></li>
            <li><Mark tone="fit" /><span><b>Current only:</b> checked in the last 7 days</span></li>
            <li><Mark tone="fit" /><span><b>One listing per job:</b> copies merged</span></li>
            <li><Mark tone="unknown" /><span><b>Not every job:</b> Linkbot says what it checked</span></li>
          </ul>
        </div>
        <div class="flow-join" aria-hidden="true"></div>
        <div class="flow-step flow-watch">
          <h3 class="flow-title">And it keeps watching, quietly.</h3>
          <p class="flow-lede">Save what you searched, and Linkbot is built to check it again once a day while it’s active, marking what’s new for your next visit. Pause it any time. No email or push alerts yet.</p>
          <p class="flow-status"><span class="status" data-tone="built"><Mark tone="tradeoff" size={10} />Built, being proven in testing</span> <a class="link" href="/how-it-works#keep">How watching works<Icon name="arrow" /></a></p>
        </div>
      </div>
      <p class="cta-row"><a class="btn btn-secondary" href={app('#/search')}>Explore current listings<Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- 5. Privacy and control. -->
  <section class="band story control" data-tone="ink" id="control" data-stage="control" aria-labelledby="control-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Privacy and control</p>
        <h2 id="control-title">Being a good fit doesn’t make you visible.</h2>
        <p>Finding a job, matching it, keeping it, sharing details and applying are five separate decisions. None of them happens because another one did.</p>
      </div>
      <div class="control-ladder"><Ladder /></div>
      <aside class="standing" aria-labelledby="standing-title">
        <h3 id="standing-title">Once, or as a standing rule</h3>
        <p>You can share details one time, or set a rule: specific details, for one named recipient, for a limited time. Every share under it gets a receipt, and you can revoke it whenever you want. Linkbot never creates a rule for you.</p>
        <p class="standing-meta"><span class="status" data-tone="built"><Mark tone="tradeoff" size={10} />Built, tested in staging</span> <a class="link" href="/privacy#sharing">How sharing works<Icon name="arrow" /></a></p>
      </aside>
    </div>
  </section>

  <!-- What works today (the honest status), then the next action. -->
  <section class="band story" id="today" data-stage="today" aria-labelledby="today-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">What it can genuinely do</p>
        <h2 id="today-title">What works today, and what doesn’t yet.</h2>
        <p>Linkbot is early. You should know exactly which parts you can rely on now.</p>
      </div>
      <Today />
    </div>
  </section>

  <!-- 6. The natural next action. -->
  <section class="band close" data-tone="sun" data-stage="action" aria-labelledby="close-title">
    <div class="wrap close-inner">
      <h2 id="close-title">Start with a few words.</h2>
      <p class="close-lede">No account, no profile, nothing stored. You’ll see current listings and their reasons in seconds.</p>
      <SearchForm id="q-close" size="monumental" hint="Short phrases, separated by commas." />
      <p class="close-hiring"><b>Hiring?</b> Linkbot works for recruiting agencies and companies too, without a directory of people. <a class="link-ink" href="/hiring">See how hiring works<Icon name="arrow" /></a></p>
    </div>
  </section>
</Base>

<style>
  /* Every section shares one centre line: heads, figures and actions are composed on it. */
  .section-head { margin-inline: auto; justify-items: center; text-align: center; max-width: 44rem; }
  .section-head p { max-width: 38em; }
  .story .section-head { margin-bottom: clamp(36px, 5vw, 64px); }

  /* 1. The hero: monumental and calm. */
  .hero { position: relative; display: grid; align-items: center; min-height: calc(100svh - 72px); padding-block: clamp(40px, 8vh, 96px) clamp(40px, 6vh, 72px);
    background: radial-gradient(ellipse 62% 46% at 50% 44%, color-mix(in srgb, var(--sun-wash) 70%, transparent), transparent 72%); }
  .hero-inner { display: grid; justify-items: center; text-align: center; gap: clamp(18px, 2.6vh, 28px); }
  .hero h1 { font-size: clamp(2.75rem, 1.1rem + 6.6vw, 7.25rem); letter-spacing: -.048em; line-height: .96; }
  .h1-line { display: block; }
  .hero-lede { max-width: 34em; text-wrap: balance; }
  .hero-search { width: 100%; display: grid; justify-items: center; margin-top: clamp(4px, 1.4vh, 16px); }
  .hero-next { display: inline-flex; align-items: center; gap: 8px; min-height: var(--target); margin-top: clamp(8px, 3vh, 32px); font-size: var(--size-small); font-weight: 600; color: var(--ink-2); text-decoration: none; }
  .hero-next:hover { color: var(--ink); }

  /* 4. One vertical flow: the reading, the listing, watching. */
  .flow { display: grid; justify-items: center; gap: 0; }
  .flow-step { display: grid; justify-items: center; gap: 16px; width: min(100%, 60rem); text-align: center; }
  .flow-step > :global(.reader) { width: min(100%, 52rem); text-align: left; }
  .flow-step > :global(.listing) { width: 100%; text-align: left; }
  .flow-join { width: 2px; height: clamp(40px, 6vw, 64px); background: linear-gradient(var(--line-ink), var(--line-ink)) center / 2px 100% no-repeat; }
  .flow-title { font-size: clamp(1.4rem, 1.2rem + .8vw, 1.9rem); letter-spacing: -.025em; max-width: 24ch; }
  .flow-lede { max-width: 40em; color: var(--ink-2); }
  .flow-status { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px 18px; }
  .facts { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 26px; margin-top: 4px; }
  .facts li { display: inline-flex; align-items: baseline; gap: 10px; font-size: var(--size-small); color: var(--ink-2); }
  .facts b { color: var(--ink); font-weight: 650; }
  .cta-row { display: flex; justify-content: center; margin-top: clamp(32px, 5vw, 56px); }

  /* 5. The one deep band. */
  .control { --on-ink-2: color-mix(in srgb, var(--paper) 74%, var(--ink)); }
  .control .section-head p, .control .standing p, .control .eyebrow { color: var(--on-ink-2); }
  .control h2, .control .standing h3 { color: var(--paper); }
  .control-ladder { width: min(100%, 64rem); margin-inline: auto; }
  .control :global(.ladder) { border-color: transparent; }
  .standing { display: grid; justify-items: center; gap: 10px; max-width: 44rem; margin: clamp(32px, 4vw, 48px) auto 0; text-align: center; }
  .standing p { font-size: var(--size-small); }
  .standing-meta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px 18px; }
  .control .standing :global(.status) { background: color-mix(in srgb, var(--paper) 14%, var(--ink)); color: var(--paper); }
  .control .standing :global(.status .mark) { color: var(--paper); }
  .control .standing :global(.link) { color: var(--paper); text-decoration-color: color-mix(in srgb, var(--paper) 55%, var(--ink)); }
  .control :global(:focus-visible) { outline-color: var(--sun); }
  .control :global(.ladder :focus-visible) { outline-color: var(--cobalt); }

  /* 6. The close: the search again, on the same centre line. */
  .close { padding-block: clamp(72px, 9vw, 120px) clamp(48px, 6vw, 72px); }
  .close-inner { display: grid; justify-items: center; text-align: center; gap: 18px; }
  .close-inner h2 { font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4.25rem); }
  .close-lede { font-size: var(--size-lede); max-width: 30em; }
  .close :global(.search-hint) { color: var(--ink); }
  .close-hiring { max-width: 46rem; margin-top: clamp(24px, 4vw, 40px); padding-top: 20px; border-top: 1px solid var(--sun-line); font-size: var(--size-small); }
  .link-ink { display: inline-flex; align-items: center; gap: 8px; min-height: var(--target); font-weight: 650; color: var(--ink); }

  @media (max-width: 40rem) {
    .hero { min-height: auto; padding-block: 36px 40px; }
    .hero h1 { font-size: clamp(2.5rem, 11.5vw, 3.4rem); }
    .facts { display: grid; justify-content: start; text-align: left; }
  }
</style>

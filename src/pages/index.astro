---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import Halo from '../components/Halo.astro';
import Signal from '../components/Signal.astro';
import Yours from '../components/Yours.astro';
import Icon from '../components/Icon.astro';
import { START_EXAMPLES } from '../data/content';
import { app, searchWith } from '../lib/links';
---
<Base title="Linkbot: find work that fits, keep your privacy"
  description="Say what matters in a few words. Linkbot reads current job listings against them and shows why each one fits, or doesn’t. No account needed."
  path="/" quietHeader sky>

  <!-- 1. The opening viewport: the search is the centre of everything. The headline sits close
       above it, the pink action inside it, criteria people give Linkbot float around it. -->
  <section class="hero" data-stage="value" aria-labelledby="hero-title">
    <Halo />
    <div class="hero-focal">
      <h1 id="hero-title"><span class="h1-line">Find work that fits.</span> <span class="h1-line">Keep your privacy.</span></h1>
      <div class="hero-search" data-hero-search>
        <SearchForm id="q-hero" size="focal" place />
      </div>
    </div>
    <div class="hero-foot">
      <ul class="promises" aria-label="Before you search">
        <li>No account needed to search</li>
        <li>See why each job fits</li>
        <li>Employers aren’t told you’re looking</li>
      </ul>
      <a class="hero-cue" href="#story" aria-label="See how it works"><span data-decor aria-hidden="true"></span></a>
    </div>
  </section>

  <!-- a9:story:start -->
  <!-- The story block (Concept A9's slot, fundament v0 contracts.md): a direction replaces only what
       lies between these two markers with its <Story /> (src/components/directions/<key>/), keeping
       the anchor #story for the hero's cue. Today: A8's two scenes. -->
  <!-- 2. The story: from openings everywhere to the right ones, step by step. -->
  <div id="story" class="story" data-stage="story">
    <Signal />
  </div>

  <!-- 3. Privacy, in the same bright world: what you see, and what an employer sees. -->
  <div class="story" data-stage="privacy">
    <Yours />
  </div>
  <!-- a9:story:end -->

  <!-- 4. The invitation (A8): one plain call to action, no second field. The three recorded
       examples stay as a way in without typing. -->
  <section class="band start" data-stage="start" aria-labelledby="start-title">
    <div class="wrap start-inner">
      <h2 id="start-title">Ready when you are.</h2>
      <p class="start-lede">Search current openings now. No account, no profile, and nobody is told you’re looking.</p>
      <a class="btn btn-primary start-cta" href={app('#/search')} data-start-cta>Explore jobs<Icon name="arrow" /></a>
      <ul class="start-try" aria-label="Or start from an example">{START_EXAMPLES.map(example => <li><a href={searchWith(example)}>{example}</a></li>)}</ul>
      <p class="start-links"><a class="link" href="/how-it-works">How it works<Icon name="arrow" /></a><a class="link" href="/privacy">How your privacy works<Icon name="arrow" /></a><a class="link" href="/hiring">Hiring?<Icon name="arrow" /></a></p>
    </div>
  </section>
</Base>

<script>import '../scripts/atmosphere';</script>

<style>
  /* 1. The hero. The headline is set close above the search and narrower than the field, so the
     field is the largest, brightest, sharpest thing on the screen. The pair is placed by the
     field: its centre falls a little below the middle of the space under the header (where the
     eye rests; mathematically centred reads high), whatever the screen. */
  .hero { position: relative; isolation: isolate; min-height: calc(100svh - var(--header)); display: grid; grid-template-rows: 1fr auto;
    --h1-size: clamp(2.1rem, 1.25rem + 2.5vw, 3.5rem); --h1-gap: clamp(20px, 3vh, 30px); --field-h: 76px;
    padding: max(28px, calc((100svh - var(--header)) * .515 - var(--h1-size) * 2.04 - var(--h1-gap) - var(--field-h) / 2)) var(--gutter) 0; }
  .hero-focal { position: relative; z-index: 1; display: grid; justify-items: center; align-content: start; gap: var(--h1-gap); text-align: center; }
  /* One weight and one colour on both lines. */
  .hero h1 { max-width: 17ch; font-size: var(--h1-size); font-weight: 560; letter-spacing: -.034em; line-height: 1.02; }
  .h1-line { display: block; }
  .hero-search { position: relative; width: 100%; display: grid; justify-items: center; }
  /* A pool of light behind the field: it lifts it off the colour around it (never wider than the
     hero, so nothing overflows the page). */
  .hero-search::before { content: ''; position: absolute; left: 50%; top: 50%; width: min(64rem, calc(100% + 2 * var(--gutter))); height: 260%; transform: translate(-50%, -50%); z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgb(255 253 249 / .85), rgb(255 253 249 / .45) 45%, transparent 100%); }
  .hero-foot { position: relative; z-index: 1; display: grid; justify-items: center; gap: 16px; padding-bottom: clamp(16px, 2.6vh, 26px); }
  .promises { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 0; font-size: var(--size-small); font-weight: 560; color: var(--ground-ink-2); }
  .promises li { display: inline-flex; align-items: center; }
  .promises li + li::before { content: ''; width: 4px; height: 4px; margin: 0 18px; border-radius: 50%; background: currentColor; opacity: .7; }
  .hero-cue { position: relative; display: grid; place-items: center; width: var(--target); height: var(--target); color: var(--ground-ink-2); }
  .hero-cue span { width: 1px; height: 28px; background: linear-gradient(currentColor, transparent); transform-origin: 0 0; }
  /* The cue draws itself three times, then rests: a hint, not a loop. */
  @media (prefers-reduced-motion: no-preference) { :global(.js) .hero-cue span { animation: cue 2.8s var(--ease) 1.2s 3 both; } }
  @keyframes cue { 0% { transform: scaleY(0); opacity: 0; } 30% { opacity: 1; } 70% { transform: scaleY(1); opacity: 1; } 99% { transform: scaleY(1) translateY(10px); opacity: 0; } 100% { transform: scaleY(1); opacity: 1; } }
  .hero-cue:hover { color: var(--ink); }

  /* 4. The start: back on the centre line. */
  .start { padding-block: clamp(64px, 8vw, 128px) clamp(80px, 10vw, 140px); }
  .start-inner { display: grid; justify-items: center; text-align: center; gap: clamp(24px, 3vw, 36px); }
  .start h2 { max-width: 16ch; }
  .start-lede { max-width: 34em; margin-top: calc(var(--space-head) - var(--space-block) / 2); font-size: var(--size-lede); line-height: 1.5; color: var(--ground-ink-2); }
  .start-cta { min-height: 60px; padding: 0 32px; font-size: 1.0625rem; }
  .start-try { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 22px; font-size: var(--size-small); }
  .start-try a { display: inline-flex; align-items: center; min-height: var(--target); color: var(--ground-ink-2); text-decoration: underline; text-decoration-color: var(--green-line); text-underline-offset: 5px; }
  .start-try a:hover { color: var(--ink); text-decoration-color: currentColor; }
  .start-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 28px; margin-top: clamp(16px, 3vw, 32px); font-size: var(--size-small); }

  /* Phones: the action sits under the field (62 px), so the field's own centre is placed. */
  @media (max-width: 30rem) { .hero { --field-h: 62px; } }
  @media (max-width: 40rem) {
    .hero-foot { padding-top: 6px; }
    .promises { flex-direction: column; align-items: center; gap: 4px; font-size: var(--size-micro); }
    .promises li + li::before { display: none; }
  }
</style>

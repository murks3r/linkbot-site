---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import Clarity from '../components/Clarity.astro';
import Icon from '../components/Icon.astro';
import { START_EXAMPLES, START_PLACEHOLDER } from '../data/content';
---
<Base title="Linkbot: find work that fits, keep your privacy"
  description="Say what matters in a few words. Linkbot reads current job listings against them and shows why each one fits, or doesn’t. No account needed."
  path="/" quietHeader>

  <!-- 1. Value: one centred line of sight, from the promise to the search. -->
  <section class="hero" data-stage="value" aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <h1 id="hero-title"><span class="h1-line">Find work that fits.</span> <span class="h1-line h1-soft">Keep your privacy.</span></h1>
      <p class="lede hero-lede">Say what matters in a few words. Linkbot reads current listings against them and shows you why each one fits, or doesn’t.</p>
      <div class="hero-search" data-hero-search>
        <SearchForm id="q-hero" size="monumental" />
      </div>
    </div>
  </section>

  <!-- 2. The question everyone recognises, then Linkbot's answer, on one scroll-linked stage. -->
  <section class="story" id="story" data-stage="story" aria-labelledby="story-title">
    <div class="wrap story-head">
      <h2 id="story-title">Which one is right for you?</h2>
      <p class="lede">There’s no shortage of openings. The hard part is knowing which one is worth your next move.</p>
    </div>
    <Clarity />
  </section>

  <!-- 3. Trust, composed off the centre line: the one deep band. -->
  <section class="band trust" data-tone="green" id="trust" data-stage="trust" aria-labelledby="trust-title">
    <div class="wrap trust-grid">
      <h2 id="trust-title">Being a good fit doesn’t make you visible.</h2>
      <div class="trust-body">
        <ul class="trust-list">
          <li><h3>No profile to publish</h3><p>There is no public profile, and no directory of people for anyone to search.</p></li>
          <li><h3>Nothing reaches an employer unless you send it</h3><p>Searching, saving and reading listings send nothing to any employer.</p></li>
          <li><h3>A search is not a record</h3><p>Searching needs no account, and a search without one isn’t stored.</p></li>
        </ul>
        <p><a class="trust-link" href="/privacy">How your privacy works<Icon name="arrow" /></a></p>
      </div>
    </div>
  </section>

  <!-- 4. First use, in context: the question the story leaves you with. -->
  <section class="band start" data-stage="start" aria-labelledby="start-title">
    <div class="wrap start-inner">
      <h2 id="start-title">What would make your next move worth it?</h2>
      <SearchForm id="q-start" size="monumental" placeholder={START_PLACEHOLDER} examples={START_EXAMPLES} />
      <p class="start-hiring">Hiring? <a href="/hiring">Linkbot works for recruiting agencies and companies too</a>.</p>
    </div>
  </section>
</Base>

<style>
  /* 1. The hero: monumental and calm. The second line is the same voice, softened: emphasis by
     weight and tone, never a marker. */
  .hero { display: grid; align-items: center; min-height: calc(100svh - 72px); padding-block: clamp(40px, 8vh, 104px) clamp(56px, 9vh, 112px); }
  .hero-inner { display: grid; justify-items: center; text-align: center; gap: clamp(22px, 3.2vh, 34px); }
  .h1-line { display: block; }
  .h1-soft { font-weight: 300; color: var(--ink-2); }
  .hero-lede { max-width: 31em; text-wrap: balance; }
  .hero-search { width: 100%; display: grid; justify-items: center; margin-top: clamp(4px, 1.2vh, 14px); }

  /* 2. The story's head sits on the centre line; the stage below breaks it on purpose. */
  .story { padding-top: clamp(24px, 4vw, 56px); }
  .story-head { display: grid; justify-items: center; gap: 18px; text-align: center; margin-bottom: clamp(40px, 6vw, 72px); }
  .story-head .lede { max-width: 30em; text-wrap: balance; }

  /* 3. Trust: a statement on the left, three short lines on the right. */
  .trust { margin-top: clamp(64px, 10vw, 140px); }
  .trust-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(40px, 6vw, 112px); align-items: start; }
  .trust h2 { font-size: clamp(2.25rem, 1.2rem + 3.6vw, 4.5rem); color: var(--on-green); text-wrap: balance; }
  .trust-body { display: grid; gap: 28px; padding-top: 10px; }
  .trust-list { display: grid; }
  .trust-list li { display: grid; gap: 6px; padding: 18px 0; border-top: 1px solid var(--green-rule); }
  .trust-list li:last-child { border-bottom: 1px solid var(--green-rule); }
  .trust h3 { color: var(--on-green); font-size: 1.125rem; }
  .trust-list p { color: var(--on-green-2); font-size: var(--size-small); }
  .trust-link { display: inline-flex; align-items: center; gap: 8px; min-height: var(--target); font-weight: 650; color: var(--on-green); text-decoration: underline; text-decoration-color: var(--green-rule); }
  .trust-link:hover { text-decoration-color: currentColor; }
  .trust-link :global(.icon) { transition: transform var(--base) var(--ease); }
  .trust-link:hover :global(.icon) { transform: translateX(3px); }
  .trust :global(:focus-visible) { outline-color: var(--pink); }

  /* 4. The start: back on the centre line, with the question the story leaves. */
  .start-inner { display: grid; justify-items: center; text-align: center; gap: clamp(24px, 3vw, 36px); }
  .start h2 { max-width: 16ch; }
  .start-hiring { max-width: 40rem; margin-top: clamp(20px, 3vw, 36px); font-size: var(--size-small); color: var(--ink-2); }
  .start-hiring a { font-weight: 600; color: var(--ink); }

  @media (max-width: 64rem) {
    .trust-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 40rem) {
    .hero { min-height: auto; padding-block: 40px 64px; }
  }
  @media (max-width: 22.5rem) {
    .hero h1 { font-size: 2.05rem; }
  }
</style>

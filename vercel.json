    {"source": "/it/platforms", "destination": "/it/developers", "permanent": true},
    {"source": "/it/platforms/console", "destination": "/it/developers", "permanent": true},
    {"source": "/fr/platforms/embed", "destination": "/developers/docs/reference/embed", "permanent": true},
    {"source": "/fr/platforms/sdk", "destination": "/developers/docs/reference/sdk", "permanent": true},
    {"source": "/fr/platforms/astro", "destination": "/developers/docs/recipes/astro", "permanent": true},
    {"source": "/fr/platforms/nextjs", "destination": "/developers/docs/recipes/nextjs", "permanent": true},
    {"source": "/fr/platforms/wordpress", "destination": "/developers/docs/recipes/wordpress", "permanent": true},
    {"source": "/fr/for-platforms", "destination": "/fr/developers", "permanent": true},
    {"source": "/fr/platforms", "destination": "/fr/developers", "permanent": true},
    {"source": "/fr/platforms/console", "destination": "/fr/developers", "permanent": true}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

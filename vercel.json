    {"source": "/es/platforms/nextjs", "destination": "/developers/docs/recipes/nextjs", "permanent": true},
    {"source": "/es/platforms/wordpress", "destination": "/developers/docs/recipes/wordpress", "permanent": true},
    {"source": "/es/for-platforms", "destination": "/es/developers", "permanent": true},
    {"source": "/es/platforms", "destination": "/es/developers", "permanent": true},

    {"source": "/de/platforms/astro", "destination": "/developers/docs/recipes/astro", "permanent": true},
    {"source": "/de/platforms/nextjs", "destination": "/developers/docs/recipes/nextjs", "permanent": true},
    {"source": "/de/platforms/wordpress", "destination": "/developers/docs/recipes/wordpress", "permanent": true},
    {"source": "/de/for-platforms", "destination": "/de/developers", "permanent": true},
    {"source": "/de/platforms", "destination": "/de/developers", "permanent": true},

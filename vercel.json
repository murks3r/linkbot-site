{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "design/concept-a-reinvention": false,
      "design/concept-a3": false,
      "design/concept-a4": false,
      "design/concept-a5": false,
      "design/concept-a6": false,
      "design/concept-a7": false,
      "design/concept-a8": false,
      "design/concept-a9": false,
      "design/concept-a9-w1-fundament": false,
      "design/concept-a9-w2-schloss": false,
      "design/concept-a9-w3-wallet": false,
      "design/concept-a9-w4-begegnung": false,
      "design/concept-a9-w5-frei": false
    }
  }
}
